function Spy.Util.SafeTypeof(value)
    local ok, result = pcall(typeof, value)
    if ok then return result end
    return type(value)
end

function Spy.Serializer.InstancePath(instance)
    if instance == game then return "game" end
    if instance == workspace then return "workspace" end
    if typeof(instance) ~= "Instance" then return "nil" end
    local chain = {}
    local cursor = instance
    while cursor and cursor.Parent and cursor.Parent ~= game do
        table.insert(chain, 1, cursor.Name)
        cursor = cursor.Parent
    end
    local root
    if cursor and cursor.Parent == game then
        local ok, service = pcall(game.GetService, game, cursor.ClassName)
        if ok and service == cursor then
            root = "game:GetService(" .. string.format("%q", cursor.ClassName) .. ")"
        else
            root = "game:WaitForChild(" .. string.format("%q", cursor.Name) .. ")"
        end
    else
        return "nil"
    end
    for _, name in ipairs(chain) do
        root = root .. ":WaitForChild(" .. string.format("%q", name) .. ")"
    end
    return root
end

function Spy.Serializer.RemotePath(remote)
    return Spy.Serializer.InstancePath(remote)
end

function Spy.Serializer.Number(value)
    if value ~= value then return "0/0" end
    if value == math.huge then return "math.huge" end
    if value == -math.huge then return "-math.huge" end
    return tostring(value)
end

function Spy.Serializer.Value(value, seen, depth)
    seen = seen or {}
    depth = depth or 0
    local kind = Spy.Util.SafeTypeof(value)
    if kind == "nil" then return "nil"
    elseif kind == "string" then return string.format("%q", value)
    elseif kind == "boolean" then return tostring(value)
    elseif kind == "number" then return Spy.Serializer.Number(value)
    elseif kind == "Instance" then return Spy.Serializer.InstancePath(value)
    elseif kind == "Vector2" then return string.format("Vector2.new(%s, %s)", Spy.Serializer.Number(value.X), Spy.Serializer.Number(value.Y))
    elseif kind == "Vector3" then return string.format("Vector3.new(%s, %s, %s)", Spy.Serializer.Number(value.X), Spy.Serializer.Number(value.Y), Spy.Serializer.Number(value.Z))
    elseif kind == "CFrame" then
        local components = table.pack(value:GetComponents())
        local out = {}
        for i = 1, components.n do out[i] = Spy.Serializer.Number(components[i]) end
        return "CFrame.new(" .. table.concat(out, ", ") .. ")"
    elseif kind == "Color3" then return string.format("Color3.new(%s, %s, %s)", Spy.Serializer.Number(value.R), Spy.Serializer.Number(value.G), Spy.Serializer.Number(value.B))
    elseif kind == "UDim" then return string.format("UDim.new(%s, %s)", Spy.Serializer.Number(value.Scale), Spy.Serializer.Number(value.Offset))
    elseif kind == "UDim2" then return string.format("UDim2.new(%s, %s, %s, %s)", Spy.Serializer.Number(value.X.Scale), Spy.Serializer.Number(value.X.Offset), Spy.Serializer.Number(value.Y.Scale), Spy.Serializer.Number(value.Y.Offset))
    elseif kind == "BrickColor" then return string.format("BrickColor.new(%s)", string.format("%q", value.Name))
    elseif kind == "EnumItem" then return tostring(value)
    elseif kind == "NumberRange" then return string.format("NumberRange.new(%s, %s)", Spy.Serializer.Number(value.Min), Spy.Serializer.Number(value.Max))
    elseif kind == "NumberSequence" then
        local parts = {}
        for index, keypoint in ipairs(value.Keypoints) do
            parts[index] = string.format("NumberSequenceKeypoint.new(%s, %s, %s)", Spy.Serializer.Number(keypoint.Time), Spy.Serializer.Number(keypoint.Value), Spy.Serializer.Number(keypoint.Envelope))
        end
        return "NumberSequence.new({" .. table.concat(parts, ", ") .. "})"
    elseif kind == "ColorSequence" then
        local parts = {}
        for index, keypoint in ipairs(value.Keypoints) do
            parts[index] = string.format("ColorSequenceKeypoint.new(%s, Color3.new(%s, %s, %s))", Spy.Serializer.Number(keypoint.Time), Spy.Serializer.Number(keypoint.Value.R), Spy.Serializer.Number(keypoint.Value.G), Spy.Serializer.Number(keypoint.Value.B))
        end
        return "ColorSequence.new({" .. table.concat(parts, ", ") .. "})"
    elseif kind == "Ray" then return string.format("Ray.new(%s, %s)", Spy.Serializer.Value(value.Origin), Spy.Serializer.Value(value.Direction))
    elseif kind == "Rect" then return string.format("Rect.new(%s, %s)", Spy.Serializer.Value(value.Min), Spy.Serializer.Value(value.Max))
    elseif kind == "table" then
        if seen[value] then return string.format("%q", "CyclicTable") end
        if depth >= Spy.Config.MaxDepth then return string.format("%q", "Unsupported<TableDepth>") end
        seen[value] = true
        local pieces = {}
        local count = 0
        for key, nested in pairs(value) do
            count = count + 1
            if count > Spy.Config.MaxTableItems then
                pieces[#pieces + 1] = "[\"__truncated\"] = true"
                break
            end
            local keySource = Spy.Serializer.Value(key, seen, depth + 1)
            local valueSource = Spy.Serializer.Value(nested, seen, depth + 1)
            pieces[#pieces + 1] = "[" .. keySource .. "] = " .. valueSource
        end
        seen[value] = nil
        if #pieces == 0 then return "{}" end
        return "{ " .. table.concat(pieces, ", ") .. " }"
    end
    return string.format("%q", "Unsupported<" .. tostring(kind) .. ">")
end

function Spy.Serializer.PackedArgs(argsPack)
    local lines = {"local args = table.pack("}
    for index = 1, argsPack.n do
        local suffix = index < argsPack.n and "," or ""
        lines[#lines + 1] = "    " .. Spy.Serializer.Value(argsPack[index]) .. suffix
    end
    lines[#lines + 1] = ")"
    return table.concat(lines, "\n")
end

function Spy.Serializer.CallCode(remote, method, argsPack)
    local path = Spy.Serializer.InstancePath(remote)
    local prefix = Spy.Serializer.PackedArgs(argsPack)
    if method == "InvokeServer" then
        return prefix .. "\n\nlocal results = table.pack(" .. path .. ":InvokeServer(table.unpack(args, 1, args.n)))"
    end
    return prefix .. "\n\n" .. path .. ":FireServer(table.unpack(args, 1, args.n))"
end


Spy.Store.OnChanged = nil

function Spy.Store.Notify()
    if Spy.UI and type(Spy.UI.RequestRefresh) == "function" then
        Spy.UI.RequestRefresh()
    end
end

function Spy.Store.Add(remote, method, argsPack, returnsPack, caller)
    if not Spy.State.Running or Spy.State.Paused or Spy.State.Excluded[remote] then
        return nil
    end
    local occurrence = (Spy.State.PerRemoteCount[remote] or 0) + 1
    Spy.State.PerRemoteCount[remote] = occurrence
    local generatedCode = "Unable to generate code"
    local okCode, code = pcall(Spy.Serializer.CallCode, remote, method, argsPack)
    if okCode then generatedCode = code end
    local remotePath = "Unavailable"
    local okPath, path = pcall(Spy.Serializer.RemotePath, remote)
    if okPath then remotePath = path end
    Spy.State.NextId = Spy.State.NextId + 1
    local entry = {
        Id = Spy.State.NextId,
        Remote = remote,
        Name = remote.Name,
        Class = remote.ClassName,
        Method = method,
        Args = argsPack,
        ArgCount = argsPack.n,
        Returns = returnsPack,
        Time = os.clock(),
        Caller = caller,
        Code = generatedCode,
        Path = remotePath,
        Occurrence = occurrence
    }
    table.insert(Spy.State.Logs, 1, entry)
    while #Spy.State.Logs > Spy.Config.MaxLogs do
        local removed = table.remove(Spy.State.Logs)
        if removed and Spy.State.SelectedId == removed.Id then
            Spy.State.SelectedId = nil
        end
    end
    Spy.Store.Notify()
    return entry
end

function Spy.Store.Clear()
    Spy.State.Logs = {}
    Spy.State.PerRemoteCount = setmetatable({}, {__mode = "k"})
    Spy.State.SelectedId = nil
    Spy.Store.Notify()
end

function Spy.Store.Exclude(remote)
    if not remote then return end
    Spy.State.Excluded[remote] = true
    local kept = {}
    for _, entry in ipairs(Spy.State.Logs) do
        if entry.Remote ~= remote then
            kept[#kept + 1] = entry
        elseif Spy.State.SelectedId == entry.Id then
            Spy.State.SelectedId = nil
        end
    end
    Spy.State.Logs = kept
    Spy.Store.Notify()
end

function Spy.Store.Restore(remote)
    if remote then
        Spy.State.Excluded[remote] = nil
        Spy.Store.Notify()
    end
end

function Spy.Store.Select(logId)
    Spy.State.SelectedId = logId
    Spy.Store.Notify()
end

function Spy.Store.GetSelected()
    if Spy.State.SelectedId == nil then return nil end
    for _, entry in ipairs(Spy.State.Logs) do
        if entry.Id == Spy.State.SelectedId then return entry end
    end
    return nil
end

function Spy.Store.SetPaused(value)
    Spy.State.Paused = value == true
    Spy.Store.Notify()
end


Spy.Capture.Errors = {}
Spy.Capture.OriginalNamecall = nil

function Spy.Capture.GetCaller()
    if type(getcallingscript) ~= "function" then return nil end
    local ok, caller = pcall(getcallingscript)
    if ok then return caller end
    return nil
end

function Spy.Capture.SafeAdd(remote, method, args, returns, caller)
    if Spy.State.InternalReplay or Spy.State.Paused or Spy.State.Excluded[remote] then return end
    pcall(Spy.Store.Add, remote, method, args, returns, caller)
end

function Spy.Capture.QueueAdd(remote, method, args, caller)
    task.defer(function()
        if Spy.State.Running and not Spy.State.InternalReplay then
            Spy.Capture.SafeAdd(remote, method, args, nil, caller)
        end
    end)
end

function Spy.Capture.InstallNamecallHook()
    if type(hookmetamethod) ~= "function" then
        error("hookmetamethod unavailable")
    end
    if type(getnamecallmethod) ~= "function" then
        error("getnamecallmethod unavailable")
    end

    if type(newcclosure) ~= "function" then
        error("newcclosure unavailable")
    end

    local originalNamecall
    local wrapper = newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if Spy.State.Running and not Spy.State.InternalReplay and typeof(self) == "Instance" then
            local className = self.ClassName
            local isRemoteEvent = method == "FireServer" and className == "RemoteEvent"
            local isRemoteFunction = method == "InvokeServer" and className == "RemoteFunction"

            if isRemoteEvent or isRemoteFunction then
                local args = table.pack(...)
                local caller = Spy.Capture.GetCaller()
                Spy.Capture.QueueAdd(self, method, args, caller)
            end
        end

        return originalNamecall(self, ...)
    end)

    originalNamecall = hookmetamethod(game, "__namecall", wrapper)

    if type(originalNamecall) ~= "function" then
        error("hookmetamethod did not return original __namecall")
    end

    Spy.Capture.OriginalNamecall = originalNamecall
    return true
end

function Spy.Capture.Install()
    local ok, result = pcall(Spy.Capture.InstallNamecallHook)
    if ok then return "__namecall" end
    Spy.Capture.Errors.NamecallHook = tostring(result)
    error("capture install failed: " .. tostring(result))
end

function Spy.Capture.Restore()
    local original = Spy.Capture.OriginalNamecall
    Spy.Capture.OriginalNamecall = nil

    if original and type(hookmetamethod) == "function" then
        pcall(hookmetamethod, game, "__namecall", original)
    end
end

function Spy.Capture.CallOriginal(remote, method, argsPack)
    local dynamicRemote = remote :: any

    if method == "InvokeServer" then
        return table.pack(dynamicRemote:InvokeServer(table.unpack(argsPack, 1, argsPack.n)))
    end

    dynamicRemote:FireServer(table.unpack(argsPack, 1, argsPack.n))
    return table.pack()
end

function Spy.Capture.Replay(entry)
    if not entry or not entry.Remote or entry.Remote.Parent == nil then
        return false, "Remote is no longer available"
    end
    if not entry.Args or type(entry.Args.n) ~= "number" then
        return false, "Captured arguments are unavailable"
    end

    Spy.State.InternalReplay = true
    local ok, payload = pcall(Spy.Capture.CallOriginal, entry.Remote, entry.Method, entry.Args)
    Spy.State.InternalReplay = false

    if not ok then return false, payload end

    Spy.Store.Add(entry.Remote, entry.Method, entry.Args, payload, Spy.Capture.GetCaller())
    return true, payload
end

