function Spy.UI.RefreshExcluded()
    local refs = Spy.UI.Refs
    if not refs.ExcludedList then return end
    Spy.UI.ClearDynamic(refs.ExcludedList)
    for remote in pairs(Spy.State.Excluded) do
        if remote then
            local row = Spy.UI.New("Frame", {
                Name = "ExcludedRow",
                Size = UDim2.new(1, -8, 0, 64),
                BackgroundColor3 = Spy.Config.Theme.Panel,
