function Spy.Destroy()
    Spy.State.Running = false
    pcall(Spy.Capture.Restore)
    for _, connection in ipairs(Spy.State.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    for _, instance in ipairs(Spy.State.Instances) do
        pcall(function() instance:Destroy() end)
    end
    Spy.State.Connections = {}
    Spy.State.Instances = {}
    if ENV.FTAP_REMOTE_SPY == Spy then
        ENV.FTAP_REMOTE_SPY = nil
    end
end

ENV.FTAP_REMOTE_SPY = Spy

local okUI, uiError = pcall(Spy.UI.Build)
if not okUI then
    warn("Manga Remote Spy UI failed: " .. tostring(uiError))
end

local okCapture, captureError = pcall(Spy.Capture.Install)
if not okCapture then
    if Spy.UI and Spy.UI.SetStatus then
        pcall(Spy.UI.SetStatus, "Capture install failed: " .. tostring(captureError), true)
    else
        warn("Manga Remote Spy capture failed: " .. tostring(captureError))
    end
elseif next(Spy.Capture.Errors) ~= nil then
    local fragments = {}
    for layer, err in pairs(Spy.Capture.Errors) do
        fragments[#fragments + 1] = layer .. ": " .. err
    end
    if Spy.UI and Spy.UI.SetStatus then
        pcall(Spy.UI.SetStatus, "Partial capture: " .. table.concat(fragments, " | "), true)
    end
end
