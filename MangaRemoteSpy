            row:SetAttribute("SpyDynamic", true)
            Spy.UI.Round(row, 7)
            Spy.UI.Stroke(row, Spy.Config.Theme.Border, 1, 0.35)
            local excludedPath = "Unavailable"
            local okPath, path = pcall(Spy.Serializer.RemotePath, remote)
            if okPath then excludedPath = path end
            Spy.UI.New("TextLabel", {
                Position = UDim2.new(0, 10, 0, 5),
                Size = UDim2.new(1, -92, 1, -10),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = remote.Name .. "\n" .. remote.ClassName .. "  |  " .. excludedPath,
                TextColor3 = Spy.Config.Theme.Text,
                TextSize = 10,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center
            }, row)
            local restore = Spy.UI.MakeButton(row, "RestoreButton", "Restore", 70)
            restore.Position = UDim2.new(1, -78, 0.5, -17)
            Spy.UI.TrackConnection(restore.MouseButton1Click:Connect(function()
                Spy.Store.Restore(remote)
                Spy.UI.SetStatus("Restored " .. remote.Name, false)
                Spy.UI.RefreshExcluded()
            end))
        end
    end
end

function Spy.UI.AnimateMainVisibility(show)
    local refs = Spy.UI.Refs
    if not refs.Main or not refs.ToggleButton then return end
    local tweenService = game:GetService("TweenService")
    if not show then
        Spy.State.MainOpenPosition = refs.Main.Position
    end
    local openPos = Spy.State.MainOpenPosition or refs.Main.Position
    Spy.State.MainOpenPosition = openPos
    local hiddenPos = UDim2.new(0, -refs.Main.AbsoluteSize.X - 40, openPos.Y.Scale, openPos.Y.Offset)
    Spy.State.MainHiddenPosition = hiddenPos
    if refs.ExcludedPanel then
        refs.ExcludedPanel.Visible = false
    end
    if show then
        refs.Main.Visible = true
        tweenService:Create(refs.Main, TweenInfo.new(0.38, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = openPos}):Play()
        tweenService:Create(refs.ToggleButton, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = 0, Size = UDim2.new(0, 54, 0, 54)}):Play()
        refs.ToggleButton.Text = "RS"
        Spy.State.MainVisible = true
    else
        tweenService:Create(refs.Main, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut), {Position = hiddenPos}):Play()
        tweenService:Create(refs.ToggleButton, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = 180, Size = UDim2.new(0, 58, 0, 58)}):Play()
        refs.ToggleButton.Text = "+"
        Spy.State.MainVisible = false
    end
end

function Spy.UI.ToggleMainVisibility()
    Spy.UI.AnimateMainVisibility(not Spy.State.MainVisible)
end

function Spy.UI.ToggleMinimized()
    local refs = Spy.UI.Refs
    if not refs.Main or not refs.LeftPanel or not refs.Inspector then return end
    local tweenService = game:GetService("TweenService")
    if Spy.State.Minimized then
        refs.LeftPanel.Visible = true
        refs.Inspector.Visible = true
        tweenService:Create(refs.Main, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = Spy.State.MainNormalSize}):Play()
        if refs.MinimizeButton then refs.MinimizeButton.Text = "-" end
        Spy.State.Minimized = false
    else
        Spy.State.MainNormalSize = refs.Main.Size
        if refs.ExcludedPanel then refs.ExcludedPanel.Visible = false end
        tweenService:Create(refs.Main, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut), {Size = UDim2.new(0, 900, 0, 48)}):Play()
        task.delay(0.18, function()
            if Spy.State.Minimized and Spy.State.Running then
                refs.LeftPanel.Visible = false
                refs.Inspector.Visible = false
            end
        end)
        if refs.MinimizeButton then refs.MinimizeButton.Text = "+" end
        Spy.State.Minimized = true
    end
end

function Spy.UI.BindActions()
    local refs = Spy.UI.Refs

    Spy.UI.TrackConnection(refs.CopyCode.MouseButton1Click:Connect(function()
        local selected = Spy.Store.GetSelected()
        if not selected then Spy.UI.SetStatus("Select a remote first", true) return end
        if type(setclipboard) ~= "function" then Spy.UI.SetStatus("Clipboard function is unavailable", true) return end
        local ok, err = pcall(function() setclipboard(selected.Code) end)
        Spy.UI.SetStatus(ok and "Code copied" or tostring(err), not ok)
    end))

    Spy.UI.TrackConnection(refs.CopyRemote.MouseButton1Click:Connect(function()
        local selected = Spy.Store.GetSelected()
        if not selected then Spy.UI.SetStatus("Select a remote first", true) return end
        if type(setclipboard) ~= "function" then Spy.UI.SetStatus("Clipboard function is unavailable", true) return end
        local ok, err = pcall(function() setclipboard(Spy.Serializer.RemotePath(selected.Remote)) end)
        Spy.UI.SetStatus(ok and "Remote path copied" or tostring(err), not ok)
    end))

    Spy.UI.TrackConnection(refs.RunCode.MouseButton1Click:Connect(function()
        local selected = Spy.Store.GetSelected()
        if not selected then Spy.UI.SetStatus("Select a remote first", true) return end
        local ok, result = Spy.Capture.Replay(selected)
        if ok then
            local count = result and result.n or 0
            Spy.UI.SetStatus("Replay sent | " .. tostring(count) .. " return values", false)
        else
            Spy.UI.SetStatus("Replay failed: " .. tostring(result), true)
        end
    end))

    Spy.UI.TrackConnection(refs.ExcludeRemote.MouseButton1Click:Connect(function()
        local selected = Spy.Store.GetSelected()
        if not selected then Spy.UI.SetStatus("Select a remote first", true) return end
        local name = selected.Name
        Spy.Store.Exclude(selected.Remote)
        Spy.UI.SetStatus("Excluded " .. name, false)
        Spy.UI.RenderSelected(nil)
    end))

    Spy.UI.TrackConnection(refs.ClearLogs.MouseButton1Click:Connect(function()
        Spy.Store.Clear()
        Spy.UI.RenderSelected(nil)
        Spy.UI.SetStatus("Logs cleared", false)
    end))

    Spy.UI.TrackConnection(refs.PauseSpy.MouseButton1Click:Connect(function()
        Spy.Store.SetPaused(not Spy.State.Paused)
        refs.PauseSpy.Text = Spy.State.Paused and "Resume Spy" or "Pause Spy"
        Spy.UI.SetStatus(Spy.State.Paused and "Capture paused" or "Capture resumed", false)
    end))
end

