function Spy.UI.FormatReturns(entry)
    if not entry or not entry.Returns then return "" end
    local lines = {}
    for index = 1, entry.Returns.n do
        local ok, rendered = pcall(Spy.Serializer.Value, entry.Returns[index])
        if not ok then rendered = string.format("%q", "Unsupported<Return>") end
        lines[#lines + 1] = "[" .. tostring(index) .. "] = " .. rendered
    end
    if #lines == 0 then return "Returns: none" end
    return "Returns: " .. table.concat(lines, "    ")
end

function Spy.UI.ResizeCode()
    local refs = Spy.UI.Refs
    if not refs.CodeBox or not refs.CodeScroll then return end
    local text = refs.CodeBox.Text or ""
    local lines = string.split(text, "\n")
    local longest = 0
    for _, line in ipairs(lines) do longest = math.max(longest, #line) end
    local width = math.max(refs.CodeScroll.AbsoluteSize.X - 14, longest * 7.7 + 24)
    local height = math.max(refs.CodeScroll.AbsoluteSize.Y - 14, #lines * 17 + 24)
    refs.CodeBox.Size = UDim2.new(0, width, 0, height)
    refs.CodeScroll.CanvasSize = UDim2.new(0, width + 8, 0, height + 8)
end

function Spy.UI.RenderSelected(entry)
    local refs = Spy.UI.Refs
    if not refs.DetailTitle or not refs.DetailMeta or not refs.CodeBox then return end
    if not entry then
        refs.DetailTitle.Text = "Select a remote"
        refs.DetailMeta.Text = "Captured calls appear on the left. Select one to inspect that selected call."
        refs.CodeBox.Text = ""
        Spy.UI.ResizeCode()
        if refs.ReturnsBox then refs.ReturnsBox.Text = "" end
        return
    end
    local callerText = "Unavailable"
    if entry.Caller then
        local ok, callerPath = pcall(Spy.Serializer.InstancePath, entry.Caller)
        callerText = ok and callerPath or tostring(entry.Caller)
    end
    refs.DetailTitle.Text = entry.Name
    refs.DetailMeta.Text = table.concat({
        entry.Class .. "  |  " .. entry.Method,
        "Args: " .. tostring(entry.ArgCount) .. "  |  Call #" .. tostring(entry.Occurrence),
        "Path: " .. tostring(entry.Path),
        "Caller: " .. callerText,
        "Time: " .. string.format("%.3f", entry.Time)
    }, "\n")
    refs.CodeBox.Text = entry.Code or ""
    Spy.UI.ResizeCode()
    if refs.ReturnsBox then refs.ReturnsBox.Text = Spy.UI.FormatReturns(entry) end
end

function Spy.UI.LogMatches(entry, query)
    if query == "" then return true end
    local haystack = string.lower(table.concat({
        tostring(entry.Name),
        tostring(entry.Path),
        tostring(entry.Class),
        tostring(entry.Method)
    }, " "))
    return string.find(haystack, query, 1, true) ~= nil
end

function Spy.UI.RenderList()
    local refs = Spy.UI.Refs
    if not refs.LogList then return end
    Spy.UI.ClearDynamic(refs.LogList)
    local query = ""
    if refs.SearchBox then query = string.lower(refs.SearchBox.Text or "") end
    for index, entry in ipairs(Spy.State.Logs) do
        if Spy.UI.LogMatches(entry, query) then
            local selected = Spy.State.SelectedId == entry.Id
            local card = Spy.UI.New("TextButton", {
                Name = "LogCard_" .. tostring(entry.Id),
                LayoutOrder = index,
                Size = UDim2.new(1, -8, 0, 64),
                BackgroundColor3 = selected and Color3.fromRGB(57, 36, 89) or Spy.Config.Theme.PanelAlt,
