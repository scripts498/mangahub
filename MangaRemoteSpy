                AutoButtonColor = true,
                Text = ""
            }, refs.LogList)
            card:SetAttribute("SpyDynamic", true)
            Spy.UI.Round(card, 8)
            Spy.UI.Stroke(card, selected and Spy.Config.Theme.AccentBright or Spy.Config.Theme.Border, selected and 2 or 1, selected and 0 or 0.25)
            Spy.UI.Shadow(card, 8, 12, selected and 0.76 or 0.86)
            local isEvent = entry.Class == "RemoteEvent"
            local badge = Spy.UI.New("TextLabel", {
                Name = isEvent and "EventBadge" or "FunctionBadge",
                Position = UDim2.new(0, 10, 0, 10),
                Size = UDim2.new(0, 34, 0, 34),
                BackgroundColor3 = isEvent and Color3.fromRGB(144, 86, 255) or Color3.fromRGB(209, 102, 255),
                BorderSizePixel = 0,
                Font = Enum.Font.GothamBold,
                Text = isEvent and Spy.UI.EventBadge or Spy.UI.FunctionBadge,
                TextColor3 = Color3.fromRGB(255, 255, 255),
                TextSize = 17
            }, card)
            Spy.UI.Round(badge, 8)
            Spy.UI.New("TextLabel", {
                Name = "RemoteName",
                Position = UDim2.new(0, 54, 0, 8),
                Size = UDim2.new(1, -62, 0, 22),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium,
                Text = entry.Name,
                TextColor3 = Spy.Config.Theme.Text,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd
            }, card)
