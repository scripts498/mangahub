
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- =========================================================
-- TELA DE CARREGAMENTO
-- =========================================================

local LoadingGui = Instance.new("ScreenGui")
LoadingGui.Name = "MangaHubLoadingV2"
LoadingGui.ResetOnSpawn = false
LoadingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
LoadingGui.IgnoreGuiInset = true
LoadingGui.Parent = CoreGui

local LoadingFrame = Instance.new("Frame")
LoadingFrame.Size = UDim2.fromScale(1, 1)
LoadingFrame.Position = UDim2.fromScale(0, 0)
LoadingFrame.BackgroundColor3 = Color3.fromRGB(5, 5, 8)
LoadingFrame.BorderSizePixel = 0
LoadingFrame.Parent = LoadingGui

local GlassContainer = Instance.new("Frame")
GlassContainer.Size = UDim2.fromOffset(600, 400)
GlassContainer.Position = UDim2.fromScale(0.5, 0.5)
GlassContainer.AnchorPoint = Vector2.new(0.5, 0.5)
GlassContainer.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
GlassContainer.BackgroundTransparency = 0.1
GlassContainer.BorderSizePixel = 0
GlassContainer.ClipsDescendants = true
GlassContainer.Parent = LoadingFrame

local GlassCorner = Instance.new("UICorner")
GlassCorner.CornerRadius = UDim.new(0, 30)
GlassCorner.Parent = GlassContainer

local Title = Instance.new("TextLabel")
Title.Size = UDim2.fromScale(1, 0.2)
Title.Position = UDim2.fromScale(0, 0.35)
Title.BackgroundTransparency = 1
Title.Text = "MANGA HUB"
Title.TextColor3 = Color3.fromRGB(255, 160, 30)
Title.TextSize = 48
Title.Font = Enum.Font.GothamBlack
Title.Parent = GlassContainer

local Subtitle = Instance.new("TextLabel")
Subtitle.Size = UDim2.fromScale(1, 0.1)
Subtitle.Position = UDim2.fromScale(0, 0.55)
Subtitle.BackgroundTransparency = 1
Subtitle.Text = "BBB BRASIL V5.0"
Subtitle.TextColor3 = Color3.fromRGB(180, 180, 200)
Subtitle.TextSize = 20
Subtitle.Font = Enum.Font.GothamBold
Subtitle.Parent = GlassContainer

local StatusText = Instance.new("TextLabel")
StatusText.Size = UDim2.fromScale(1, 0.1)
StatusText.Position = UDim2.fromScale(0, 0.7)
StatusText.BackgroundTransparency = 1
StatusText.Text = "Carregando..."
StatusText.TextColor3 = Color3.fromRGB(200, 200, 220)
StatusText.TextSize = 18
StatusText.Font = Enum.Font.GothamSemibold
StatusText.Parent = GlassContainer

local ProgressBar = Instance.new("Frame")
ProgressBar.Size = UDim2.fromOffset(0, 12)
ProgressBar.Position = UDim2.fromScale(0.1, 0.85)
ProgressBar.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
ProgressBar.BorderSizePixel = 0
ProgressBar.Parent = GlassContainer

local ProgressCorner = Instance.new("UICorner")
ProgressCorner.CornerRadius = UDim.new(1, 0)
ProgressCorner.Parent = ProgressBar

-- =========================================================
-- CARREGAMENTO
-- =========================================================

task.spawn(function()

    for i = 1, 100 do

        task.wait(0.03)

        TweenService:Create(
            ProgressBar,
            TweenInfo.new(0.05),
            {
                Size = UDim2.fromOffset((i / 100) * 480, 12)
            }
        ):Play()

        if i == 30 then
            StatusText.Text = "Conectando ao jogo..."
        elseif i == 60 then
            StatusText.Text = "Carregando módulos..."
        elseif i == 85 then
            StatusText.Text = "Quase pronto..."
        end

    end

    StatusText.Text = "Pronto!"

    task.wait(0.5)

    TweenService:Create(
        GlassContainer,
        TweenInfo.new(0.5),
        {
            Size = UDim2.fromOffset(0, 0)
        }
    ):Play()

    TweenService:Create(
        LoadingFrame,
        TweenInfo.new(0.5),
        {
            BackgroundTransparency = 1
        }
    ):Play()

    task.wait(0.6)

    LoadingGui:Destroy()

    task.wait(0.5)

    -- =====================================================
    -- CARREGAR FLUENT
    -- =====================================================

    local success, Fluent = pcall(function()

        return loadstring(
            game:HttpGet(
                "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"
            )
        )()

    end)

    if not success or not Fluent then

        warn("Erro ao carregar Fluent:", tostring(Fluent))

        return
    end

    -- =====================================================
    -- CONFIGURAÇÃO
    -- =====================================================

    local isMobile =
        UserInputService.TouchEnabled
        and not UserInputService.KeyboardEnabled

    local windowSize = isMobile
        and UDim2.fromOffset(400, 300)
        or UDim2.fromOffset(580, 460)

    local tabWidth = isMobile and 120 or 160

    -- =====================================================
    -- WINDOW
    -- =====================================================

    local Window = Fluent:CreateWindow({

        Title = "manga hub/V5.0/Brasil",

        SubTitle = "BBB Brasil",

        TabWidth = tabWidth,

        Size = windowSize,

        Acrylic = true,

        Theme = "Dark",

        MinimizeKey = Enum.KeyCode.LeftControl

    })

    getgenv().MangaHubWindow = Window

    -- =====================================================
    -- TABS
    -- =====================================================

    local Tabs = {

        Main = Window:AddTab({
            Title = "Votação",
            Icon = "check-square"
        }),

        Player = Window:AddTab({
            Title = "Player",
            Icon = "user"
        }),

        Teleport = Window:AddTab({
            Title = "Teleport",
            Icon = "map-pin"
        }),

        Evento = Window:AddTab({
            Title = "Evento",
            Icon = "star"
        })

    }

    local Options = Fluent.Options

    -- =====================================================
    -- NET / VOTAÇÃO
    -- =====================================================

    local Packages = ReplicatedStorage:WaitForChild(
        "Packages",
        10
    )

    local NetFolder

    if Packages then
        NetFolder = Packages:WaitForChild(
            "Net",
            10
        )
    end

    local VoteRemote

    if NetFolder then
        VoteRemote = NetFolder:WaitForChild(
            "GetOption",
            10
        )
    end

    -- =====================================================
    -- SISTEMA DE VOTAÇÃO
    -- =====================================================

    local selectedPlayer = nil
    local votingEnabled = false

    local playerMap = {}

    -- =====================================================
    -- LISTA DE PLAYERS
    -- =====================================================

    local function getPlayerList()

        local list = {}

        playerMap = {}

        for _, player in ipairs(Players:GetPlayers()) do

            if player ~= LocalPlayer then

                local label = string.format(
                    "%s (@%s)",
                    player.DisplayName,
                    player.Name
                )

                table.insert(list, label)

                playerMap[label] = player

            end

        end

        table.sort(list)

        return list

    end

    -- =====================================================
    -- VOTO
    -- =====================================================

    local function votePlayer(player)

        if not player then
            return false
        end

        if not VoteRemote then
            return false
        end

        local success = pcall(function()

            VoteRemote:FireServer({
                player.Name
            })

        end)

        return success

    end

    -- =====================================================
    -- SEÇÃO JOGADOR
    -- =====================================================

    local PlayerSection =
        Tabs.Main:AddSection("Jogador")

    -- =====================================================
    -- DROPDOWN
    -- =====================================================

    local Dropdown =
        PlayerSection:AddDropdown(
            "PlayerDropdown",
            {

                Title = "Selecionar Jogador",

                Description =
                    "Escolha o jogador da votação.",

                Values = getPlayerList(),

                Multi = false,

                Default = nil

            }
        )

    Dropdown:OnChanged(function(value)

        selectedPlayer = playerMap[value]

    end)

    -- =====================================================
    -- ATUALIZAR LISTA
    -- =====================================================

    PlayerSection:AddButton({

        Title = "Atualizar Lista",

        Description =
            "Atualiza os jogadores disponíveis.",

        Callback = function()

            local newList = getPlayerList()

            Dropdown:SetValues(newList)

            if selectedPlayer then

                local exists = false

                for _, player in ipairs(
                    Players:GetPlayers()
                ) do

                    if player == selectedPlayer then

                        exists = true

                        break

                    end

                end

                if not exists then
                    selectedPlayer = nil
                end

            end

            Fluent:Notify({

                Title = "Lista Atualizada",

                Content =
                    "Jogadores recarregados com sucesso!",

                Duration = 3

            })

        end

    })

    -- =====================================================
    -- SEÇÃO VOTAÇÃO
    -- =====================================================

    local VoteSection =
        Tabs.Main:AddSection("Votação")

    -- =====================================================
    -- BOTÃO VOTO INDIVIDUAL
    -- =====================================================

    VoteSection:AddButton({

        Title = "Votar no Jogador",

        Description =
            "Envia um voto para o jogador selecionado.",

        Callback = function()

            if not selectedPlayer then

                Fluent:Notify({

                    Title = "Erro",

                    Content =
                        "Selecione um jogador primeiro.",

                    Duration = 4

                })

                return
            end

            local success =
                votePlayer(selectedPlayer)

            if success then

                Fluent:Notify({

                    Title = "Voto Enviado",

                    Content =
                        "Voto enviado para "
                        .. selectedPlayer.DisplayName,

                    Duration = 3

                })

            else

                Fluent:Notify({

                    Title = "Erro",

                    Content =
                        "Não foi possível enviar o voto.",

                    Duration = 4

                })

            end

        end

    })

    -- =====================================================
    -- TOGGLE
    -- =====================================================

    local VoteToggle =
        VoteSection:AddToggle(
            "VoteToggle",
            {

                Title =
                    "Votar nesta pessoa",

                Description =
                    "Ativa/desativa a votação automática.",

                Default = false

            }
        )

    VoteToggle:OnChanged(function(value)

        votingEnabled = value == true

        if votingEnabled then

            if not selectedPlayer then

                votingEnabled = false

                VoteToggle:SetValue(false)

                Fluent:Notify({

                    Title = "Erro",

                    Content =
                        "Selecione um jogador primeiro.",

                    Duration = 4

                })

                return
            end

            Fluent:Notify({

                Title =
                    "Votação Ativada",

                Content =
                    "Jogador: "
                    .. selectedPlayer.DisplayName,

                Duration = 3

            })

        else

            Fluent:Notify({

                Title =
                    "Votação Desativada",

                Content =
                    "A votação automática foi desligada.",

                Duration = 3

            })

        end

    end)

    -- =====================================================
    -- STATUS
    -- =====================================================

    VoteSection:AddParagraph({

        Title = "Status",

        Content =
            "Selecione um jogador e ative "
            .. "\"Votar nesta pessoa\"."

    })

    -- =====================================================
    -- ATUALIZAR AUTOMATICAMENTE
    -- =====================================================

    Players.PlayerAdded:Connect(function()

        task.wait(0.5)

        Dropdown:SetValues(
            getPlayerList()
        )

    end)

    Players.PlayerRemoving:Connect(function(player)

        if selectedPlayer == player then

            selectedPlayer = nil

            votingEnabled = false

            pcall(function()
                VoteToggle:SetValue(false)
            end)

        end

        task.wait(0.2)

        Dropdown:SetValues(
            getPlayerList()
        )

    end)

    -- =====================================================
    -- PLAYER TAB
    -- =====================================================

    local velocidadeValue = 16
    local speedEnabled = false

    Tabs.Player:AddInput(
        "Velocidade",
        {

            Title = "Velocidade",

            Default = "16",

            Numeric = true,

            Callback = function(Value)

                velocidadeValue =
                    tonumber(Value) or 16

            end

        }
    )

    Tabs.Player:AddToggle(
        "PegarVelocidade",
        {

            Title = "Pegar Velocidade",

            Default = false,

            Callback = function(Value)

                speedEnabled = Value

                if speedEnabled then

                    Fluent:Notify({

                        Title =
                            "Velocidade Ativada",

                        Content =
                            "Velocidade: "
                            .. velocidadeValue,

                        Duration = 3

                    })

                else

                    local hum =
                        LocalPlayer.Character
                        and LocalPlayer.Character:
                            FindFirstChild("Humanoid")

                    if hum then
                        hum.WalkSpeed = 16
                    end

                    Fluent:Notify({

                        Title =
                            "Velocidade Desativada",

                        Content =
                            "Velocidade normal restaurada",

                        Duration = 3

                    })

                end

            end

        }
    )

    task.spawn(function()

        while true do

            task.wait()

            if speedEnabled then

                local char =
                    LocalPlayer.Character

                local hum =
                    char
                    and char:FindFirstChild(
                        "Humanoid"
                    )

                if hum then
                    hum.WalkSpeed =
                        velocidadeValue
                end

            end

        end

    end)

    -- =====================================================
    -- TELEPORT TAB
    -- =====================================================

    local selectedTpPlayer = nil

    local TpDropdown =
        Tabs.Teleport:AddDropdown(
            "TpPlayerDropdown",
            {

                Title = "Players",

                Values = getPlayerList(),

                Multi = false,

                Default = nil

            }
        )

    TpDropdown:OnChanged(function(Value)

        selectedTpPlayer = Value

    end)

    Tabs.Teleport:AddButton({

        Title = "Atualizar Lista",

        Callback = function()

            TpDropdown:SetValues(
                getPlayerList()
            )

            Fluent:Notify({

                Title = "Lista Atualizada",

                Content =
                    "Lista atualizada com sucesso",

                Duration = 3

            })

        end

    })

    Tabs.Teleport:AddButton({

        Title = "TP para esse player",

        Callback = function()

            if not selectedTpPlayer
                or selectedTpPlayer == "" then

                Fluent:Notify({

                    Title = "Erro",

                    Content =
                        "Selecione um jogador primeiro!",

                    Duration = 4

                })

                return

            end

            local target =
                Players:FindFirstChild(
                    selectedTpPlayer
                )

            local myChar =
                LocalPlayer.Character

            local myRoot =
                myChar
                and myChar:FindFirstChild(
                    "HumanoidRootPart"
                )

            if target
                and target.Character
                and target.Character:
                    FindFirstChild("HumanoidRootPart")
                and myRoot then

                myRoot.CFrame =
                    target.Character
                        .HumanoidRootPart.CFrame

                Fluent:Notify({

                    Title = "Teleportado",

                    Content =
                        "Você foi até "
                        .. selectedTpPlayer,

                    Duration = 3

                })

            else

                Fluent:Notify({

                    Title = "Erro",

                    Content =
                        "Jogador inválido ou sem personagem",

                    Duration = 4

                })

            end

        end

    })

    -- =====================================================
    -- EVENTO TAB
    -- =====================================================

    local autoJogoEnabled = false

    local function baterNaFruta()

        pcall(function()

            local minigame =
                Workspace:FindFirstChild(
                    "MinigameCrazykitchen"
                )

            if not minigame then
                return
            end

            local remote =
                minigame:FindFirstChild("🍎2")

            if remote
                and remote:IsA("RemoteEvent") then

                remote:FireServer()

            end

        end)

    end

    Tabs.Evento:AddToggle(
        "AutoJogoToggle",
        {

            Title =
                "Auto Jogo da cozinha",

            Default = false,

            Callback = function(Value)

                autoJogoEnabled = Value

                if autoJogoEnabled then

                    Fluent:Notify({

                        Title =
                            "Auto Jogo Ativado",

                        Content =
                            "Fire automático ativado!",

                        Duration = 3

                    })

                else

                    Fluent:Notify({

                        Title =
                            "Auto Jogo Desativado",

                        Content =
                            "Auto jogo desligado.",

                        Duration = 3

                    })

                end

            end

        }
    )

    task.spawn(function()

        while true do

            task.wait(0.06)

            if autoJogoEnabled then
                baterNaFruta()
            end

        end

    end)

    -- =====================================================
    -- AUTO LAVA
    -- =====================================================

    local autoLavaEnabled = false

    local bodyPosition = nil
    local frozenPosition = nil

    local function congelarPlayer()

        pcall(function()

            if not LocalPlayer.Character then
                return
            end

            local hrp =
                LocalPlayer.Character:
                    FindFirstChild(
                        "HumanoidRootPart"
                    )

            if not hrp then
                return
            end

            frozenPosition =
                hrp.CFrame.Position

            if not bodyPosition then

                bodyPosition =
                    Instance.new(
                        "BodyPosition"
                    )

                bodyPosition.MaxForce =
                    Vector3.new(
                        math.huge,
                        math.huge,
                        math.huge
                    )

                bodyPosition.D = 1000

                bodyPosition.P = 10000

                bodyPosition.Parent = hrp

            end

            bodyPosition.Position =
                frozenPosition

        end)

    end

    local function descongelarPlayer()

        pcall(function()

            if bodyPosition then

                bodyPosition:Destroy()

                bodyPosition = nil

            end

            frozenPosition = nil

        end)

    end

    local function verificarEDestruirBolaDeFogo()

        pcall(function()

            local lavaModel =
                Workspace:FindFirstChild(
                    "Lava"
                )

            if not lavaModel then
                return
            end

            for _, obj in pairs(
                lavaModel:GetDescendants()
            ) do

                if obj:IsA("BasePart")
                    and obj.Name == "BolaDeFogo" then

                    obj:Destroy()

                end

            end

        end)

    end

    Tabs.Evento:AddToggle(
        "AutoLavaToggle",
        {

            Title =
                "Auto Jogo de Lava",

            Default = false,

            Callback = function(Value)

                autoLavaEnabled = Value

                if autoLavaEnabled then

                    Fluent:Notify({

                        Title =
                            "Auto Lava Ativado",

                        Content =
                            "Você está protegido!",

                        Duration = 3

                    })

                    congelarPlayer()

                else

                    descongelarPlayer()

                    Fluent:Notify({

                        Title =
                            "Auto Lava Desativado",

                        Content =
                            "Você pode se mover novamente!",

                        Duration = 3

                    })

                end

            end

        }
    )

    task.spawn(function()

        while true do

            task.wait()

            if autoLavaEnabled then

                verificarEDestruirBolaDeFogo()

                if frozenPosition
                    and LocalPlayer.Character then

                    local hrp =
                        LocalPlayer.Character:
                            FindFirstChild(
                                "HumanoidRootPart"
                            )

                    if hrp
                        and bodyPosition then

                        bodyPosition.Position =
                            frozenPosition

                    end

                end

            end

        end

    end)

    Tabs.Evento:AddParagraph({

        Title =
            "Informações Auto Lava",

        Content =
            "Esta função:\n"
            .. "- Te congela no lugar\n"
            .. "- Deleta automaticamente BolaDeFogo\n"
            .. "- Você fica flutuando se o chão sumir"

    })

    -- =====================================================
    -- BOTÃO MINIMIZAR
    -- =====================================================

    local MinGui = Instance.new("ScreenGui")

    MinGui.Name =
        "MangaHubMinimizeButton"

    MinGui.ResetOnSpawn = false

    MinGui.ZIndexBehavior =
        Enum.ZIndexBehavior.Sibling

    MinGui.Parent = CoreGui

    local MinButton =
        Instance.new("TextButton")

    MinButton.Size = isMobile
        and UDim2.fromOffset(40, 40)
        or UDim2.fromOffset(50, 50)

    MinButton.Position =
        UDim2.new(0, 60, 0, 60)

    MinButton.BackgroundColor3 =
        Color3.fromRGB(255, 140, 0)

    MinButton.Text = "🥭"

    MinButton.TextScaled = true

    MinButton.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    MinButton.BorderSizePixel = 0

    MinButton.AnchorPoint =
        Vector2.new(0.5, 0.5)

    MinButton.Parent = MinGui

    local UICornerBtn =
        Instance.new("UICorner")

    UICornerBtn.CornerRadius =
        UDim.new(1, 0)

    UICornerBtn.Parent =
        MinButton

    local minimized = false

    MinButton.MouseButton1Click:Connect(function()

        if not Window then
            return
        end

        if minimized then

            Window:Show()

            minimized = false

        else

            Window:Minimize()

            minimized = true

        end

    end)

    -- =====================================================
    -- ABRIR VOTAÇÃO
    -- =====================================================

    Window:SelectTab(1)

    Fluent:Notify({

        Title =
            "Manga Hub",

        Content =
            "Interface carregada com sucesso!",

        Duration = 5

    })

end)

