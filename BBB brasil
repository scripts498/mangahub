    -- =========================================================
    -- MAPA JOGADORES
    -- =========================================================
    local playerMap       = {}
    local selectedPlayer  = nil
    local selectedTpPlayer = nil

    local function getPlayerList()
        local list = {}; playerMap = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local label = string.format("%s (@%s)", p.DisplayName, p.Name)
                table.insert(list, label)
                playerMap[label] = p
            end
        end
        table.sort(list); return list
    end

    -- =========================================================
    -- ESTADO VOTAÇÃO
    -- =========================================================
    local votingEnabled   = false
    local voteLoopActive  = false
    local currentChosenId = nil

    local function getChooseGui()
        local ok, gui = pcall(function()
            return LocalPlayer.PlayerGui:WaitForChild("HUD",3).Choosing.ChooseGui
        end)
        return ok and gui or nil
    end

    -- =========================================================
    -- MATCH ROBUSTO DE JOGADOR
    -- =========================================================
    local function matchOption(option, plr)
        local id   = tostring(option[1] or "")
        local dn   = tostring(option[2] or "")
        local name = plr.Name
        local disp = plr.DisplayName
        local uid  = tostring(plr.UserId)

        if id == uid then return true end
        if id == name then return true end
        if dn == disp then return true end
        if dn == name then return true end
        if dn:lower() == disp:lower() then return true end
        if dn:lower() == name:lower() then return true end
        return false
    end

    local function logOptions(options, context)
        local parts = {}
        for _, opt in ipairs(options) do
            table.insert(parts, string.format("[%s | %s]", tostring(opt[1]), tostring(opt[2])))
        end
        warn(string.format("[MH:%s] opções recebidas: %s", context, table.concat(parts, ", ")))
    end

    -- =========================================================
    -- DISPARO DE VOTOS
    -- =========================================================
    local function spawnVoteLoop(Net, chosenId, optionsNum)
        optionsNum = optionsNum or 1
        local payload = {}
        for i = 1, optionsNum do
            payload[i] = chosenId
        end

        if voteLoopActive then
            for _ = 1, 5 do
                pcall(function() Net:RemoteEvent("GetOption"):FireServer(payload) end)
            end
            return
        end

        voteLoopActive  = true
        currentChosenId = chosenId

        task.spawn(function()
            local remote  = Net:RemoteEvent("GetOption")
            local endTime = tick() + 9.8
            local count   = 0

            while tick() < endTime and votingEnabled do
                for _ = 1, 5 do
                    pcall(function() remote:FireServer(payload) end)
                    count += 1
                end
                task.wait()
            end

            voteLoopActive  = false
            currentChosenId = nil

            Fluent:Notify({
                Title   = "✅ Rodada encerrada",
                Content = string.format("~%d votos para %s", count,
                    selectedPlayer and selectedPlayer.DisplayName or "?"),
                Duration = 4,
            })
        end)
    end

    -- =========================================================
    -- Verifica se o paredão já está aberto agora
    -- =========================================================
    local function checkIfVoteAlreadyOpen(Net)
        if not selectedPlayer or not votingEnabled then return end

        local cg = getChooseGui()
        if not cg then return end

        local sf = cg:FindFirstChild("ScrollingFrame")
        if not sf then return end

        local options = {}
        for _, btn in pairs(sf:GetChildren()) do
            if btn:IsA("TextButton") or btn:IsA("ImageButton") or btn:IsA("Frame") then
                local dn = btn:FindFirstChild("UserName")
                local av = btn:FindFirstChild("Avatar")
                local id = btn.Name
                local dnText = dn and dn.Text or ""
                table.insert(options, {id, dnText, av and av.Image or ""})
            end
        end

        if #options == 0 then return end

        local chosenId = nil
        for _, opt in ipairs(options) do
            if matchOption(opt, selectedPlayer) then
                chosenId = opt[1]
                break
            end
        end

        if chosenId then
            Fluent:Notify({
                Title   = "🔥 Paredão detectado!",
                Content = "Votando em: " .. selectedPlayer.DisplayName,
                Duration = 3,
            })
            spawnVoteLoop(Net, chosenId, 1)
        else
            logOptions(options, "manual-fail")
            Fluent:Notify({
                Title   = "⚠️ Paredão aberto",
                Content = selectedPlayer.DisplayName .. " não está nessa rodada.",
                Duration = 4,
            })
        end
    end

