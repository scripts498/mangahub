local function safeParentGui(gui)
    if gethui then gui.Parent = gethui()
    elseif syn and syn.protect_gui then syn.protect_gui(gui); gui.Parent = CoreGui
    else pcall(function() gui.Parent = CoreGui end) end
end

local function httpGet(url)
    if typeof(game.HttpGet) == "function" then return game:HttpGet(url)
    elseif request then return request({Url=url,Method="GET"}).Body end
end

local function safeLoadstring(src)
    if syn and syn.loadstring then return syn.loadstring(src) end
    return loadstring(src)
end

