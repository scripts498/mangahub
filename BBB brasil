            local pkg=ReplicatedStorage:WaitForChild("Packages",15)
            return require(pkg:WaitForChild("Net",15))
        end)
        if not netOk or not Net then
            warn("[MH] Net não disponível"); return
        end

        getgenv()._MH_Net = Net

        Net:Connect("GetOption", function(options, optionsNum, title)
            if not selectedPlayer or not votingEnabled then return end

            local chosenId = nil
            for _, option in ipairs(options) do
                if matchOption(option, selectedPlayer) then
                    chosenId = option[1]
                    break
                end
            end

            if not chosenId then
                if not voteLoopActive then
                    logOptions(options, "auto-fail")
                    Fluent:Notify({Title="⚠️ Fora do paredão",
                        Content=selectedPlayer.DisplayName.." não está nessa rodada.",Duration=5})
