-- ============================================================
-- ESP
-- ============================================================
local espActive = false
local espData = {}
local espConnections = {}
local MAX_DIST = 600

local function hasItem(plr, itemName)
    local char = plr.Character
    if char and char:FindFirstChild(itemName) then
        return true
    end
    local backpack = plr:FindFirstChild("Backpack")
    if backpack and backpack:FindFirstChild(itemName) then
        return true
    end
    return false
end

local function getRole(plr)
    if hasItem(plr, "Knife") then
        return "assasino", Color3.fromRGB(255, 0, 0)
    elseif hasItem(plr, "Gun") then
        return "sheriff", Color3.fromRGB(0, 0, 139)
    else
        return "inocente", Color3.fromRGB(0, 255, 100)
    end
end

local function removeESP(plr)
    local data = espData[plr]
    if not data then return end
    for _, conn in ipairs(data.connections or {}) do
        pcall(function() conn:Disconnect() end)
    end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    espData[plr] = nil
end

local function updateVisuals(data, plr)
    local role, color = getRole(plr)
    if data.highlight then
        data.highlight.FillColor = color
        data.highlight.OutlineColor = color
    end
    if data.label then
        data.label.TextColor3 = color
        data.label.Text = plr.Name .. " [" .. role .. "]"
    end
end

local function createESP(plr)
    if plr == LocalPlayer then return end
    if espData[plr] then return end

    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local role, color = getRole(plr)

    local highlight = Instance.new("Highlight")
    highlight.Name = "_MangaESP"
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = hrp
    highlight.Parent = hrp

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_MangaESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = MAX_DIST
    billboard.Parent = hrp

    local label = Instance.new("TextLabel")
    label.Name = "_MangaESP_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.3
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = plr.Name .. " [" .. role .. "]"
    label.Parent = billboard

    local data = {
        player = plr,
        highlight = highlight,
        billboard = billboard,
        label = label,
        connections = {}
    }
    espData[plr] = data

    local conns = {}

    local function onChar(newChar)
        removeESP(plr)
        if espActive then
            task.delay(0.5, function()
                createESP(plr)
            end)
        end
    end

    table.insert(conns, plr.CharacterAdded:Connect(onChar))
    table.insert(conns, plr.CharacterRemoving:Connect(function()
        removeESP(plr)
    end))

    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        table.insert(conns, backpack.ChildAdded:Connect(function(child)
            if child.Name == "Knife" or child.Name == "Gun" then
                updateVisuals(data, plr)
            end
        end))
        table.insert(conns, backpack.ChildRemoved:Connect(function(child)
            if child.Name == "Knife" or child.Name == "Gun" then
                updateVisuals(data, plr)
            end
        end))
    end

    data.connections = conns
end

local function clearAllESP()
    for plr, data in pairs(espData) do
        for _, conn in ipairs(data.connections or {}) do
            pcall(function() conn:Disconnect() end)
        end
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
    end
    espData = {}
    for _, conn in ipairs(espConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espConnections = {}
end

local function getHrp(plr)
    local char = plr.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function monitorESP()
    while espActive do
        local myHrp = getHrp(LocalPlayer)
        local myPos = myHrp and myHrp.Position

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not espData[plr] then
                createESP(plr)
            end
        end

        for plr, data in pairs(espData) do
            if not plr.Parent then
                removeESP(plr)
            else
                local theirHrp = getHrp(plr)
                if theirHrp and myPos then
                    local dist = (myPos - theirHrp.Position).Magnitude
                    local show = dist <= MAX_DIST
                    pcall(function() data.highlight.Enabled = show end)
                    pcall(function() data.billboard.Enabled = show end)
                    updateVisuals(data, plr)
                else
                    pcall(function() data.highlight.Enabled = false end)
                    pcall(function() data.billboard.Enabled = false end)
                end
            end
        end

        task.wait(0.2)
    end
end

ESPTab:AddToggle("ESPPlayers", {
    Title = "ESP Players",
    Description = "Verde = inocente, Vermelho = assasino, Azul = sheriff.",
    Default = false
}):OnChanged(function(state)
    if state then
        espActive = true
        for _, plr in ipairs(Players:GetPlayers()) do
            createESP(plr)
        end

        local addedConn = Players.PlayerAdded:Connect(function(plr)
            task.delay(1, function()
                if espActive then
                    createESP(plr)
                end
            end)
        end)
        table.insert(espConnections, addedConn)

        local removingConn = Players.PlayerRemoving:Connect(function(plr)
            removeESP(plr)
        end)
        table.insert(espConnections, removingConn)

        task.spawn(monitorESP)
        Fluent:Notify({
            Title = "ESP Players",
            Content = "ESP ativado.",
            Duration = 3
        })
    else
        espActive = false
        clearAllESP()
        Fluent:Notify({
            Title = "ESP Players",
            Content = "ESP desativado.",
            Duration = 3
        })
    end
end)

-- ============================================================
-- HITBOX - EXPANDE TODAS AS PARTES DO CHARACTER
-- ============================================================
local hbActive = false
local hbData = {}
local HB_SIZE = 15

local HITBOX_PARTS = {
    "HumanoidRootPart",
    "Head",
    "Torso",
    "UpperTorso",
    "LowerTorso",
    "Left Arm",
    "Right Arm",
    "Left Leg",
    "Right Leg",
    "LeftUpperArm",
    "LeftLowerArm",
    "LeftHand",
    "RightUpperArm",
    "RightLowerArm",
    "RightHand",
    "LeftUpperLeg",
    "LeftLowerLeg",
    "LeftFoot",
    "RightUpperLeg",
    "RightLowerLeg",
    "RightFoot"
}

local function removeHitbox(plr)
    local data = hbData[plr]
    if not data then return end
    for _, conn in ipairs(data.connections or {}) do
        pcall(function() conn:Disconnect() end)
    end
    for partName, info in pairs(data.parts or {}) do
        if info.part and info.part.Parent then
            local orig = info.part:GetAttribute("_manga_orig_size")
            if orig then
                info.part.Size = orig
            end
        end
    end
    if data.extraPart and data.extraPart.Parent then
        pcall(function() data.extraPart:Destroy() end)
    end
    hbData[plr] = nil
end

local function applyHitbox(plr)
    if plr == LocalPlayer then return end
    if hbData[plr] then return end

    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local parts = {}

    for _, partName in ipairs(HITBOX_PARTS) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local origSize = part.Size
            if not part:GetAttribute("_manga_orig_size") then
                part:SetAttribute("_manga_orig_size", origSize)
            end
            part.Size = Vector3.new(HB_SIZE, HB_SIZE, HB_SIZE)
            part.Transparency = 1
            part.CanCollide = false
            parts[partName] = {
                part = part,
                orig = origSize
            }
        end
    end

    local extraPart = Instance.new("Part")
    extraPart.Name = "_MangaHB"
    extraPart.Size = Vector3.new(HB_SIZE, HB_SIZE, HB_SIZE)
    extraPart.Transparency = 1
    extraPart.CanCollide = false
    extraPart.Anchored = false
    extraPart.Parent = char

    local weld = Instance.new("Weld")
    weld.Part0 = extraPart
    weld.Part1 = hrp
    weld.C0 = CFrame.new(0, 0, 0)
    weld.Parent = extraPart

    local data = {
        player = plr,
        parts = parts,
        extraPart = extraPart,
        connections = {}
    }
    hbData[plr] = data

    local conns = {}
    table.insert(conns, plr.CharacterAdded:Connect(function(newChar)
        task.wait(0.3)
        removeHitbox(plr)
        if hbActive then
            applyHitbox(plr)
        end
    end))
    table.insert(conns, plr.CharacterRemoving:Connect(function()
        removeHitbox(plr)
    end))
    data.connections = conns
end

local function clearAllHitboxes()
    for plr, data in pairs(hbData) do
        removeHitbox(plr)
    end
    hbData = {}
end

local function monitorHitbox()
    while hbActive do
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not hbData[plr] then
                applyHitbox(plr)
            end
        end
        task.wait(0.5)
    end
end

CombatTab:AddToggle("Hitbox", {
    Title = "Hitbox Expander",
    Description = "Aumenta o hitbox dos players.",
    Default = false
}):OnChanged(function(state)
    if state then
        hbActive = true
        for _, plr in ipairs(Players:GetPlayers()) do
            applyHitbox(plr)
        end
        task.spawn(monitorHitbox)
        Fluent:Notify({
            Title = "Hitbox",
            Content = "ativo.",
            Duration = 3
        })
    else
        hbActive = false
        clearAllHitboxes()
        Fluent:Notify({
            Title = "Hitbox",
            Content = "desativado.",
            Duration = 3
        })
    end
end)

