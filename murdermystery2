local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")

local Window = Fluent:CreateWindow({
    Title = "Manga Hub",
    SubTitle = "by haxxmod_01299",
    TabWidth = 120,
    Size = UDim2.fromOffset(500, 350),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local ESPTab = Window:AddTab({ Title = "ESP", Icon = "eye" })

local espActive = false
local espData = {}
local espConnections = {}

local function hasItem(plr, itemName)
    local char = plr.Character
    if char and char:FindFirstChild(itemName) then
        return true
    end
    local backpack = plr:FindFirstChild("Backpack")
    if backpack and backpack:FindFirstChild(itemName) then
        return true
    end
    return false
end

local function getRole(plr)
    if hasItem(plr, "Knife") then
        return "assasino", Color3.fromRGB(255, 0, 0)
    elseif hasItem(plr, "Gun") then
        return "sheriff", Color3.fromRGB(0, 0, 139)
    else
        return "inocente", Color3.fromRGB(0, 255, 100)
    end
end

local function removeESP(plr)
    local data = espData[plr]
    if not data then return end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    if data.charAddedConn then pcall(function() data.charAddedConn:Disconnect() end) end
    if data.charRemovingConn then pcall(function() data.charRemovingConn:Disconnect() end) end
    if data.backpackConn then pcall(function() data.backpackConn:Disconnect() end) end
    espData[plr] = nil
end

local function setupItemListeners(plr, data)
    local char = plr.Character
    if not char then return end
    local backpack = plr:FindFirstChild("Backpack")

    local function update()
        local role, color = getRole(plr)
        data.highlight.FillColor = color
        data.highlight.OutlineColor = color
        data.label.TextColor3 = color
        data.label.Text = plr.Name .. " [" .. role .. "]"
    end

    if data.charAddedConn then pcall(function() data.charAddedConn:Disconnect() end) end
    if data.charRemovingConn then pcall(function() data.charRemovingConn:Disconnect() end) end
    if data.backpackConn then pcall(function() data.backpackConn:Disconnect() end) end

    data.charAddedConn = char.ChildAdded:Connect(function(child)
        if child.Name == "Knife" or child.Name == "Gun" then
            update()
        end
    end)
    data.charRemovingConn = char.ChildRemoved:Connect(function(child)
        if child.Name == "Knife" or child.Name == "Gun" then
            update()
        end
    end)
    if backpack then
        data.backpackConn = backpack.ChildAdded:Connect(function(child)
            if child.Name == "Knife" or child.Name == "Gun" then
                update()
            end
        end)
    end
end

local function createESP(plr)
    if plr == LocalPlayer then return end
    if espData[plr] then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local role, color = getRole(plr)

    local highlight = Instance.new("Highlight")
    highlight.Name = "_MangaESP"
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = char
    highlight.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_MangaESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 9999
    billboard.Parent = char

    local label = Instance.new("TextLabel")
    label.Name = "_MangaESP_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.3
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = plr.Name .. " [" .. role .. "]"
    label.Parent = billboard

    espData[plr] = {
        player = plr,
        highlight = highlight,
        billboard = billboard,
        label = label
    }

    setupItemListeners(plr, espData[plr])
end

local function clearAllESP()
    for plr, data in pairs(espData) do
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
        if data.charAddedConn then pcall(function() data.charAddedConn:Disconnect() end) end
        if data.charRemovingConn then pcall(function() data.charRemovingConn:Disconnect() end) end
        if data.backpackConn then pcall(function() data.backpackConn:Disconnect() end) end
    end
    espData = {}
    for _, conn in ipairs(espConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espConnections = {}
end

local function monitorESP()
    while espActive do
        for plr, data in pairs(espData) do
            if not plr.Parent then
                removeESP(plr)
            elseif plr.Character and data.highlight and data.highlight.Parent ~= plr.Character then
                pcall(function() data.highlight:Destroy() end)
                pcall(function() data.billboard:Destroy() end)
                espData[plr] = nil
                createESP(plr)
            end
        end
        task.wait(1)
    end
end

ESPTab:AddToggle("ESPPlayers", {
    Title = "ESP Players",
    Description = "Verde = inocente, Vermelho = assasino, Azul = sheriff.",
    Default = false
}):OnChanged(function(state)
    if state then
        espActive = true
        for _, plr in ipairs(Players:GetPlayers()) do
            createESP(plr)
        end
        local addedConn = Players.PlayerAdded:Connect(function(plr)
            task.wait(1)
            createESP(plr)
        end)
        table.insert(espConnections, addedConn)
        local removingConn = Players.PlayerRemoving:Connect(function(plr)
            removeESP(plr)
        end)
        table.insert(espConnections, removingConn)
        task.spawn(monitorESP)
        Fluent:Notify({
            Title = "ESP Players",
            Content = "ESP ativado.",
            Duration = 3
        })
    else
        espActive = false
        clearAllESP()
        Fluent:Notify({
            Title = "ESP Players",
            Content = "ESP desativado.",
            Duration = 3
        })
    end
end)

Window:SelectTab(1)
