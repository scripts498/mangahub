local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local Window = Fluent:CreateWindow({
    Title = "Manga Hub",
    SubTitle = "by haxxmod_01299",
    TabWidth = 120,
    Size = UDim2.fromOffset(500, 350),
    Acrylic = true,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

local ESPTab = Window:AddTab({ Title = "ESP", Icon = "eye" })

local espActive = false
local espData = {}
local espConnections = {}

local function hasItem(plr, itemName)
    local char = plr.Character
    if char and char:FindFirstChild(itemName) then
        return true
    end
    local backpack = plr:FindFirstChild("Backpack")
    if backpack and backpack:FindFirstChild(itemName) then
        return true
    end
    return false
end

local function getRole(plr)
    if hasItem(plr, "Knife") then
        return "assasino", Color3.fromRGB(255, 0, 0)
    elseif hasItem(plr, "Gun") then
        return "sheriff", Color3.fromRGB(0, 0, 139)
    else
        return "inocente", Color3.fromRGB(0, 255, 100)
    end
end

local function removeESP(plr)
    local data = espData[plr]
    if not data then return end
    for _, conn in ipairs(data.connections or {}) do
        pcall(function() conn:Disconnect() end)
    end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    espData[plr] = nil
end

local function updateESPVisuals(data, plr)
    local role, color = getRole(plr)
    if data.highlight then
        data.highlight.FillColor = color
        data.highlight.OutlineColor = color
    end
    if data.label then
        data.label.TextColor3 = color
        data.label.Text = plr.Name .. " [" .. role .. "]"
    end
end

local function setupListeners(plr, data)
    local conns = {}

    local function onChar(char)
        for _, c in ipairs(conns) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(conns)

        if not char then return end

        table.insert(conns, char.ChildAdded:Connect(function(child)
            if child.Name == "Knife" or child.Name == "Gun" then
                updateESPVisuals(data, plr)
            end
        end))

        table.insert(conns, char.ChildRemoved:Connect(function(child)
            if child.Name == "Knife" or child.Name == "Gun" then
                updateESPVisuals(data, plr)
            end
        end))

        local backpack = plr:FindFirstChild("Backpack")
        if backpack then
            table.insert(conns, backpack.ChildAdded:Connect(function(child)
                if child.Name == "Knife" or child.Name == "Gun" then
                    updateESPVisuals(data, plr)
                end
            end))
            table.insert(conns, backpack.ChildRemoved:Connect(function(child)
                if child.Name == "Knife" or child.Name == "Gun" then
                    updateESPVisuals(data, plr)
                end
            end))
        end
    end

    local char = plr.Character
    if char then onChar(char) end

    table.insert(conns, plr.CharacterAdded:Connect(onChar))
    data.connections = conns
end

local function createESP(plr)
    if plr == LocalPlayer then return end
    if espData[plr] then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local role, color = getRole(plr)

    local highlight = Instance.new("Highlight")
    highlight.Name = "_MangaESP"
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = char
    highlight.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_MangaESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 9999
    billboard.Parent = char

    local label = Instance.new("TextLabel")
    label.Name = "_MangaESP_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.3
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = plr.Name .. " [" .. role .. "]"
    label.Parent = billboard

    local data = {
        player = plr,
        highlight = highlight,
        billboard = billboard,
        label = label,
        connections = {}
    }
    espData[plr] = data
    setupListeners(plr, data)
end

local function clearAllESP()
    for plr, data in pairs(espData) do
        for _, conn in ipairs(data.connections or {}) do
            pcall(function() conn:Disconnect() end)
        end
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
    end
    espData = {}
    for _, conn in ipairs(espConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espConnections = {}
end

local function monitorESP()
    while espActive do
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not espData[plr] then
                createESP(plr)
            end
        end
        for plr, data in pairs(espData) do
            if not plr.Parent then
                removeESP(plr)
            else
                local char = plr.Character
                if char and data.highlight then
                    if data.highlight.Parent ~= char then
                        pcall(function() data.highlight:Destroy() end)
                        pcall(function() data.billboard:Destroy() end)
                        espData[plr] = nil
                        createESP(plr)
                    else
                        updateESPVisuals(data, plr)
                    end
                end
            end
        end
        task.wait(0.5)
    end
end

ESPTab:AddToggle("ESPPlayers", {
    Title = "ESP Players",
    Description = "Verde = inocente, Vermelho = assasino, Azul = sheriff.",
    Default = false
}):OnChanged(function(state)
    if state then
        espActive = true
        for _, plr in ipairs(Players:GetPlayers()) do
            createESP(plr)
        end
        local addedConn = Players.PlayerAdded:Connect(function(plr)
            local charConn
            charConn = plr.CharacterAdded:Connect(function()
                createESP(plr)
                if charConn then charConn:Disconnect() end
            end)
            if plr.Character then
                createESP(plr)
                if charConn then charConn:Disconnect() end
            end
        end)
        table.insert(espConnections, addedConn)
        local removingConn = Players.PlayerRemoving:Connect(function(plr)
            removeESP(plr)
        end)
        table.insert(espConnections, removingConn)
        task.spawn(monitorESP)
        Fluent:Notify({
            Title = "ESP Players",
            Content = "ESP ativado.",
            Duration = 3
        })
    else
        espActive = false
        clearAllESP()
        Fluent:Notify({
            Title = "ESP Players",
            Content = "ESP desativado.",
            Duration = 3
        })
    end
end)

Window:SelectTab(1)
