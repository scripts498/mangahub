local hitboxActive = false
local hitboxObjects = {}
local HITBOX_SIZE = 15

local function isSurvivor(plr)
    if plr == LocalPlayer then return false end
    return not playerHasHammer(plr)
end

local function applyHitbox(plr)
    if not isSurvivor(plr) then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then
        if not hrp:GetAttribute("_origSize") then
            hrp:SetAttribute("_origSize", hrp.Size)
        end
        hrp.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
        hrp.Transparency = 0.7
        hrp.Color = Color3.fromRGB(255, 0, 255)
    end
    if not char:FindFirstChild("_MangaHitbox") then
        local hitboxPart = Instance.new("Part")
        hitboxPart.Name = "_MangaHitbox"
        hitboxPart.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
        hitboxPart.Transparency = 1
        hitboxPart.CanCollide = false
        hitboxPart.Anchored = false
        hitboxPart.Parent = char
        local weld = Instance.new("Weld")
        weld.Part0 = hitboxPart
        weld.Part1 = hrp
        weld.C0 = CFrame.new(0, 0, 0)
        weld.Parent = hitboxPart
        table.insert(hitboxObjects, {
            player = plr,
            part = hitboxPart,
            hrp = hrp
        })
    end
end

local function removeHitbox(plr)
    for i = #hitboxObjects, 1, -1 do
        local obj = hitboxObjects[i]
        if obj.player == plr then
            if obj.part and obj.part.Parent then
                pcall(function() obj.part:Destroy() end)
            end
            if obj.hrp and obj.hrp.Parent then
                local orig = obj.hrp:GetAttribute("_origSize")
                if orig then
                    obj.hrp.Size = orig
                end
                obj.hrp.Transparency = 1
            end
            table.remove(hitboxObjects, i)
        end
    end
end

local function clearAllHitboxes()
    for _, obj in ipairs(hitboxObjects) do
        if obj.part and obj.part.Parent then
            pcall(function() obj.part:Destroy() end)
        end
        if obj.hrp and obj.hrp.Parent then
            local orig = obj.hrp:GetAttribute("_origSize")
            if orig then
                obj.hrp.Size = orig
            end
            obj.hrp.Transparency = 1
        end
    end
    hitboxObjects = {}
end

local function scanHitboxes()
    for _, plr in ipairs(Players:GetPlayers()) do
        if isSurvivor(plr) then
            applyHitbox(plr)
        end
    end
end

local function monitorHitboxes()
    while hitboxActive do
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local char = plr.Character
            if not char then continue end
            local hasHammer = playerHasHammer(plr)
            local hasHitbox = false
            for _, obj in ipairs(hitboxObjects) do
                if obj.player == plr then
                    hasHitbox = true
                    break
                end
            end
            if hasHammer and hasHitbox then
                removeHitbox(plr)
            elseif not hasHammer and not hasHitbox then
                applyHitbox(plr)
            elseif not hasHammer and hasHitbox then
                applyHitbox(plr)
            end
        end
        task.wait(0.3)
    end
end

FeraTab:AddToggle("Hitbox", {
    Title = "Aumentar Hitbox",
    Description = "Aumenta o hitbox dos sobreviventes.",
