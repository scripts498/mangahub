local espComputersActive = false
local espComputersConnections = {}
local espComputersData = {}

local function isScreenGreen(computer)
    local screen = computer:FindFirstChild("Screen")
    if not screen or not screen:IsA("BasePart") then return false end
    local color = screen.Color
    return color.G > color.R and color.G > color.B
end

local function removeComputerESP(computer)
    local data = espComputersData[computer]
    if not data then return end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    if data.colorConn then pcall(function() data.colorConn:Disconnect() end) end
    if data.ancestryConn then pcall(function() data.ancestryConn:Disconnect() end) end
    espComputersData[computer] = nil
end

local function createComputerESP(computer)
    if not computer or not computer.Parent then return end
    if espComputersData[computer] then return end
    if isScreenGreen(computer) then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "_MangaESP"
    highlight.FillColor = Color3.fromRGB(0, 255, 100)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = computer
    highlight.Parent = computer

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_MangaESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 500
    billboard.Parent = computer

    local label = Instance.new("TextLabel")
    label.Name = "_MangaESP_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(0, 255, 100)
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = "COMPUTADOR"
    label.Parent = billboard

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "_MangaESP_Dist"
    distLabel.Size = UDim2.new(1, 0, 0.5, 0)
    distLabel.Position = UDim2.new(0, 0, 0.5, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    distLabel.TextStrokeTransparency = 0.5
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextSize = 12
    distLabel.Text = "[0m]"
    distLabel.Parent = billboard

    local data = {
        computer = computer,
        highlight = highlight,
        billboard = billboard,
        distLabel = distLabel
    }
    espComputersData[computer] = data

    local screen = computer:FindFirstChild("Screen")
    if screen and screen:IsA("BasePart") then
        data.colorConn = screen:GetPropertyChangedSignal("Color"):Connect(function()
            if isScreenGreen(computer) then
                removeComputerESP(computer)
            end
        end)
    end

    data.ancestryConn = computer.AncestryChanged:Connect(function(_, parent)
        if not parent then
            removeComputerESP(computer)
        end
    end)
end

local function clearComputerESP()
    for computer, data in pairs(espComputersData) do
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
        if data.colorConn then pcall(function() data.colorConn:Disconnect() end) end
        if data.ancestryConn then pcall(function() data.ancestryConn:Disconnect() end) end
    end
    espComputersData = {}
    for _, conn in ipairs(espComputersConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espComputersConnections = {}
end

local function updateComputerDistances()
    while espComputersActive do
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for computer, data in pairs(espComputersData) do
                if data.distLabel and computer and computer.Parent then
                    local primary = computer.PrimaryPart or computer:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        local dist = math.floor((hrp.Position - primary.Position).Magnitude)
                        data.distLabel.Text = "[" .. tostring(dist) .. "m]"
                    end
                end
            end
        end
        task.wait(0.2)
    end
end

