-- ============================================================
-- UTILS
-- ============================================================
local function hasItem(plr, itemName)
    local char = plr.Character
    if char and char:FindFirstChild(itemName) then
        return true
    end
    local backpack = plr:FindFirstChild("Backpack")
    if backpack and backpack:FindFirstChild(itemName) then
        return true
    end
    return false
end

local function getRole(plr)
    if hasItem(plr, "Knife") then
        return "assassino"
    elseif hasItem(plr, "Gun") then
        return "sheriff"
    else
        return "inocente"
    end
end

-- ============================================================
-- ESP
-- ============================================================
local espActive = false
local espData = {}
local espConnections = {}
local MAX_DIST = 600

local function getRoleColor(role)
    if role == "assassino" then
        return Color3.fromRGB(255, 0, 0)
    elseif role == "sheriff" then
        return Color3.fromRGB(0, 0, 139)
    else
        return Color3.fromRGB(0, 255, 100)
    end
end

local function getRoleLabel(role)
    if role == "assassino" then
        return "assasino"
    elseif role == "sheriff" then
        return "sheriff"
    else
        return "inocente"
    end
end

local function removeESP(plr)
    local data = espData[plr]
    if not data then return end
    for _, conn in ipairs(data.connections or {}) do
        pcall(function() conn:Disconnect() end)
    end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    espData[plr] = nil
end

local function updateESPVisuals(data, plr)
    local role = getRole(plr)
    local color = getRoleColor(role)
    if data.highlight then
        data.highlight.FillColor = color
        data.highlight.OutlineColor = color
    end
    if data.label then
        data.label.TextColor3 = color
        data.label.Text = plr.Name .. " [" .. getRoleLabel(role) .. "]"
    end
end

local function createESP(plr)
    if plr == LocalPlayer then return end
    if espData[plr] then return end

    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local role = getRole(plr)
    local color = getRoleColor(role)

    local highlight = Instance.new("Highlight")
    highlight.Name = "_MangaESP"
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.6
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = hrp
    highlight.Parent = hrp

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_MangaESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 30)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = MAX_DIST
    billboard.Parent = hrp

    local label = Instance.new("TextLabel")
    label.Name = "_MangaESP_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.3
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = plr.Name .. " [" .. getRoleLabel(role) .. "]"
    label.Parent = billboard

    local data = {
        player = plr,
        highlight = highlight,
        billboard = billboard,
        label = label,
        connections = {}
    }
    espData[plr] = data

    local conns = {}

    table.insert(conns, plr.CharacterAdded:Connect(function()
        removeESP(plr)
        if espActive then
            task.delay(0.5, function()
                createESP(plr)
            end)
        end
    end))

    table.insert(conns, plr.CharacterRemoving:Connect(function()
        removeESP(plr)
    end))

    local backpack = plr:FindFirstChild("Backpack")
    if backpack then
        table.insert(conns, backpack.ChildAdded:Connect(function(child)
            if child.Name == "Knife" or child.Name == "Gun" then
                updateESPVisuals(data, plr)
            end
        end))
        table.insert(conns, backpack.ChildRemoved:Connect(function(child)
            if child.Name == "Knife" or child.Name == "Gun" then
                updateESPVisuals(data, plr)
            end
        end))
    end

    data.connections = conns
end

local function clearAllESP()
    for plr, data in pairs(espData) do
        for _, conn in ipairs(data.connections or {}) do
            pcall(function() conn:Disconnect() end)
        end
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
    end
    espData = {}
    for _, conn in ipairs(espConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espConnections = {}
end

local function getHrp(plr)
    local char = plr.Character
    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function monitorESP()
    while espActive do
        local myHrp = getHrp(LocalPlayer)
        local myPos = myHrp and myHrp.Position

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not espData[plr] then
                createESP(plr)
            end
        end

        for plr, data in pairs(espData) do
            if not plr.Parent then
                removeESP(plr)
            else
                local theirHrp = getHrp(plr)
                if theirHrp and myPos then
                    local dist = (myPos - theirHrp.Position).Magnitude
                    local show = dist <= MAX_DIST
                    pcall(function() data.highlight.Enabled = show end)
                    pcall(function() data.billboard.Enabled = show end)
                    updateESPVisuals(data, plr)
                else
                    pcall(function() data.highlight.Enabled = false end)
                    pcall(function() data.billboard.Enabled = false end)
                end
            end
        end

        task.wait(0.2)
    end
end

ESPTab:AddToggle("ESPPlayers", {
    Title = "ESP Players",
    Description = "Verde = inocente, Vermelho = assasino, Azul = sheriff.",
    Default = false
}):OnChanged(function(state)
    if state then
        espActive = true
        for _, plr in ipairs(Players:GetPlayers()) do
            createESP(plr)
        end

        local addedConn = Players.PlayerAdded:Connect(function(plr)
            task.delay(1, function()
                if espActive then
                    createESP(plr)
                end
            end)
        end)
        table.insert(espConnections, addedConn)

        local removingConn = Players.PlayerRemoving:Connect(function(plr)
            removeESP(plr)
        end)
        table.insert(espConnections, removingConn)

        task.spawn(monitorESP)
        Fluent:Notify({ Title = "ESP Players", Content = "ESP ativado.", Duration = 3 })
    else
        espActive = false
        clearAllESP()
        Fluent:Notify({ Title = "ESP Players", Content = "ESP desativado.", Duration = 3 })
    end
end)

-- ============================================================
-- HITBOX - SÓ HRP + PARTE EXTRA INVISÍVEL
-- ============================================================
local HB_SIZE = 15

local function removeHitbox(dataTable, plr)
    local data = dataTable[plr]
    if not data then return end
    for _, conn in ipairs(data.connections or {}) do
        pcall(function() conn:Disconnect() end)
    end
    if data.hrp and data.hrp.Parent then
        local orig = data.hrp:GetAttribute("_manga_orig")
        if orig then
            data.hrp.Size = orig
        end
    end
    if data.hbPart and data.hbPart.Parent then
        pcall(function() data.hbPart:Destroy() end)
    end
    dataTable[plr] = nil
end

local function clearHitboxes(dataTable)
    for plr, data in pairs(dataTable) do
        removeHitbox(dataTable, plr)
    end
end

local function applyHitbox(dataTable, plr)
    if plr == LocalPlayer then return end
    if dataTable[plr] then return end

    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local origSize = hrp.Size
    if not hrp:GetAttribute("_manga_orig") then
        hrp:SetAttribute("_manga_orig", origSize)
    end

    hrp.Size = Vector3.new(HB_SIZE, HB_SIZE, HB_SIZE)
    hrp.Transparency = 1
    hrp.CanCollide = false
    hrp.Massless = true

    local hbPart = Instance.new("Part")
    hbPart.Name = "_MangaHB"
    hbPart.Size = Vector3.new(HB_SIZE, HB_SIZE, HB_SIZE)
    hbPart.Transparency = 1
    hbPart.CanCollide = false
    hbPart.Anchored = false
    hbPart.Massless = true
    hbPart.Parent = char

    local weld = Instance.new("Weld")
    weld.Part0 = hbPart
    weld.Part1 = hrp
    weld.C0 = CFrame.new(0, 0, 0)
    weld.Parent = hbPart

    local data = {
        player = plr,
        hrp = hrp,
        hbPart = hbPart,
        connections = {}
    }
    dataTable[plr] = data

    table.insert(data.connections, plr.CharacterAdded:Connect(function()
        task.delay(0.3, function()
            removeHitbox(dataTable, plr)
        end)
    end))

    table.insert(data.connections, plr.CharacterRemoving:Connect(function()
        removeHitbox(dataTable, plr)
    end))
end

local function monitorHitbox(dataTable, activeFlag, targetRole)
    while activeFlag do
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local role = getRole(plr)
                local hasHB = dataTable[plr] ~= nil

                if role == targetRole and not hasHB then
                    applyHitbox(dataTable, plr)
                elseif role ~= targetRole and hasHB then
                    removeHitbox(dataTable, plr)
                end
            end
        end
        task.wait(0.5)
    end
end

