local espPlayersActive = false
local espPlayersData = {}
local espPlayersConnections = {}
local MAX_PLAYER_DISTANCE = 200

local function removePlayerESP(plr)
    local data = espPlayersData[plr]
    if not data then return end
    if data.highlight then pcall(function() data.highlight:Destroy() end) end
    if data.billboard then pcall(function() data.billboard:Destroy() end) end
    if data.hammerAddedConn then pcall(function() data.hammerAddedConn:Disconnect() end) end
    if data.hammerRemovedConn then pcall(function() data.hammerRemovedConn:Disconnect() end) end
    if data.charAddedConn then pcall(function() data.charAddedConn:Disconnect() end) end
    espPlayersData[plr] = nil
end

local function setupPlayerHammerListeners(plr, data)
    local char = plr.Character
    if not char then return end
    if data.hammerAddedConn then pcall(function() data.hammerAddedConn:Disconnect() end) end
    if data.hammerRemovedConn then pcall(function() data.hammerRemovedConn:Disconnect() end) end
    data.hammerAddedConn = char.ChildAdded:Connect(function(child)
        if child.Name == "Hammer" then
            data.hasHammer = true
            data.highlight.FillColor = Color3.fromRGB(255, 0, 0)
            data.label.TextColor3 = Color3.fromRGB(255, 0, 0)
            data.label.Text = plr.Name .. " [FERA]"
        end
    end)
    data.hammerRemovedConn = char.ChildRemoved:Connect(function(child)
        if child.Name == "Hammer" then
            data.hasHammer = false
            data.highlight.FillColor = Color3.fromRGB(0, 255, 100)
            data.label.TextColor3 = Color3.fromRGB(0, 255, 100)
            data.label.Text = plr.Name .. " [SURVIVOR]"
        end
    end)
end

local function createPlayerESP(plr)
    if plr == LocalPlayer then return end
    if espPlayersData[plr] then return end
    local char = plr.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local hasHammer = playerHasHammer(plr)
    local color = hasHammer and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 100)
    local labelText = hasHammer and "FERA" or "SURVIVOR"

    local highlight = Instance.new("Highlight")
    highlight.Name = "_MangaESP_Player"
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = char
    highlight.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_MangaESP_Player_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = MAX_PLAYER_DISTANCE
    billboard.Parent = char

    local label = Instance.new("TextLabel")
    label.Name = "_MangaESP_Player_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = plr.Name .. " [" .. labelText .. "]"
    label.Parent = billboard

    local data = {
        player = plr,
        highlight = highlight,
        billboard = billboard,
        label = label,
        hasHammer = hasHammer
    }
    espPlayersData[plr] = data
    setupPlayerHammerListeners(plr, data)
end

local function clearPlayerESP()
    for plr, data in pairs(espPlayersData) do
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
        if data.hammerAddedConn then pcall(function() data.hammerAddedConn:Disconnect() end) end
        if data.hammerRemovedConn then pcall(function() data.hammerRemovedConn:Disconnect() end) end
        if data.charAddedConn then pcall(function() data.charAddedConn:Disconnect() end) end
    end
    espPlayersData = {}
    for _, conn in ipairs(espPlayersConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espPlayersConnections = {}
end

local function updatePlayerESP()
    while espPlayersActive do
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHrp then
            for plr, data in pairs(espPlayersData) do
                local char = plr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local dist = (myHrp.Position - hrp.Position).Magnitude
                    if dist <= MAX_PLAYER_DISTANCE then
                        data.highlight.Enabled = true
                        data.billboard.Enabled = true
                    else
                        data.highlight.Enabled = false
                        data.billboard.Enabled = false
                    end
                else
                    data.highlight.Enabled = false
                    data.billboard.Enabled = false
                end
            end
        end
        task.wait(0.3)
    end
end

