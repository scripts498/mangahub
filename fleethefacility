        Fluent:Notify({
            Title = "ESP Computadores",
            Content = "ESP ativado.",
            Duration = 3
        })
    else
        espComputersActive = false
        clearComputerESP()
        Fluent:Notify({
            Title = "ESP Computadores",
            Content = "ESP desativado.",
            Duration = 3
        })
    end
end)

local espPlayersActive = false
local espPlayersObjects = {}
local espPlayersConnections = {}
local MAX_PLAYER_DISTANCE = 200

local function removePlayerESP(plr)
    for i, obj in ipairs(espPlayersObjects) do
        if obj.player == plr then
            if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
            if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
            table.remove(espPlayersObjects, i)
            break
        end
    end
end

local function createPlayerESP(plr)
    if plr == LocalPlayer then return end
    if not plr.Character then return end
    local char = plr.Character
    if not char:FindFirstChild("HumanoidRootPart") then return end

    for _, existing in ipairs(espPlayersObjects) do
        if existing.player == plr then return end
    end

    local hasHammer = playerHasHammer(plr)
    local color = hasHammer and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 100)
    local labelText = hasHammer and "FERA" or "SURVIVOR"

    local highlight = Instance.new("Highlight")
    highlight.Name = "_MangaESP_Player"
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = char
    highlight.Parent = char

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_MangaESP_Player_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = MAX_PLAYER_DISTANCE
    billboard.Parent = char

    local label = Instance.new("TextLabel")
    label.Name = "_MangaESP_Player_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = plr.Name .. " [" .. labelText .. "]"
    label.Parent = billboard

    table.insert(espPlayersObjects, {
        player = plr,
        highlight = highlight,
        billboard = billboard,
        label = label,
        hasHammer = hasHammer
    })
end

local function clearPlayerESP()
    for _, obj in ipairs(espPlayersObjects) do
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
    end
    espPlayersObjects = {}
    for _, conn in ipairs(espPlayersConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espPlayersConnections = {}
end

local function getCharacterPosition(plr)
    local char = plr.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end
    return nil
end

local function updatePlayerESP()
    while espPlayersActive do
        local myPos = getCharacterPosition(LocalPlayer)
        if myPos then
            for i = #espPlayersObjects, 1, -1 do
                local obj = espPlayersObjects[i]
                local plr = obj.player
                if not plr or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
                    if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
                    if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
                    table.remove(espPlayersObjects, i)
                else
                    local theirPos = getCharacterPosition(plr)
                    if theirPos then
                        local dist = (myPos - theirPos).Magnitude
                        if dist > MAX_PLAYER_DISTANCE then
                            if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
                            if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
                            table.remove(espPlayersObjects, i)
                        else
                            local currentHasHammer = playerHasHammer(plr)
                            if currentHasHammer ~= obj.hasHammer then
                                local newColor = currentHasHammer and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 100)
                                local newText = currentHasHammer and "FERA" or "SURVIVOR"
                                obj.hasHammer = currentHasHammer
                                if obj.highlight then
                                    obj.highlight.FillColor = newColor
                                end
                                if obj.label then
                                    obj.label.TextColor3 = newColor
                                    obj.label.Text = plr.Name .. " [" .. newText .. "]"
                                end
                            end
                        end
                    end
                end
            end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local theirPos = getCharacterPosition(plr)
                    if theirPos and (myPos - theirPos).Magnitude <= MAX_PLAYER_DISTANCE then
                        createPlayerESP(plr)
                    end
                end
            end
        end
        task.wait(0.2)
    end
end

ESPTab:AddToggle("ESPPlayers", {
    Title = "ESP Players",
    Description = "Destaca players próximos. Verde = survivor, Vermelho = fera.",
    Default = false
}):OnChanged(function(state)
    if state then
        espPlayersActive = true
        for _, plr in ipairs(Players:GetPlayers()) do
            createPlayerESP(plr)
        end
        local addedConn = Players.PlayerAdded:Connect(function(plr)
            task.wait(1)
            createPlayerESP(plr)
        end)
        table.insert(espPlayersConnections, addedConn)
        local removingConn = Players.PlayerRemoving:Connect(function(plr)
            removePlayerESP(plr)
        end)
        table.insert(espPlayersConnections, removingConn)
        task.spawn(updatePlayerESP)
        Fluent:Notify({
            Title = "ESP Players",
            Content = "ESP ativado.",
            Duration = 3
        })
    else
        espPlayersActive = false
        clearPlayerESP()
        Fluent:Notify({
            Title = "ESP Players",
            Content = "ESP desativado.",
            Duration = 3
        })
    end
end)

