local espComputersActive = false
local espComputersConnections = {}
local espComputersObjects = {}

local function isScreenGreen(computer)
    local screen = computer:FindFirstChild("Screen")
    if not screen or not screen:IsA("BasePart") then return false end
    local color = screen.Color
    return color.G > color.R and color.G > color.B
end

local function removeComputerESP(computer)
    for i, obj in ipairs(espComputersObjects) do
        if obj.computer == computer then
            if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
            if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
            table.remove(espComputersObjects, i)
            break
        end
    end
end

local function createComputerESP(computer)
    if not computer or not computer.Parent then return end
    if computer:FindFirstChild("_MangaESP") then return end
    if isScreenGreen(computer) then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "_MangaESP"
    highlight.FillColor = Color3.fromRGB(0, 255, 100)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = computer
    highlight.Parent = computer

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "_MangaESP_Billboard"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 500
    billboard.Parent = computer

    local label = Instance.new("TextLabel")
    label.Name = "_MangaESP_Label"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(0, 255, 100)
    label.TextStrokeTransparency = 0.5
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.Text = "COMPUTADOR"
    label.Parent = billboard

    local distLabel = Instance.new("TextLabel")
    distLabel.Name = "_MangaESP_Dist"
    distLabel.Size = UDim2.new(1, 0, 0.5, 0)
    distLabel.Position = UDim2.new(0, 0, 0.5, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    distLabel.TextStrokeTransparency = 0.5
    distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextSize = 12
    distLabel.Text = "[0m]"
    distLabel.Parent = billboard

    table.insert(espComputersObjects, {
        computer = computer,
        highlight = highlight,
        billboard = billboard,
        distLabel = distLabel
    })
end

local function scanForComputers()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "ComputerTable" and obj:IsA("Model") then
            createComputerESP(obj)
        end
    end
end

local function clearComputerESP()
    for _, obj in ipairs(espComputersObjects) do
        if obj.highlight then pcall(function() obj.highlight:Destroy() end) end
        if obj.billboard then pcall(function() obj.billboard:Destroy() end) end
    end
    espComputersObjects = {}
    for _, conn in ipairs(espComputersConnections) do
        pcall(function() conn:Disconnect() end)
    end
    espComputersConnections = {}
end

local function updateComputerDistances()
    while espComputersActive do
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, obj in ipairs(espComputersObjects) do
                if obj.computer and obj.computer.Parent and obj.distLabel then
                    local primary = obj.computer.PrimaryPart or obj.computer:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        local dist = math.floor((hrp.Position - primary.Position).Magnitude)
                        obj.distLabel.Text = "[" .. tostring(dist) .. "m]"
                    end
                end
            end
        end
        task.wait(0.1)
    end
end

local function monitorComputerScreens()
    while espComputersActive do
        for i = #espComputersObjects, 1, -1 do
            local obj = espComputersObjects[i]
            if obj.computer and obj.computer.Parent then
                if isScreenGreen(obj.computer) then
                    removeComputerESP(obj.computer)
                end
            end
        end
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj.Name == "ComputerTable" and obj:IsA("Model") then
                local hasESP = false
                for _, existing in ipairs(espComputersObjects) do
                    if existing.computer == obj then
                        hasESP = true
                        break
                    end
                end
                if not hasESP and not isScreenGreen(obj) then
                    createComputerESP(obj)
                end
            end
        end
        task.wait(0.5)
    end
end

ESPTab:AddToggle("ESPComputers", {
