    Text = "Desbanir de Casas",
    Icon = "",
    Callback = function()
        local removidos = deletarBannedBlocks()
        if removidos > 0 then
            print("Removidos " .. removidos .. " ban(s)")
        else
            print("Nenhum ban encontrado")
        end
    end
})

