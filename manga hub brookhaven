local LOCAL_VERSION = "V3.6"
local SCRIPT_URL = "https://raw.githubusercontent.com/scripts498/mangahub/refs/heads/main/manga%20hub%20brookhaven"

local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")

local function fetch()
	return game:HttpGet(SCRIPT_URL)
end

local function remoteVersion(content)
	local firstLine = content:match("^[^\n]*")
	return firstLine and firstLine:match("V[%d%.]+")
end

local function reExecute()
	local ok, src = pcall(fetch)
	if ok and src then
		local fn = loadstring(src)
		if fn then
			fn()
		end
	end
end

