local autoDesbanir = false
local conexaoAuto = nil
local loopTask = nil

local function deletarBannedBlocks()
    local contador = 0
    local workspace = game:GetService("Workspace")
    for _, descendant in pairs(workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Name == "BannedBlock" then
            pcall(function()
                descendant:Destroy()
                contador = contador + 1
            end)
        end
    end
    return contador
end

