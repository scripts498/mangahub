local function FindPlayer(name)
    name = name:lower()
    if name == "all" then
        return "all"
    end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower() == name or plr.DisplayName:lower() == name then
            return plr
        end
    end
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower():sub(1, #name) == name or plr.DisplayName:lower():sub(1, #name) == name then
            return plr
        end
    end
    return nil
end

local function GetTargetPlayers(targetResult, commandUser)
    local targets = {}
    if targetResult == "all" then
        for userId, _ in pairs(scriptUsers) do
            local plr = Players:GetPlayerByUserId(userId)
            if plr and plr ~= commandUser then
                table.insert(targets, plr)
            end
        end
    elseif targetResult then
        table.insert(targets, targetResult)
    end
    return targets
end

local function GetAllScriptUsers()
    local users = {}
    for userId, _ in pairs(scriptUsers) do
        local plr = Players:GetPlayerByUserId(userId)
        if plr then
            table.insert(users, plr)
        end
    end
    return users
end

local function CreateJail(targetPlayer, ownerPlayer)
    if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return
    end
    ForceJump(targetPlayer)
    wait(0.2)
    if jails[targetPlayer.UserId] then
        jails[targetPlayer.UserId]:Destroy()
    end
    local char = targetPlayer.Character
    local hrp = char.HumanoidRootPart
    local jailPos = hrp.Position
    jailPositions[targetPlayer.UserId] = jailPos
    local jailModel = Instance.new("Model")
    jailModel.Name = "Jail_" .. targetPlayer.Name
    jailModel.Parent = workspace
    local size = 8
    local height = 10
    local barThickness = 0.5
    local function CreateBar(pos, sizeVec)
        local bar = Instance.new("Part")
        bar.Size = sizeVec
        bar.Position = pos
        bar.Anchored = true
        bar.Material = Enum.Material.Metal
        bar.BrickColor = BrickColor.new("Dark stone grey")
        bar.Transparency = 0
        bar.CanCollide = true
        bar.Parent = jailModel
        for _, descendant in pairs(bar:GetDescendants()) do
            if descendant:IsA("SurfaceGui") or descendant:IsA("BillboardGui") then
                descendant:Destroy()
            end
        end
        return bar
    end
    local floor = CreateBar(Vector3.new(jailPos.X, jailPos.Y - 3, jailPos.Z), Vector3.new(size, 0.5, size))
    local roof = CreateBar(Vector3.new(jailPos.X, jailPos.Y + height - 3, jailPos.Z), Vector3.new(size, 0.5, size))
    local numBars = 8
    local spacing = size / numBars
    for i = 0, numBars do
        local x = jailPos.X - size/2 + (i * spacing)
        CreateBar(Vector3.new(x, jailPos.Y + height/2 - 3, jailPos.Z + size/2), Vector3.new(barThickness, height, barThickness))
    end
    for i = 0, numBars do
        local x = jailPos.X - size/2 + (i * spacing)
        CreateBar(Vector3.new(x, jailPos.Y + height/2 - 3, jailPos.Z - size/2), Vector3.new(barThickness, height, barThickness))
    end
    for i = 0, numBars do
        local z = jailPos.Z - size/2 + (i * spacing)
        CreateBar(Vector3.new(jailPos.X - size/2, jailPos.Y + height/2 - 3, z), Vector3.new(barThickness, height, barThickness))
    end
    for i = 0, numBars do
        local z = jailPos.Z - size/2 + (i * spacing)
        CreateBar(Vector3.new(jailPos.X + size/2, jailPos.Y + height/2 - 3, z), Vector3.new(barThickness, height, barThickness))
    end
    hrp.CFrame = CFrame.new(jailPos.X, jailPos.Y, jailPos.Z)
    jails[targetPlayer.UserId] = jailModel
    if ownerPlayer then
        local label = Instance.new("BillboardGui")
        label.Size = UDim2.new(0, 200, 0, 50)
        label.StudsOffset = Vector3.new(0, height + 2, 0)
        label.AlwaysOnTop = true
        label.MaxDistance = 500
        label.Parent = jailModel
        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "JAIL: " .. targetPlayer.Name .. "\nby " .. ownerPlayer.Name
        textLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        textLabel.Font = Enum.Font.GothamBold
        textLabel.TextSize = 14
        textLabel.Parent = label
    end
    spawn(function()
        while jails[targetPlayer.UserId] and jailPositions[targetPlayer.UserId] do
            if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local currentHrp = targetPlayer.Character.HumanoidRootPart
                local savedPos = jailPositions[targetPlayer.UserId]
                local dist = (currentHrp.Position - savedPos).Magnitude
                if dist > size/2 - 1 then
                    currentHrp.CFrame = CFrame.new(savedPos.X, savedPos.Y, savedPos.Z)
                end
            end
            wait(0.1)
        end
    end)
end

