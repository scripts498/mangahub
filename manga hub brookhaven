local function StartFollow(follower, target)
    if following[follower.UserId] then
        following[follower.UserId] = nil
        wait(0.1)
    end
    following[follower.UserId] = target
    spawn(function()
        while following[follower.UserId] == target and target.Character and follower.Character do
            local targetHrp = target.Character:FindFirstChild("HumanoidRootPart")
            local followerHrp = follower.Character:FindFirstChild("HumanoidRootPart")
            local followerHumanoid = follower.Character:FindFirstChild("Humanoid")
            if targetHrp and followerHrp and followerHumanoid then
                local targetPos = targetHrp.Position
                local followerPos = followerHrp.Position
                local distance = (targetPos - followerPos).Magnitude
                if distance > 3 then
                    local direction = (targetPos - followerPos).Unit
                    local speed = math.min(distance * 2, 50)
                    followerHrp.AssemblyLinearVelocity = direction * speed + Vector3.new(0, followerHrp.AssemblyLinearVelocity.Y, 0)
                else
                    followerHrp.AssemblyLinearVelocity = Vector3.new(0, followerHrp.AssemblyLinearVelocity.Y, 0)
                end
                local targetY = targetHrp.Position.Y
                local followerY = followerHrp.Position.Y
                local yDiff = targetY - followerY
                if math.abs(yDiff) > 2 then
                    followerHrp.AssemblyLinearVelocity = Vector3.new(
                        followerHrp.AssemblyLinearVelocity.X,
                        yDiff * 5,
                        followerHrp.AssemblyLinearVelocity.Z
                    )
                end
                followerHrp.CFrame = CFrame.new(followerHrp.Position, Vector3.new(targetPos.X, followerHrp.Position.Y, targetPos.Z))
            end
            wait(0.03)
        end
        if following[follower.UserId] == target then
            following[follower.UserId] = nil
        end
    end)
end

local function StopFollow(follower)
