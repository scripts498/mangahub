local SignTab = Window:CreateTab("Sign", "📦")

local SignSection = SignTab:CreateSection("Placas")

local playerList = {}
local selectedPlayer = nil
local signText = ""
local lastUpdate = {}

local function hasSign(player)
    if not player or not player.Parent then return false end
    local backpack = player:FindFirstChild("Backpack")
    if backpack and backpack:FindFirstChild("Sign") then
        return true
    end
    local character = player.Character
    if character and character:FindFirstChild("Sign") then
        return true
    end
    return false
end

local function getSign(player)
    if not player then return nil end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        local sign = backpack:FindFirstChild("Sign")
        if sign then return sign end
    end
    local character = player.Character
    if character then
        local sign = character:FindFirstChild("Sign")
        if sign then return sign end
    end
    return nil
end

local function updatePlayerList()
    local newList = {"All"}
    for _, player in pairs(Players:GetPlayers()) do
        if hasSign(player) then
            table.insert(newList, player.Name)
        end
    end
    if #newList == 1 then
        table.insert(newList, "Nenhum jogador com a placa")
    end
    table.sort(newList, function(a, b)
        if a == "All" then return true end
        if b == "All" then return false end
        return a < b
    end)
    return newList
end

local PlayerDropdown = SignSection:CreateDropdown({
    Text = "Selecionar Jogador",
    List = updatePlayerList(),
    Default = nil,
    Multi = false,
    Callback = function(item)
        if item ~= "Nenhum jogador com a placa" then
            selectedPlayer = item
        else
            selectedPlayer = nil
        end
    end
})

SignSection:CreateTextbox({
    Text = "Texto da Placa",
    Placeholder = "Digite o texto aqui...",
    Default = "",
    Callback = function(text, enterPressed)
        signText = text
    end
})

SignSection:CreateButton({
    Text = "Alterar Texto",
    Icon = "",
    Callback = function()
        if not selectedPlayer then
            MangaUI:Notify({
                Title = "Erro",
                Text = "Selecione um jogador primeiro",
                Duration = 3
            })
            return
        end
        if signText == "" or signText:match("^%s*$") then
            MangaUI:Notify({
                Title = "Erro",
                Text = "Digite um texto válido",
                Duration = 3
            })
            return
        end
        if selectedPlayer == "All" then
            local playersWithSign = {}
            for _, player in pairs(Players:GetPlayers()) do
                if hasSign(player) then
                    table.insert(playersWithSign, player)
                end
            end
            if #playersWithSign == 0 then
                MangaUI:Notify({
                    Title = "Erro",
                    Text = "Nenhum jogador com Sign encontrado!",
                    Duration = 3
                })
                return
            end
            local successCount = 0
            local failCount = 0
            for _, targetPlayer in pairs(playersWithSign) do
                local sign = getSign(targetPlayer)
                if sign then
                    local toolSound = sign:FindFirstChild("ToolSound")
                    if toolSound then
                        local success = pcall(function()
                            local args = {
                                [1] = "Sign",
                                [2] = "SignWords",
                                [3] = signText
                            }
                            toolSound:FireServer(unpack(args))
                        end)
                        if success then
                            successCount = successCount + 1
                        else
                            failCount = failCount + 1
                        end
                    else
                        failCount = failCount + 1
                    end
                else
                    failCount = failCount + 1
                end
                task.wait(0.05)
            end
            MangaUI:Notify({
                Title = "Sucesso!",
                Text = string.format("Sucesso: %d | Falhas: %d", successCount, failCount),
                Duration = 4
            })
            return
        end
        local targetPlayer = Players:FindFirstChild(selectedPlayer)
        if not targetPlayer then
            MangaUI:Notify({
                Title = "Erro",
                Text = "Jogador não ta mais no servidor",
                Duration = 3
            })
            return
        end
        local sign = getSign(targetPlayer)
        if not sign then
            MangaUI:Notify({
                Title = "Erro",
                Text = "placa não foi no inv do jogador",
                Duration = 3
            })
            return
        end
        local toolSound = sign:FindFirstChild("ToolSound")
        if not toolSound then
            MangaUI:Notify({
                Title = "Erro",
                Text = "Componente ToolSound não encontrado",
                Duration = 3
            })
            return
        end
        local success, errorMsg = pcall(function()
            local args = {
                [1] = "Sign",
                [2] = "SignWords",
                [3] = signText
            }
            toolSound:FireServer(unpack(args))
        end)
        if success then
            MangaUI:Notify({
                Title = "Sucesso",
                Text = string.format("Texto alterado para: '%s'", signText),
                Duration = 3
            })
        else
            MangaUI:Notify({
                Title = "Erro",
                Text = "erro ao enviar o comando ao servidor",
                Duration = 3
            })
        end
