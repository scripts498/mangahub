        for _, desc in ipairs(loadingBg:GetDescendants()) do
            if desc:IsA("TextLabel") then
                smooth(desc, {TextTransparency = 1}, 0.9)
            elseif desc:IsA("Frame") or desc:IsA("ImageLabel") then
                pcall(function()
                    smooth(desc, {BackgroundTransparency = 1}, 0.9)
                end)
            elseif desc:IsA("UIStroke") then
                smooth(desc, {Transparency = 1}, 0.9)
            end
        end

        task.wait(1.2)

        if onComplete then
            onComplete()
        end
        if loadingGui then
            loadingGui:Destroy()
        end
    end)
end


