local function createInput(parent, labelText, placeholder, yPos)
    local container = Instance.new("Frame")
    container.Parent = parent
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, -64, 0, 76)
    container.Position = UDim2.new(0, 32, 0, yPos)
    container.ZIndex = 11

    local lbl = Instance.new("TextLabel")
    lbl.Parent = container
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 0, 20)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = labelText
    lbl.TextColor3 = THEME.TextSub
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 12

    local boxHolder = Instance.new("Frame")
    boxHolder.Parent = container
    boxHolder.BackgroundColor3 = THEME.Input
    boxHolder.BorderSizePixel = 0
    boxHolder.Position = UDim2.new(0, 0, 0, 24)
    boxHolder.Size = UDim2.new(1, 0, 0, 48)
    boxHolder.ZIndex = 12

    local bhc = Instance.new("UICorner")
    bhc.CornerRadius = UDim.new(0, 12)
    bhc.Parent = boxHolder

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Parent = boxHolder
    boxStroke.Color = THEME.Border
    boxStroke.Thickness = 1.5
    boxStroke.Transparency = 0.35

    local boxGlow = Instance.new("UIStroke")
    boxGlow.Parent = boxHolder
    boxGlow.Color = THEME.Primary
    boxGlow.Thickness = 6
    boxGlow.Transparency = 1

    local box = Instance.new("TextBox")
    box.Parent = boxHolder
    box.BackgroundTransparency = 1
    box.Position = UDim2.new(0, 16, 0, 0)
    box.Size = UDim2.new(1, -32, 1, 0)
    box.Font = Enum.Font.Gotham
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = THEME.TextMuted
    box.Text = ""
    box.TextColor3 = THEME.Text
    box.TextSize = 15
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ClearTextOnFocus = false
    box.ZIndex = 13

    box.Focused:Connect(function()
        smooth(boxStroke, {Color = THEME.Primary, Transparency = 0}, 0.25)
        smooth(boxHolder, {BackgroundColor3 = THEME.InputFocus}, 0.25)
        smooth(lbl, {TextColor3 = THEME.Primary}, 0.25)
        smooth(boxGlow, {Transparency = 0.9}, 0.3)
    end)

    box.FocusLost:Connect(function()
        smooth(boxStroke, {Color = THEME.Border, Transparency = 0.35}, 0.25)
        smooth(boxHolder, {BackgroundColor3 = THEME.Input}, 0.25)
        smooth(lbl, {TextColor3 = THEME.TextSub}, 0.25)
        smooth(boxGlow, {Transparency = 1}, 0.3)
    end)

    return box
end

