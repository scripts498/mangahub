local function loadAdminVersion()
    local detectedFunc = nil
    local killFunc = nil

    for _, v in pairs(getgc(true)) do
        if typeof(v) == "table" then
            local detected = rawget(v, "Detected")
            local kill = rawget(v, "Kill")
            local variables = rawget(v, "Variables")
            local process = rawget(v, "Process")
            if typeof(detected) == "function" and not detectedFunc then
                detectedFunc = detected
                hookfunction(detected, function() return true end)
            end
            if variables and process and typeof(kill) == "function" and not killFunc then
                killFunc = kill
                hookfunction(kill, function() return nil end)
            end
        end
    end

    if getrenv and getrenv().debug and getrenv().debug.info then
        local oldDebugInfo = getrenv().debug.info
        hookfunction(getrenv().debug.info, function(...)
            local firstArg = select(1, ...)
            if detectedFunc and firstArg == detectedFunc then
                return coroutine.yield(coroutine.running())
            end
            return oldDebugInfo(...)
        end)
    end

    local oldNamecallBypass
    oldNamecallBypass = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" and self ~= player then
            return nil
        end
        return oldNamecallBypass(self, ...)
    end)

    local gui, main, content = createBaseGui("manga hub / flex you fps / V1.0/Brasil", true)

