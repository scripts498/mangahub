local function tween(obj, info, props)
    TweenService:Create(obj, info, props):Play()
end

local function spring(obj, props, duration)
    tween(obj, TweenInfo.new(duration or 0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), props)
end

local function smooth(obj, props, duration)
    tween(obj, TweenInfo.new(duration or 0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props)
end

local function sine(obj, props, duration)
    tween(obj, TweenInfo.new(duration or 0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), props)
end

