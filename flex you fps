local function handleLogin()
    local u = userBox.Text:lower():gsub("%s+", "")
    local p = passBox.Text:lower():gsub("%s+", "")

    if u == "free" and p == "free" then
        statusLbl.Text = "✓ Credentials verified"
        statusLbl.TextColor3 = Color3.fromRGB(80, 255, 80)
        loginBtn.Text = "VERIFYING..."
        loginBtn.Active = false
        task.wait(0.5)
        showWarningScreen(function(confirmed)
            if confirmed then
                loginGui.Enabled = false
                runLoadingSequence(function()
                    loadFreeVersion()
                end)
            else
                loginBtn.Text = "LOGIN"
                loginBtn.Active = true
                statusLbl.Text = ""
            end
        end)
    elseif u == "admin" and p == "mangahub" then
        statusLbl.Text = "✓ Access Granted — Premium"
        statusLbl.TextColor3 = Color3.fromRGB(250, 204, 21)
        TweenService:Create(loginBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(200, 160, 10)}):Play()
        loginBtn.Text = "LOADING..."
        loginGui.Enabled = false
        runLoadingSequence(function()
            loadAdminVersion()
        end)
    else
        statusLbl.Text = "✗ Invalid credentials"
        statusLbl.TextColor3 = Color3.fromRGB(239, 68, 68)
        local origPos = loginPanel.Position
        TweenService:Create(loginPanel, TweenInfo.new(0.08), {Position = UDim2.new(0.5, -15, 0.5, 0)}):Play()
        task.wait(0.08)
        TweenService:Create(loginPanel, TweenInfo.new(0.08), {Position = UDim2.new(0.5, 15, 0.5, 0)}):Play()
        task.wait(0.08)
        TweenService:Create(loginPanel, TweenInfo.new(0.08), {Position = UDim2.new(0.5, -8, 0.5, 0)}):Play()
        task.wait(0.08)
        TweenService:Create(loginPanel, TweenInfo.new(0.08), {Position = origPos}):Play()
    end
end

loginBtn.MouseButton1Click:Connect(handleLogin)
loginBtn.TouchTap:Connect(handleLogin)

