local function handleLogin()
    local u = userBox.Text:lower():gsub("%s+", "")
    local p = passBox.Text:lower():gsub("%s+", "")

    if u == "free" and p == "free" then
        statusLbl.Text = "✓ credenciais verificadas"
        statusLbl.TextColor3 = THEME.Success
        loginBtn.Text = "VERIFICANDO..."
        loginBtn.Active = false
        task.wait(0.5)
        showWarningScreen(function(confirmed)
            if confirmed then
                loginGui.Enabled = false
                runLoadingSequence(function()
                    loadFreeVersion()
                end)
            else
                loginBtn.Text = "ENTRAR"
                loginBtn.Active = true
                statusLbl.Text = ""
            end
        end)
    elseif u == "admin" and p == "mangahub" then
        statusLbl.Text = "✓ acesso concedido — premium"
        statusLbl.TextColor3 = THEME.Premium

        btnGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, THEME.PremiumDark),
            ColorSequenceKeypoint.new(0.5, THEME.Premium),
            ColorSequenceKeypoint.new(1, THEME.PremiumDark)
        })

        smooth(btnStroke, {Color = THEME.Premium}, 0.4)

        loginBtn.Text = "CARREGANDO..."
        loginGui.Enabled = false
        runLoadingSequence(function()
            loadAdminVersion()
        end)
    else
        statusLbl.Text = "✗ credenciais inválidas"
        statusLbl.TextColor3 = THEME.Danger
        local origPos = loginPanel.Position
        smooth(loginPanel, {Position = UDim2.new(0.5, -18, 0.5, 0)}, 0.07)
        task.wait(0.07)
        smooth(loginPanel, {Position = UDim2.new(0.5, 18, 0.5, 0)}, 0.07)
        task.wait(0.07)
        smooth(loginPanel, {Position = UDim2.new(0.5, -10, 0.5, 0)}, 0.07)
        task.wait(0.07)
        smooth(loginPanel, {Position = UDim2.new(0.5, 10, 0.5, 0)}, 0.07)
        task.wait(0.07)
        smooth(loginPanel, {Position = origPos}, 0.1)
    end
end

