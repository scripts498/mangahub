local function createInput(parent, labelText, placeholder, yPos)
    local container = Instance.new("Frame")
    container.Parent = parent
    container.BackgroundTransparency = 1
    container.Size = UDim2.new(1, -40, 0, 50)
    container.Position = UDim2.new(0, 20, 0, yPos)
    container.ZIndex = 11

    local lbl = Instance.new("TextLabel")
    lbl.Parent = container
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, 0, 0, 15)
    lbl.Font = Enum.Font.GothamBold
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(200, 200, 220)
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 12

    local box = Instance.new("TextBox")
    box.Parent = container
    box.BackgroundColor3 = Color3.fromRGB(35, 25, 55)
    box.BorderSizePixel = 0
    box.Position = UDim2.new(0, 0, 0, 20)
    box.Size = UDim2.new(1, 0, 0, 35)
    box.Font = Enum.Font.Gotham
    box.PlaceholderText = placeholder
    box.PlaceholderColor3 = Color3.fromRGB(100, 90, 120)
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.TextSize = 14
    box.ClearTextOnFocus = false
    box.ZIndex = 12

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 8)
    boxCorner.Parent = box

    local boxStroke = Instance.new("UIStroke")
    boxStroke.Parent = box
    boxStroke.Color = Color3.fromRGB(60, 40, 100)
    boxStroke.Thickness = 1
    boxStroke.Transparency = 0.5

    box.Focused:Connect(function()
        TweenService:Create(boxStroke, TweenInfo.new(0.2), {Color = THEME_COLOR, Transparency = 0}):Play()
    end)

    box.FocusLost:Connect(function()
        TweenService:Create(boxStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 40, 100), Transparency = 0.5}):Play()
    end)

    return box
