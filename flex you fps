        "Estabelecendo canais seguros...",
        "Contornando protocolos de segurança...",
        "Injetando dependências necessárias...",
        "Ajustando parâmetros do sistema...",
        "Sincronizando com a nuvem...",
        "Finalizando a interface...",
        "Quase lá, só mais um instante...",
        "Pronto!"
    }

    local function typeText(label, text, speed)
        label.Text = ""
        for i = 1, #text do
            label.Text = string.sub(text, 1, i)
            task.wait(speed or 0.03)
        end
    end

    task.spawn(function()
        local totalTime = 12
        local startTime = tick()

        while true do
            local elapsed = tick() - startTime
            local progress = math.min(elapsed / totalTime, 1)

            progressBar.Size = UDim2.new(progress, 0, 1, 0)
            percentText.Text = math.floor(progress * 100) .. "%"

            local msgIndex = math.min(math.floor(progress * #messages) + 1, #messages)
            if loadStatus.Text ~= messages[msgIndex] then
                typeText(loadStatus, messages[msgIndex], 0.025)
            end

            if progress >= 1 then
                typeText(loadStatus, "Acesso concedido!", 0.02)
                loadStatus.TextColor3 = THEME.Success
                smooth(barGlow, {Color = THEME.Success, Transparency = 0.25}, 0.5)
                smooth(progressBgStroke, {Color = THEME.Success}, 0.5)
