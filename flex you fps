    progressBar.BorderSizePixel = 0
    progressBar.Size = UDim2.new(0, 0, 1, 0)
    progressBar.ZIndex = 3

    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(1, 0)
    barCorner.Parent = progressBar

    local barGlow = Instance.new("UIStroke")
    barGlow.Parent = progressBar
    barGlow.Color = THEME_COLOR
    barGlow.Thickness = 4
    barGlow.Transparency = 0.5

    loadingGui.Parent = playerGui

    task.spawn(function()
        local totalTime = 15
        local steps = {
            {t = 0.1, msg = "Verificando credenciais..."},
            {t = 0.3, msg = "Analisando ambiente local..."},
            {t = 0.5, msg = "Carregando módulos de memória..."},
            {t = 0.7, msg = "Bypassing security protocols..."},
            {t = 0.85, msg = "Injetando dependências..."},
            {t = 0.95, msg = "Finalizando interface..."}
        }

        local startTime = tick()

        while true do
            local elapsed = tick() - startTime
            local progress = math.min(elapsed / totalTime, 1)

            progressBar.Size = UDim2.new(progress, 0, 1, 0)

            for _, step in ipairs(steps) do
                if progress >= step.t and progress < (step.t + 0.1) then
                    loadStatus.Text = step.msg
                end
            end

            if progress >= 1 then
                loadStatus.Text = "ACCESS GRANTED"
                task.wait(0.5)
                break
            end

            RunService.RenderStepped:Wait()
        end

        TweenService:Create(loadingBg, TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
        TweenService:Create(loadContainer, TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0.5, -100)}):Play()
        TweenService:Create(logoImg, TweenInfo.new(1, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {ImageTransparency = 1}):Play()

        task.wait(1)
        loadingGui:Destroy()
        onComplete()
    end)
end

