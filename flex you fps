local function setupHooks(controls)
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if self == nyaRemote and method == "FireServer" then
            local args = {...}
            if type(args[1]) == "table" then
                local m = args[1]
                if m.t == "metrics" and type(m.token) == "number" then
                    if controls.FPS.enabled() then
                        local val = tonumber(controls.FPS.box.Text)
                        if val then
                            local delta = math.random(1, 15)
                            if math.random(1, 2) == 1 then
                                m.fps = val + delta
                            else
                                m.fps = val - delta
                            end
                        end
                    end
                    if controls.Mem.enabled() then
                        local val = tonumber(controls.Mem.box.Text)
                        if val then
                            local delta = math.random(1, 25)
                            if math.random(1, 2) == 1 then
                                m.mem = val + delta
                            else
                                m.mem = val - delta
                            end
                        end
                    end
                    if controls.Res.enabled() then
                        local text = controls.Res.box.Text
                        local x, y = text:match("(%d+)x(%d+)")
                        if x and y then m.res = Vector2.new(tonumber(x), tonumber(y)) end
                    end
                    if controls.GFX.enabled() then
                        local val = tonumber(controls.GFX.box.Text)
                        if val then
                            local levels = {}
                            for i = 1, 10 do
                                levels[i] = Enum.SavedQualitySetting["QualityLevel" .. i]
                            end
                            m.gfx = levels[val] or m.gfx
                        end
                    end
                end
            end
            return oldNamecall(self, unpack(args))
        end
        return oldNamecall(self, ...)
    end)
end

local function setupFreeOscillatingBypass()
    local bypassActive = true
    local bypassState = true

    task.spawn(function()
        local startTime = tick()
        local duration = 120
        while tick() - startTime < duration do
            bypassState = math.random(1, 100) > 30
            task.wait(math.random(5, 15) / 10)
        end
        bypassActive = false
    end)

    local oldNamecallBypass
    oldNamecallBypass = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if method == "Kick" and self ~= player then
            if bypassActive and bypassState then
                return nil
            end
        end
        return oldNamecallBypass(self, ...)
    end)
end

