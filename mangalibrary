		Font = Enum.Font.Gotham,
		TextSize = IS_MOBILE and 12 or 13,
		TextColor3 = theme.Text,
		PlaceholderText = "Pesquisar...",
		PlaceholderColor3 = theme.SubText,
		Text = "",
		Parent = Bar,
	})

	local results = {}
	Box:GetPropertyChangedSignal("Text"):Connect(function()
		local query = Box.Text:lower()
		for _, tab in ipairs(self.Tabs) do
			for _, section in ipairs(tab.Page:GetChildren()) do
				if section:IsA("Frame") then
					local visible = query == "" or section.Name:lower():find(query, 1, true)
					if not visible then
						for _, desc in ipairs(section:GetDescendants()) do
							if desc:IsA("TextLabel") and desc.Text:lower():find(query, 1, true) then
								visible = true
								break
							end
						end
					end
					section.Visible = visible
				end
			end
		end
	end)

	return Box
end

function MangaUI:CreatePlayerList(section, opts)
	opts = opts or {}
	local theme = self.Theme
	local Dropdown = section:CreateDropdown({
		Text = opts.Text or "Jogador",
		List = {},
		Callback = opts.Callback,
	})

	local function refresh()
		local names = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer or opts.IncludeSelf then
				table.insert(names, plr.Name)
			end
		end
		Dropdown:Refresh(names)
	end

	refresh()
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(refresh)

	return Dropdown
end

function MangaUI:CreateStatusLabel(parentFrame)
	local theme = self.Theme
	local Label = New("TextLabel", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "",
		Parent = parentFrame,
	})
	parentFrame.Visible = true

	local frames = 0
	local lastTime = os.clock()
	local fps = 0

	RunService.RenderStepped:Connect(function()
		frames = frames + 1
		local now = os.clock()
		if now - lastTime >= 1 then
			fps = frames
			frames = 0
			lastTime = now
		end
		local ping = math.floor((LocalPlayer:GetNetworkPing() or 0) * 1000)
		Label.Text = string.format("FPS: %d  |  Ping: %dms", fps, ping)
	end)

	return Label
end

function MangaUI:CreateAboutSection(tab, opts)
	opts = opts or {}
	local section = tab:CreateSection(opts.Title or "About")
	section:CreateLabel(opts.Description or "")
	if opts.Credits then
		section:CreateLabel("Créditos: " .. opts.Credits)
	end
	if opts.Discord then
		section:CreateButton({
			Text = "Discord: " .. opts.Discord,
			Callback = function()
				if typeof(setclipboard) == "function" then
					setclipboard(opts.Discord)
				end
			end,
		})
	end
	return section
end

return MangaUI
