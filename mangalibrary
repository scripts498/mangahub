		BackgroundColor3 = theme.Secondary,
		Size = UDim2.new(1, 0, 0, IS_MOBILE and 40 or 46),
		Parent = Main,
	})
	Round(TopBar, 12)
	New("Frame", {
		BackgroundColor3 = theme.Secondary,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -12),
		Size = UDim2.new(1, 0, 0, 12),
		Parent = TopBar,
	})
	local AccentLine = New("Frame", {
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 0, 1, -1),
		Size = UDim2.new(1, 0, 0, 2),
		ZIndex = 3,
		Parent = TopBar,
	})
	Gradient(AccentLine, ColorSequence.new(theme.Accent, theme.AccentDark), 0)

	local IconImg
	local titleX = 14
	if self.Icon then
		IconImg = New("ImageLabel", {
			BackgroundTransparency = 1,
			Image = self.Icon,
			Size = UDim2.new(0, 24, 0, 24),
			Position = UDim2.new(0, 14, 0.5, -12),
			Parent = TopBar,
		})
		titleX = 46
	end

	local TitleLabel = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, titleX, 0, 6),
		Size = UDim2.new(1, -140, 0, 18),

		Font = Enum.Font.GothamBold,
		TextSize = IS_MOBILE and 13 or 15,
		TextColor3 = theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = self.Title,
		Parent = TopBar,
	})
	local SubLabel = New("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, titleX, 0, 24),
		Size = UDim2.new(1, -140, 0, 14),

		Font = Enum.Font.Gotham,
		TextSize = IS_MOBILE and 10 or 11,
		TextColor3 = theme.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = self.SubTitle,
		Parent = TopBar,
	})
	self.TitleLabel, self.SubLabel = TitleLabel, SubLabel

	local ControlHolder = New("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.new(0, IS_MOBILE and 54 or 62, 0, IS_MOBILE and 22 or 26),
		Parent = TopBar,
	})
	ListLayout(ControlHolder, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Right)

	local function ControlButton(order, hoverColor)
		local btn = New("TextButton", {
			BackgroundColor3 = theme.Tertiary,
			Size = UDim2.new(0, IS_MOBILE and 22 or 26, 0, IS_MOBILE and 22 or 26),
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = order,
			Parent = ControlHolder,
		})
		Round(btn, 8)
		btn.MouseEnter:Connect(function()
			Tween(btn, EASE_FAST, {BackgroundColor3 = hoverColor or theme.Accent})
		end)
		btn.MouseLeave:Connect(function()
			Tween(btn, EASE_FAST, {BackgroundColor3 = theme.Tertiary})
		end)
		return btn
	end

	local function IconBar(parent, w, h, rotation, color)
		local bar = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, w, 0, h),
			Rotation = rotation or 0,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = parent,
		})
		Round(bar, 2)
		return bar
	end

	local MinimizeBtn = ControlButton(1, theme.Tertiary)
	local MinimizeIcon = IconBar(MinimizeBtn, 11, 2, 0, theme.Text)

	local CloseBtn = ControlButton(2, theme.Error)
	local CloseBar1 = IconBar(CloseBtn, 12, 2, 45, theme.Text)
	local CloseBar2 = IconBar(CloseBtn, 12, 2, -45, theme.Text)

	local sidebarWidth = IS_MOBILE and 80 or 140

	local topBarHeight = IS_MOBILE and 40 or 46
	local Sidebar = New("Frame", {
		Name = "Sidebar",
		BackgroundColor3 = theme.Secondary,
		Position = UDim2.new(0, 0, 0, topBarHeight),
		Size = UDim2.new(0, sidebarWidth, 1, -topBarHeight),
		Parent = Main,
	})
	Pad(Sidebar, IS_MOBILE and 6 or 8, IS_MOBILE and 6 or 8, IS_MOBILE and 6 or 8, IS_MOBILE and 6 or 8)
	local TabListLayout = ListLayout(Sidebar, Enum.FillDirection.Vertical, IS_MOBILE and 4 or 6)

	local ContentHolder = New("Frame", {
		Name = "ContentHolder",
		BackgroundTransparency = 1,
		Position = UDim2.new(0, sidebarWidth, 0, topBarHeight),
		Size = UDim2.new(1, -sidebarWidth, 1, -topBarHeight),
		Parent = Main,
	})
	Pad(ContentHolder, IS_MOBILE and 8 or 12, IS_MOBILE and 8 or 12, IS_MOBILE and 8 or 12, IS_MOBILE and 8 or 12)

	self.Sidebar = Sidebar
	self.ContentHolder = ContentHolder

	function self:ToggleUI()
		self.Open = not self.Open
		if self.Open then
			Main.Visible = true
			Main.Size = UDim2.new(0, self.Size.X, 0, 0)
			Tween(Main, EASE, {Size = UDim2.new(0, self.Size.X, 0, self.Size.Y)})
		else
			local t = Tween(Main, EASE, {Size = UDim2.new(0, self.Size.X, 0, 0)})
			t.Completed:Connect(function()
				if not self.Open then Main.Visible = false end
			end)
		end
	end

	if IS_MOBILE then
		local FloatBtn = New("ImageButton", {
			Name = "FloatButton",
			BackgroundColor3 = theme.Accent,
			Size = UDim2.new(0, 55, 0, 55),
			Position = UDim2.new(0, 16, 0, 16),
			Image = "",
			AutoButtonColor = false,
			Parent = ScreenGui,
		})
		Round(FloatBtn, 25)
		Stroke(FloatBtn, theme.Stroke, 1, 0.3)
		local HamburgerHolder = New("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.new(0, 22, 0, 16),
			Parent = FloatBtn,
		})
		ListLayout(HamburgerHolder, Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		for i = 1, 3 do
			New("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 2),
				LayoutOrder = i,
				Parent = HamburgerHolder,
			})
		end

		do
			local dragging, dragStart, startPos = false, nil, nil
			FloatBtn.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = true
					dragStart = input.Position
					startPos = FloatBtn.Position
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
					local delta = input.Position - dragStart
					FloatBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = false
				end
			end)
			FloatBtn.MouseButton1Click:Connect(function()
				self:ToggleUI()
			end)
		end
	end

	self.Minimized = false
	function self:ToggleMinimize()
		self.Minimized = not self.Minimized
		if self.Minimized then
			Sidebar.Visible = false
			ContentHolder.Visible = false
			Tween(Main, EASE, {Size = UDim2.new(0, self.Size.X, 0, 46)})
			Tween(MinimizeIcon, EASE_FAST, {Rotation = 180})
		else
			Tween(Main, EASE, {Size = UDim2.new(0, self.Size.X, 0, self.Size.Y)})
			Tween(MinimizeIcon, EASE_FAST, {Rotation = 0})
			task.delay(0.15, function()
				if not self.Minimized then
					Sidebar.Visible = true
					ContentHolder.Visible = true
				end
			end)
		end
	end

	MinimizeBtn.MouseButton1Click:Connect(function()
		self:ToggleMinimize()
	end)
	CloseBtn.MouseButton1Click:Connect(function()
		local t = Tween(Main, EASE, {Size = UDim2.new(0, self.Size.X, 0, 0), BackgroundTransparency = 1})
		t.Completed:Connect(function()
			self:Destroy()
		end)
	end)

	do
		local dragging = false
		local dragStart, startPos

		local function beginDrag(input)
			dragging = true
			dragStart = input.Position
			startPos = Main.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end

		local function updateDrag(input)
			if not dragging then return end
			local delta = input.Position - dragStart
			Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end

		TopBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				beginDrag(input)
			end
		end)
		TopBar.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				updateDrag(input)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				updateDrag(input)
			end
		end)
	end

	if not IS_MOBILE then
		local ResizeHandle = New("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, 0, 1, 0),
			Size = UDim2.new(0, 18, 0, 18),
			Parent = Main,
		})
		local resizing, startMouse, startSize = false, nil, nil
		ResizeHandle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = true
				startMouse = input.Position
				startSize = Main.Size
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if resizing and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - startMouse
				local newW = math.max(IS_MOBILE and 280 or 420, startSize.X.Offset + delta.X)
				local newH = math.max(IS_MOBILE and 200 or 280, startSize.Y.Offset + delta.Y)
				Main.Size = UDim2.new(0, newW, 0, newH)
				self.Size = Vector2.new(newW, newH)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = false
			end
		end)
	end

	self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightControl
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == self.ToggleKey then
			self:ToggleUI()
		end
	end)

	if opts.ShowStatus ~= false then
		local StatusBar = New("Frame", {
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, IS_MOBILE and 6 or 10),
			Size = UDim2.new(0, IS_MOBILE and 120 or 150, 0, 14),
			ZIndex = 5,
			Parent = TopBar,
		})
		StatusBar.Visible = false
		self.StatusBar = StatusBar
	end

	function self:SetTitle(text)
		self.Title = text
		TitleLabel.Text = text
	end

	function self:SetSubTitle(text)
		self.SubTitle = text
		SubLabel.Text = text
	end

	function self:SetIcon(image)
		self.Icon = image
		if IconImg then
			IconImg.Image = image
		end
	end

	function self:Destroy()
		for _, conn in ipairs(self.Connections) do
			pcall(function() conn:Disconnect() end)
		end
		ScreenGui:Destroy()
	end

	function self:SetTheme(name)
		local newTheme = Themes[name]
		if not newTheme then return end
		self.Theme = newTheme
		self.ThemeName = name
		Main.BackgroundColor3 = newTheme.Background
		TopBar.BackgroundColor3 = newTheme.Secondary
		Sidebar.BackgroundColor3 = newTheme.Secondary
		TitleLabel.TextColor3 = newTheme.Text
		SubLabel.TextColor3 = newTheme.SubText
	end

	function self:SaveConfig(name)
		return self.Config:Save(name)
	end
	function self:LoadConfig(name)
		return self.Config:Load(name)
	end
	function self:ListConfigs()
		return self.Config:List()
	end

	self._tabCount = 0
	return self
end

