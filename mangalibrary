local ConfigSystem = {}
ConfigSystem.__index = ConfigSystem

local function fileFunctionsExist()
	return typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
end

function ConfigSystem.new(folder)
	local self = setmetatable({}, ConfigSystem)
	self.Folder = folder or "MangaUI"
	self.Flags = {}
	if fileFunctionsExist() and typeof(makefolder) == "function" and not isfolder(self.Folder) then
		makefolder(self.Folder)
	end
	return self
end

function ConfigSystem:Register(flagName, getter, setter)
	if not flagName then return end
	self.Flags[flagName] = {Get = getter, Set = setter}
end

function ConfigSystem:Save(name)
	if not fileFunctionsExist() then return false, "executor sem suporte a arquivos" end
	local data = {}
	for flag, funcs in pairs(self.Flags) do
		local okGet, value = pcall(funcs.Get)
		if okGet then
			data[flag] = value
		end
	end
	local path = self.Folder .. "/" .. name .. ".json"
	writefile(path, HttpService:JSONEncode(data))
	return true
end

function ConfigSystem:Load(name)
	if not fileFunctionsExist() then return false, "executor sem suporte a arquivos" end
	local path = self.Folder .. "/" .. name .. ".json"
	if not isfile(path) then return false, "config não existe" end
	local okDecode, data = pcall(HttpService.JSONDecode, HttpService, readfile(path))
	if not okDecode then return false, "config corrompida" end
	for flag, value in pairs(data) do
		local funcs = self.Flags[flag]
		if funcs and funcs.Set then
			pcall(funcs.Set, value)
		end
	end
	return true
end

function ConfigSystem:List()
	if not fileFunctionsExist() or typeof(listfiles) ~= "function" then return {} end
	local files = listfiles(self.Folder)
	local names = {}
	for _, f in ipairs(files) do
		local name = f:match("([^/\\]+)%.json$")
		if name then table.insert(names, name) end
	end
	return names
end

function MangaUI:CreateWindow(opts)
