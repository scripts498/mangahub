				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				Parent = Holder,
			})

			local Textbox = {}

			Box.FocusLost:Connect(function(enterPressed)
				local text = Box.Text
				if o.Validate then
					local okValid, result = pcall(o.Validate, text)
					if not okValid or result == false then
						Tween(Holder, EASE_FAST, {BackgroundColor3 = th2.Error})
						task.delay(0.3, function()
							Tween(Holder, EASE_FAST, {BackgroundColor3 = th2.Tertiary})
						end)
						return
					end
				end
				if o.Callback then
					task.spawn(o.Callback, text, enterPressed)
				end
			end)

			function Textbox:SetValue(text)
				Box.Text = text
			end
			function Textbox:GetValue()
				return Box.Text
			end

			if o.Flag then
				win.Config:Register(o.Flag, function() return Box.Text end, function(v) Box.Text = v end)
