			local function refreshHolderHeight()
				if expanded then
					Holder.Size = UDim2.new(1, 0, 0, (IS_MOBILE and 36 or 40) + (#list * (IS_MOBILE and 28 or 30)) + 6)
				else
					Holder.Size = UDim2.new(1, 0, 0, IS_MOBILE and 30 or 34)
				end
			end

			local function rebuild()
				for _, b in ipairs(optionButtons) do b:Destroy() end
				optionButtons = {}
				for i, item in ipairs(list) do
					local OptBtn = New("TextButton", {
						BackgroundColor3 = th2.Secondary,
						Size = UDim2.new(1, 0, 0, IS_MOBILE and 24 or 26),
						Text = "",
						AutoButtonColor = false,
						LayoutOrder = i,
						Parent = ListFrame,
					})
					Round(OptBtn, 6)
					New("TextLabel", {
						BackgroundTransparency = 1,
						Position = UDim2.new(0, 8, 0, 0),
						Size = UDim2.new(1, -16, 1, 0),
						Font = Enum.Font.Gotham,
						TextSize = IS_MOBILE and 11 or 12,
						TextColor3 = th2.Text,
						TextXAlignment = Enum.TextXAlignment.Left,
						Text = tostring(item),
						Parent = OptBtn,
					})
					OptBtn.MouseEnter:Connect(function()
						Tween(OptBtn, EASE_FAST, {BackgroundColor3 = th2.Accent})
					end)
					OptBtn.MouseLeave:Connect(function()
						Tween(OptBtn, EASE_FAST, {BackgroundColor3 = th2.Secondary})
					end)
					OptBtn.MouseButton1Click:Connect(function()
						selected = item
						SelectedLabel.Text = tostring(item)
						if o.Callback then task.spawn(o.Callback, item) end
						expanded = false
						Tween(Arrow, EASE_FAST, {Rotation = 0})
						refreshHolderHeight()
					end)
					table.insert(optionButtons, OptBtn)
				end
			end
			rebuild()
			refreshHolderHeight()

			MainBtn.MouseButton1Click:Connect(function()
				expanded = not expanded
				Tween(Arrow, EASE_FAST, {Rotation = expanded and 180 or 0})
				refreshHolderHeight()
			end)

			function Dropdown:Add(item)
				table.insert(list, item)
				rebuild()
				refreshHolderHeight()
			end
			function Dropdown:Remove(item)
				for i, v in ipairs(list) do
					if v == item then table.remove(list, i) break end
				end
				rebuild()
				refreshHolderHeight()
			end
			function Dropdown:Refresh(newList)
				list = newList or {}
				rebuild()
				refreshHolderHeight()
			end
			function Dropdown:SetValue(item)
				selected = item
				SelectedLabel.Text = tostring(item)
			end
			function Dropdown:GetValue()
				return selected
			end

			if o.Flag then
				win.Config:Register(o.Flag, function() return selected end, function(v) Dropdown:SetValue(v) end)
			end

			return Dropdown
		end

