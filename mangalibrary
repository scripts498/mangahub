					KeyLabel.Text = currentKey.Name
					listening = false
					if o.OnChanged then task.spawn(o.OnChanged, currentKey) end
					return
				end
				if gpe then return end
				if not listening and input.KeyCode == currentKey and o.Callback then
					task.spawn(o.Callback)
				end
			end)
			table.insert(win.Connections, conn)

			function Keybind:SetValue(keyCode)
				currentKey = keyCode
				KeyLabel.Text = currentKey.Name
			end
			function Keybind:GetValue()
				return currentKey
			end

			if o.Flag then
				win.Config:Register(o.Flag, function() return currentKey.Name end, function(v)
