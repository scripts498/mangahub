		function Section:CreateSlider(o)
			o = o or {}
			local th2 = win.Theme
			local min = o.Min or 0
			local max = o.Max or 100
			local value = math.clamp(o.Default or min, min, max)
			local decimals = o.Decimals or 0

			local Holder = New("Frame", {
				BackgroundColor3 = th2.Tertiary,
				Size = UDim2.new(1, 0, 0, 46),
				LayoutOrder = nextOrder(),
				Parent = ElementHolder,
			})
			Round(Holder, 8)
			Pad(Holder, 12, 8, 12, 8)

			New("TextLabel", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -50, 0, 16),
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = th2.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = o.Text or "Slider",
				Parent = Holder,
			})

			local ValueLabel = New("TextLabel", {
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 0, 0, 0),
				Size = UDim2.new(0, 50, 0, 16),
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = th2.Accent,
				TextXAlignment = Enum.TextXAlignment.Right,
				Text = tostring(value),
				Parent = Holder,
			})

			local Track = New("Frame", {
				BackgroundColor3 = th2.Stroke,
				Position = UDim2.new(0, 0, 0, 26),
				Size = UDim2.new(1, 0, 0, 6),
				Parent = Holder,
			})
			Round(Track, 3)

			local Fill = New("Frame", {
				BackgroundColor3 = th2.Accent,
				Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
				Parent = Track,
			})
			Round(Fill, 3)

			local Knob = New("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
				Size = UDim2.new(0, 14, 0, 14),
				ZIndex = 2,
				Parent = Track,
			})
			Round(Knob, 7)
			Stroke(Knob, th2.Accent, 2, 0)

			local Slider = {}
			local dragging = false

			local function setFromAlpha(alpha)
				alpha = math.clamp(alpha, 0, 1)
				local raw = min + (max - min) * alpha
				if decimals <= 0 then
					raw = math.floor(raw + 0.5)
				else
					local mult = 10 ^ decimals
					raw = math.floor(raw * mult + 0.5) / mult
				end
				value = raw
				local a2 = (value - min) / (max - min)
				Fill.Size = UDim2.new(a2, 0, 1, 0)
				Knob.Position = UDim2.new(a2, 0, 0.5, 0)
				ValueLabel.Text = tostring(value)
				if o.Callback then
					task.spawn(o.Callback, value)
				end
			end

			local function beginDrag(input)
				dragging = true
				local relX = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
				setFromAlpha(relX)
			end

			Track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					beginDrag(input)
				end
			end)
			Knob.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local relX = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
					setFromAlpha(relX)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)

			function Slider:SetValue(v)
				setFromAlpha((v - min) / (max - min))
			end
			function Slider:GetValue()
				return value
			end

			if o.Flag then
				win.Config:Register(o.Flag, function() return value end, function(v) Slider:SetValue(v) end)
			end

			return Slider
		end

