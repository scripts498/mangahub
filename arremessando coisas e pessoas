local function lockBlobPlayer()
    local player,
        character,
        targetRoot =
        getSelectedBlobTarget()

    if not player then
        return
    end

    local blob =
        getMountedBlobman()

    if not blob then
        Window:Notify({
            Title = "Blobman",
            Text = "Sente no Blobman primeiro.",
            Duration = 2
        })

        return
    end

    local grabbed,
        side,
        distance =
        grabBlobTarget(
            blob,
            targetRoot
        )

    if not grabbed then
        Window:Notify({
            Title = "Blobman",

            Text =
                distance ~= math.huge
                and string.format(
                    "Fora do alcance: %.1f studs",
                    distance
                )
                or "Grab falhou.",

            Duration = 2
        })

        return
    end

    local deadline =
        os.clock()
        + Config.BlobGrabConfirmTime

    while os.clock()
        < deadline
    do

        if targetHeld(
            player
        ) then
            break
        end

        RunService.Heartbeat:
            Wait()
    end

    task.wait(
        Config.BlobLockJumpDelay
    )

    jumpFromBlob()

    Window:Notify({
        Title = "Blobman",

        Text =
            "Lock: "
            .. player.Name
            .. " ["
            .. tostring(side)
            .. "]",

        Duration = 2
    })
end

local function bringBlobPlayer()
    local player,
        character,
        targetRoot =
        getSelectedBlobTarget()

    if not player then
        return
    end

    local blob =
        getMountedBlobman()

    if not blob then
        Window:Notify({
            Title = "Blobman",
            Text = "Sente no Blobman primeiro.",
            Duration = 2
        })

        return
    end

    task.spawn(function()
        local deadline =
            os.clock()
            + Config.BlobBringTimeout

        while State.Running
            and player.Parent
                == Players
            and targetRoot.Parent
            and os.clock()
                < deadline
        do

            local success,
                side,
                distance =
                grabBlobTarget(
                    blob,
                    targetRoot
                )

            if not success
                and distance
                    > Config.BlobGrabRange
            then

                Window:Notify({
                    Title = "Blobman",

                    Text =
                        string.format(
                            "Fora do alcance: %.1f studs",
                            distance
                        ),

                    Duration = 2
                })

                return
            end

            task.wait(
                Config.BlobBringInterval
            )
        end
    end)
end

