local function getObjectPosition(object)
    if not object then
        return nil
    end

    if object:IsA(
        "BasePart"
    ) then

        return object.Position
    end

    if object:IsA(
        "Model"
    ) then

        local part =
            object.PrimaryPart
            or object:
                FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

        return part
            and part.Position
            or nil
    end

    local part =
        object:
            FindFirstChildWhichIsA(
                "BasePart",
                true
            )

    return part
        and part.Position
        or nil
end

local function findGrabWeld(
    detector,
    side
)
    if not detector then
        return nil
    end

    local names = {
        side .. "Weld",
        "AttachPlayer",
        "PlayerWeld",
        "GrabWeld",
        "Weld"
    }

    for _, name in ipairs(
        names
    ) do

        local object =
            detector:
                FindFirstChild(
                    name,
                    true
                )

        if object then
            return object
        end
    end

    for _, object in ipairs(
        detector:GetDescendants()
    ) do

        if object:IsA(
            "Weld"
        )
            or object:IsA(
                "WeldConstraint"
            )
        then

            return object
        end
    end

    return nil
end

