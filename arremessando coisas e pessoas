local function currentGrabEffectPart()
    local grabParts =
        Workspace:
            FindFirstChild(
                "GrabParts"
            )

    if not grabParts then
        return nil
    end

    local grabPart =
        grabParts:
            FindFirstChild(
                "GrabPart"
            )

    if not grabPart then
        return nil
    end

    local weld =
        grabPart:
            FindFirstChild(
                "WeldConstraint"
            )
        or grabPart:
            FindFirstChildWhichIsA(
                "WeldConstraint"
            )

    if weld
        and valid(weld.Part1)
    then
        return weld.Part1
    end

    return nil
end

local function grabEffectPlayerFromPart(
    part
)
    local current = part

    while current
        and current ~= Workspace
    do
        if current:IsA("Model") then
            local player =
                Players:
                    GetPlayerFromCharacter(
                        current
                    )

            if player then
                return player,
                    current
            end
        end

        current = current.Parent
    end

    return nil,
        nil
end

local function grabEffectContainer(
    part,
    character
)
    if character then
        return character
    end

    if not valid(part) then
        return nil
    end

    if part:IsA("Model") then
        return part
    end

    local current =
        part.Parent

    while current
        and current ~= Workspace
    do
        if current:IsA("Model") then
            if Workspace:
                    FindFirstChild(
                        "Map"
                    )
                and current:IsDescendantOf(
                    Workspace.Map
                )
            then
                break
            end

            return current
        end

        current = current.Parent
    end

    return part
end

local function appendGrabEffectPart(
    list,
    seen,
    part
)
    if part
        and part:IsA("BasePart")
        and part.Parent
        and not seen[part]
    then
        seen[part] = true
        table.insert(
            list,
            part
        )
    end
end

local function grabEffectParts(
    part,
    character
)
    local result = {}
    local seen = {}

    local container =
        grabEffectContainer(
            part,
            character
        )

    if typeof(container)
        == "Instance"
    then
        if container:IsA("BasePart") then
            appendGrabEffectPart(
                result,
                seen,
                container
            )

            local root =
                getAssemblyRoot(
                    container
                )

            appendGrabEffectPart(
                result,
                seen,
                root
            )

            if root then
                local ok,
                    connected =
                    pcall(
                        root.GetConnectedParts,
                        root,
                        true
                    )

                if ok
                    and type(connected)
                        == "table"
                then
                    for _, linked in ipairs(
                        connected
                    ) do
                        appendGrabEffectPart(
                            result,
                            seen,
                            linked
                        )
                    end
                end
            end
        else
            for _, descendant in ipairs(
                container:GetDescendants()
            ) do
                appendGrabEffectPart(
                    result,
                    seen,
                    descendant
                )
            end
        end
    end

    if #result <= 0
        and valid(part)
        and part:IsA("BasePart")
    then
        appendGrabEffectPart(
            result,
            seen,
            part
        )
    end

    return result
end

local function applyGrabMassless(
    parts
)
    for _, part in ipairs(parts) do
        if State.GrabMasslessOriginal[part]
            == nil
        then
            State.GrabMasslessOriginal[part] =
                part.Massless
        end

        pcall(function()
            part.Massless = true
        end)
    end
end

local function applyGrabNoclip(
    parts
)
    for _, part in ipairs(parts) do
        if State.GrabCollideOriginal[part]
            == nil
        then
            State.GrabCollideOriginal[part] =
                part.CanCollide
        end

        pcall(function()
            part.CanCollide = false
        end)
    end
end

local function findKillGrabHazard()
    if State.KillGrabHazard
        and State.KillGrabHazard.Parent
    then
        return State.KillGrabHazard
    end

    local map =
        Workspace:
            FindFirstChild(
                "Map"
            )

    local searchRoot =
        map
        or Workspace

    for _, descendant in ipairs(
        searchRoot:GetDescendants()
    ) do
        if descendant:IsA("BasePart")
            and descendant.Name
                == "PoisonHurtPart"
        then
            State.KillGrabHazard =
                descendant

            State.KillGrabHazardState = {
                CFrame = descendant.CFrame,
                Size = descendant.Size,
                Transparency =
                    descendant.Transparency
            }

            return descendant
        end
    end

    return nil
end

local function applyKillGrab(
    player,
    character
)
    if not player
        or player == LocalPlayer
        or not character
        or not character.Parent
    then
        return
    end

    local humanoid =
        character:
            FindFirstChildOfClass(
                "Humanoid"
            )

    if not humanoid
        or humanoid.Health <= 0
    then
        return
    end

    local head =
        character:
            FindFirstChild(
                "Head"
            )
        or character:
            FindFirstChild(
                "HumanoidRootPart"
            )

    if not head
        or not head:IsA("BasePart")
    then
        return
    end

    local hazard =
        findKillGrabHazard()

    if not hazard then
        return
    end

    pcall(function()
        hazard.Size =
            Vector3.new(
                2,
                2,
                2
            )

        hazard.Transparency = 1
        hazard.CFrame = head.CFrame
    end)
end

local function updateGrabEffects()
    local part =
        currentGrabEffectPart()

    if not valid(part) then
        if State.GrabEffectTarget
            ~= nil
        then
            resetGrabEffectsTransient()
        end

        return
    end

    local player,
        character =
        grabEffectPlayerFromPart(
            part
        )

    local targetIdentity =
        character
        or getAssemblyRoot(part)
        or part

    if State.GrabEffectTarget
        ~= targetIdentity
    then
        resetGrabEffectsTransient()

        State.GrabEffectTarget =
            targetIdentity
        State.GrabEffectTargetPlayer =
            player
        State.GrabEffectTargetCharacter =
            character
        State.GrabEffectStarted =
            os.clock()
    end

    local now =
        os.clock()

    local parts =
        grabEffectParts(
            part,
            character
        )

    if Config.MasslessGrab then
        applyGrabMassless(
            parts
        )
    else
        restoreGrabMassless()
    end

    if Config.NoclipGrab then
        applyGrabNoclip(
            parts
        )
    else
        restoreGrabCollisions()
    end

    local targetHumanoid =
        character
        and character:
            FindFirstChildOfClass(
                "Humanoid"
            )

    if Config.KillGrab
        and player
        and player ~= LocalPlayer
        and character
        and targetHumanoid
        and targetHumanoid.Health > 0
        and now
            - State.GrabEffectStarted
            >= Config.KillGrabHoldTime
    then
        State.KillGrabTriggered =
            true

        applyKillGrab(
            player,
            character
        )
    else
        if State.KillGrabTriggered
            or State.KillGrabHazard
        then
            restoreKillGrabHazard()
        end

        State.KillGrabTriggered =
            false
    end
end

local GrabEffectsController = {}

function GrabEffectsController.Stop()
    Config.KillGrab = false
    Config.MasslessGrab = false
    Config.NoclipGrab = false

    resetGrabEffectsTransient()

    if ENV.MangaGrabEffectsController
        == GrabEffectsController
    then
        ENV.MangaGrabEffectsController = nil
    end
end

ENV.MangaGrabEffectsController =
    GrabEffectsController

task.spawn(function()
    while State.Running do
        if Config.KillGrab
            or Config.MasslessGrab
            or Config.NoclipGrab
        then
            updateGrabEffects()
        elseif State.GrabEffectTarget
            or next(State.GrabMasslessOriginal)
            or next(State.GrabCollideOriginal)
            or State.KillGrabHazard
        then
            resetGrabEffectsTransient()
        end

        task.wait(
            Config.GrabEffectsPulse
        )
    end

    resetGrabEffectsTransient()

    if ENV.MangaGrabEffectsController
        == GrabEffectsController
    then
        ENV.MangaGrabEffectsController = nil
    end
end)

local function refreshCorrectionRemotes()
    if not GameCorrectionEvents
        or not GameCorrectionEvents.Parent
    then
        GameCorrectionEvents =
            ReplicatedStorage:
                FindFirstChild(
                    "GameCorrectionEvents"
                )
    end

    if GameCorrectionEvents
        and (
            not StopAllVelocity
            or not StopAllVelocity.Parent
        )
    then
        StopAllVelocity =
            GameCorrectionEvents:
                FindFirstChild(
                    "StopAllVelocity"
                )
    end

    if not RagdollRemote
        or not RagdollRemote.Parent
    then
        RagdollRemote =
            CharacterEvents:
                FindFirstChild(
                    "RagdollRemote"
                )
    end
end

local function findIsHeld()
    local held =
        LocalPlayer:
            FindFirstChild(
                "IsHeld",
                true
            )

    if held then
        return held
    end

    local character =
        LocalPlayer.Character

    if character then
        return character:
            FindFirstChild(
                "IsHeld",
                true
            )
    end

    return nil
end

local function getHeadPartOwner()
    local head =
        State.Head

    if not head
        or not head.Parent
    then
        return nil
    end

    return head:
        FindFirstChild(
            "PartOwner"
        )
end

local function markerValue(marker)
    if not marker
        or not marker.Parent
    then
        return nil
    end

    local ok, value =
        pcall(function()
            return marker.Value
        end)

    if ok then
        return value
    end

    return nil
end

local function markerHostile(marker)
    if not marker
        or not marker.Parent
    then
        return false
    end

    local value =
        markerValue(marker)

    if typeof(value)
        == "string"
    then
        if value == "" then
            return true
        end

        return string.lower(
            value
        ) ~= string.lower(
            LocalPlayer.Name
        )
    end

    if typeof(value)
        == "number"
    then
        return value
            ~= LocalPlayer.UserId
    end

    if typeof(value)
        == "Instance"
    then
        if value
            == LocalPlayer
            or value
                == LocalPlayer.Character
        then
            return false
        end

        if LocalPlayer.Character
            and value:
                IsDescendantOf(
                    LocalPlayer.Character
                )
        then
            return false
        end

        return true
    end

    return true
end

local function activateGrab()
    State.GrabUntil =
        math.max(
            State.GrabUntil,
            os.clock()
                + Config.GrabTail
        )
end

local function grabActive()
    return Config.AntiGrab
        and os.clock()
            < State.GrabUntil
end

local function ownershipMarkerActive()
    if not Config.AntiOwnershipSpam then
        return false
    end

    local marker =
        getHeadPartOwner()

    return marker
        and markerHostile(
            marker
        )
        or false
end

local function ownershipActive()
    if not Config.AntiOwnershipSpam then
        return false
    end

    if ownershipMarkerActive() then
        return true
    end

    return os.clock()
        - State.OwnershipLastSeen
        <= Config.OwnershipQuietTail
end

local function defenseActive()
    return grabActive()
        or ownershipActive()
end

local function isHeld()
    local held =
        State.IsHeld

    return Config.AntiGrab
        and held
        and held.Parent
        and held:IsA(
            "BoolValue"
        )
        and held.Value == true
end

local function fireStruggle()
    if not State.Running then
        return
    end

    pcall(function()
        StruggleRemote:
            FireServer(
                LocalPlayer
            )
    end)
end

local function fireStopVelocity()
    refreshCorrectionRemotes()

    if not StopAllVelocity then
        return
    end

    pcall(function()
        StopAllVelocity:
            FireServer()
    end)
end

local function fireRagdollReset()
    refreshCorrectionRemotes()

    if not RagdollRemote then
        return
    end

    local root =
        State.Root

    if not root
        or not root.Parent
    then
        return
    end

    local now =
        os.clock()

    if now
        - State.LastRagdoll
        < Config.RagdollResetInterval
    then
        return
    end

    State.LastRagdoll =
        now

    pcall(function()
        RagdollRemote:
            FireServer(
                root,
                0
            )
    end)
end

local function struggleBurst()
    if State.BurstRunning then
        return
    end

    State.BurstRunning =
        true

    task.spawn(function()
        for _ = 1,
            Config.StruggleBurstCount
        do
            if not State.Running then
                break
            end

            if not defenseActive()
                and not isHeld()
            then
                break
            end

            fireStruggle()

            task.wait(
                Config.StruggleBurstDelay
            )
        end

        State.BurstRunning = false
    end)
end

local function zeroCharacterPhysics()
    local character =
        State.Character

    if not character then
        return
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do
        if object:IsA(
            "BasePart"
        )
        then
            pcall(function()
                object.AssemblyLinearVelocity =
                    Vector3.zero

                object.AssemblyAngularVelocity =
                    Vector3.zero
            end)
        end
    end
end

local function freezePart(part)
    if not part
        or not part:IsA(
            "BasePart"
        )
        or not part.Parent
    then
        return
    end

    if State.FreezeStates[
        part
    ] == nil
    then
        State.FreezeStates[
            part
        ] = part.Anchored
    end

    pcall(function()
        part.AssemblyLinearVelocity =
            Vector3.zero

        part.AssemblyAngularVelocity =
            Vector3.zero

        part.Anchored =
            true
    end)
end

local function freezeCharacter()
    local character =
        State.Character

    if not character then
        return
    end

    if not State.FreezeActive then
        State.FreezeStates = {}
        State.FreezeActive = true
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do
        if object:IsA(
            "BasePart"
        )
        then
            freezePart(
                object
            )
        end
    end

    zeroCharacterPhysics()
end

local function releaseCharacterFreeze()
    if not State.FreezeActive then
        return
    end

    zeroCharacterPhysics()

    fireStopVelocity()

    for part, originalAnchored in pairs(
        State.FreezeStates
    ) do
        if part
            and part.Parent
        then
            pcall(function()
                part.AssemblyLinearVelocity =
                    Vector3.zero

                part.AssemblyAngularVelocity =
                    Vector3.zero

                part.Anchored =
                    originalAnchored
            end)
        end
    end

    table.clear(
        State.FreezeStates
    )

    State.FreezeActive =
        false

    local root =
        State.Root

    if root
        and root.Parent
    then
        State.LastSafeVelocity =
            Vector3.zero
    end
end

local function restoreHumanoid()
    local humanoid =
        State.Humanoid

    if not humanoid
        or humanoid.Health <= 0
    then
        return
    end

    pcall(function()
        humanoid:SetStateEnabled(
            Enum.HumanoidStateType.Jumping,
            true
        )
    end)

    if humanoid.Sit
        and humanoid.SeatPart
            == nil
    then
        humanoid.Sit =
            false
    end

    if humanoid.PlatformStand then
        humanoid.PlatformStand =
            false
    end

    humanoid.AutoRotate =
        true

    local humanoidState =
        humanoid:GetState()

    if humanoidState
            == Enum.HumanoidStateType.Physics
        or humanoidState
            == Enum.HumanoidStateType.Ragdoll
        or humanoidState
            == Enum.HumanoidStateType.FallingDown
    then
        pcall(function()
            humanoid:
                ChangeState(
                    Enum.HumanoidStateType.GettingUp
                )
        end)
    end
end

local function getSafeAttackVelocity()
    local root =
        State.Root

    local humanoid =
        State.Humanoid

    if not root
        or not humanoid
    then
        return Vector3.zero
    end

    local current =
        root.AssemblyLinearVelocity

    local movement =
        humanoid.MoveDirection

    local walkSpeed =
        math.max(
            humanoid.WalkSpeed,
            0
        )

    local horizontal =
        Vector3.new(
            current.X,
            0,
            current.Z
        )

    if horizontal.Magnitude
        > Config.MaxHorizontal
    then
        if movement.Magnitude
            > 0.01
        then
            horizontal =
                movement.Unit
                * math.min(
                    walkSpeed
                        + Config.WalkExtra,
                    Config.MaxHorizontal
                )
        else
            horizontal =
                Vector3.zero
        end
    end

    local vertical =
        current.Y

    if vertical
        > Config.MaxVertical
    then
        vertical =
            math.clamp(
                State.LastSafeVelocity.Y,
                0,
                Config.SafeUpVelocity
            )

    elseif vertical
        < -Config.MaxVertical
    then
        vertical =
            math.clamp(
                State.LastSafeVelocity.Y,
                Config.SafeDownVelocity,
                0
            )
    end

    return Vector3.new(
        horizontal.X,
        vertical,
        horizontal.Z
    )
end

local function sanitizeGrabPhysics()
    if not grabActive()
        or ownershipActive()
    then
        return
    end

    local root =
        State.Root

    local humanoid =
        State.Humanoid

    if not root
        or not root.Parent
        or not humanoid
        or humanoid.Health <= 0
    then
        return
    end

    restoreHumanoid()

    local velocity =
        root.AssemblyLinearVelocity

    local angular =
        root.AssemblyAngularVelocity

    local horizontal =
        Vector3.new(
            velocity.X,
            0,
            velocity.Z
        )

    local delta =
        (
            velocity
            - State.LastSafeVelocity
        ).Magnitude

    local suspicious =
        horizontal.Magnitude
            > Config.MaxHorizontal
        or math.abs(
            velocity.Y
        ) > Config.MaxVertical
        or angular.Magnitude
            > Config.MaxAngular
        or delta
            > Config.MaxVelocityDelta

    if angular.Magnitude
        > Config.MaxAngular
    then
        root.AssemblyAngularVelocity =
            Vector3.zero
    end

    if suspicious then
        root.AssemblyLinearVelocity =
            getSafeAttackVelocity()
    end
end

local function ownershipPulse()
    if not Config.AntiOwnershipSpam then
        return
    end

    State.OwnershipLastSeen =
        os.clock()

    freezeCharacter()

    restoreHumanoid()

    fireStruggle()
    fireStopVelocity()
    fireRagdollReset()

    struggleBurst()

    task.defer(function()
        if not State.Running
            or not ownershipActive()
        then
            return
        end

        freezeCharacter()
        zeroCharacterPhysics()
    end)
end

local function grabPulse()
    if not Config.AntiGrab then
        return
    end

    activateGrab()

    restoreHumanoid()

    fireStruggle()
    fireStopVelocity()

    sanitizeGrabPhysics()

    struggleBurst()
end

local function registerHeadPartOwner(
    marker
)
    if not marker
        or marker.Name
            ~= "PartOwner"
        or marker.Parent
            ~= State.Head
    then
        return
    end

    State.HeadPartOwner =
        marker

    local old =
        State.OwnerConnections[
            marker
        ]

    if old then
        pcall(function()
            old:Disconnect()
        end)
    end

    local ok, connection =
        pcall(function()
            return marker:
                GetPropertyChangedSignal(
                    "Value"
                ):
                Connect(function()
                    if not State.Running
                        or not Config.AntiOwnershipSpam
                    then
                        return
                    end

                    if markerHostile(
                        marker
                    ) then
                        ownershipPulse()
                    end
                end)
        end)

    if ok
        and connection
    then
        State.OwnerConnections[
            marker
        ] = connection
    end

    if markerHostile(
        marker
    ) then
        ownershipPulse()
    end
end

local function unregisterHeadPartOwner(
    marker
)
    local connection =
        State.OwnerConnections[
            marker
        ]

    if connection then
        pcall(function()
            connection:
                Disconnect()
        end)

        State.OwnerConnections[
            marker
        ] = nil
    end

    if State.HeadPartOwner
        == marker
    then
        State.HeadPartOwner =
            nil
    end

    State.OwnershipLastSeen =
        os.clock()
end

local function scanHeadOwner()
    local marker =
        getHeadPartOwner()

    if marker
        and marker
            ~= State.HeadPartOwner
    then
        registerHeadPartOwner(
            marker
        )
    end

    return marker
end

local function disableInternalFlingHandler()
    if State.InternalFlingDisabled then
        return
    end

    if not State.IsHeld then
        return
    end

    if typeof(getconnections)
            ~= "function"
        or typeof(getfenv)
            ~= "function"
    then
        return
    end

    local targetScript =
        State.Character
        and State.Character:
            FindFirstChild(
                "HumanoidStateTypeByGettingFlung",
                true
            )

    local ok, connections =
        pcall(
            getconnections,
            State.IsHeld.Changed
        )

    if not ok
        or type(connections)
            ~= "table"
    then
        return
    end

    local disabled =
        false

    for _, connection in ipairs(
        connections
    ) do
        local fn

        pcall(function()
            fn =
                connection.Function
        end)

        if fn then
            local success,
                environment =
                pcall(
                    getfenv,
                    fn
                )

            if success
                and type(environment)
                    == "table"
            then
                local scriptObject =
                    environment.script

                if scriptObject
                    and (
                        scriptObject
                            == targetScript
                        or scriptObject.Name
                            == "HumanoidStateTypeByGettingFlung"
                    )
                then
                    local disabledOk =
                        pcall(function()
                            connection:
                                Disable()
                        end)

                    if disabledOk then
                        disabled =
                            true
                    end
                end
            end
        end
    end

    if disabled then
        State.InternalFlingDisabled =
            true
    end
end

local function setupCharacter(
    character
)
    clearCharacterConnections()

    releaseCharacterFreeze()

    State.Character =
        character

    State.Humanoid =
        character:
            WaitForChild(
                "Humanoid",
                10
            )

    if State.Humanoid then
        pcall(function()
            State.Humanoid:SetStateEnabled(
                Enum.HumanoidStateType.Jumping,
                true
            )
        end)
    end

    State.Root =
        character:
            WaitForChild(
                "HumanoidRootPart",
                10
            )

    State.Head =
        character:
            WaitForChild(
                "Head",
                10
            )

    State.IsHeld =
        findIsHeld()

    State.HeadPartOwner =
        nil

    State.GrabUntil =
        0

    State.OwnershipLastSeen =
        -math.huge

    State.LastStruggle =
        0

    State.LastRagdoll =
        0

    State.InternalFlingDisabled =
        false

    State.FreezeStates =
        {}

    State.FreezeActive =
        false

    if State.Root then
        State.LastSafeVelocity =
            State.Root.AssemblyLinearVelocity
    else
        State.LastSafeVelocity =
            Vector3.zero
    end

    scanHeadOwner()

    task.defer(
        disableInternalFlingHandler
    )

    task.delay(
        0.20,
        disableInternalFlingHandler
    )

    task.delay(
        0.75,
        disableInternalFlingHandler
    )

    if State.IsHeld
        and State.IsHeld:IsA(
            "BoolValue"
        )
    then
        connectCharacter(
            State.IsHeld:
                GetPropertyChangedSignal(
                    "Value"
                ),

            function()
                if not State.Running
                    or not Config.AntiGrab
                then
                    return
                end

                if State.IsHeld.Value then
                    grabPulse()
                else
                    activateGrab()
                end
            end
        )
    end

    if State.Humanoid then
        connectCharacter(
            State.Humanoid:
                GetPropertyChangedSignal(
                    "Sit"
                ),

            function()
                if not State.Running
                    or not Config.AntiGrab
                then
                    return
                end

                if State.Humanoid.Sit
                    and State.Humanoid.SeatPart
                        == nil
                then
                    grabPulse()

                    State.Humanoid.Sit =
                        false
                end
            end
        )

        connectCharacter(
            State.Humanoid.StateChanged,

            function(
                oldState,
                newState
            )
                if not State.Running then
                    return
                end

                if (
                    newState
                        == Enum.HumanoidStateType.Physics
                    or newState
                        == Enum.HumanoidStateType.Ragdoll
                    or newState
                        == Enum.HumanoidStateType.FallingDown
                )
                    and State.Humanoid.SeatPart
                        == nil
                    and defenseActive()
                then
                    restoreHumanoid()

                    if ownershipActive() then
                        freezeCharacter()
