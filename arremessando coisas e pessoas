--==============================================================
-- CHECK BLOB RANGE
--==============================================================

local function checkBlobRange(
    blob,
    targetRoot
)

    local distance =
        getBlobDistance(
            blob,
            targetRoot
        )


    if distance
        > Config.BlobGrabRange
    then

        Window:Notify({

            Title = "Blobman",

            Text =
                string.format(
                    "Fora do alcance: %.1f studs",
                    distance
                ),

            Duration = 2
        })


        return false
    end


    return true
end


--==============================================================
-- LOCK PLAYER
--==============================================================

local function lockBlobPlayer()

    local player,
        character,
        targetRoot =
        getSelectedBlobTarget()


    if not player then
        return
    end


    local blob =
        getMountedBlobman()


    if not blob then

        Window:Notify({

            Title = "Blobman",

            Text =
                "Sente no Blobman primeiro.",

            Duration = 2
        })


        return
    end


    if not checkBlobRange(
        blob,
        targetRoot
    ) then

        return
    end


    --==========================================================
    -- GRAB
    --==========================================================

    local success,
        side =
        grabBlobTarget(
            blob,
            targetRoot
        )


    if not success then

        Window:Notify({

            Title = "Blobman",

            Text =
                "Não consegui pegar o player.",

            Duration = 2
        })


        return
    end


    --==========================================================
    -- CONFIRMAÇÃO RÁPIDA
    --==========================================================

    local deadline =
        os.clock()
        + Config.BlobGrabConfirmTime


    while os.clock()
        < deadline
    do

        if playerIsHeld(player) then
            break
        end


        RunService.Heartbeat:Wait()
    end


    --==========================================================
    -- DELAY EM MILISSEGUNDOS
    --==========================================================

    task.wait(
        Config.BlobLockJumpDelay
    )


    --==========================================================
    -- PULA
    --==========================================================

    jumpOutOfBlob()


    Window:Notify({

        Title = "Blobman",

        Text =
            "Lock: "
            .. player.Name
            .. " | "
            .. tostring(side),

        Duration = 2
    })
end


--==============================================================
-- BRING PLAYER
--==============================================================

local function bringBlobPlayer()

    local player,
        character,
        targetRoot =
        getSelectedBlobTarget()


    if not player then
        return
    end


    local blob =
        getMountedBlobman()


    if not blob then

        Window:Notify({

            Title = "Blobman",

            Text =
                "Sente no Blobman primeiro.",

            Duration = 2
        })


        return
    end


    if not checkBlobRange(
        blob,
        targetRoot
    ) then

        return
    end


    task.spawn(function()

        local deadline =
            os.clock()
            + Config.BlobBringTimeout


        while State.Running
            and player.Parent == Players
            and targetRoot.Parent
            and os.clock() < deadline
        do

            local distance =
                getBlobDistance(
                    blob,
                    targetRoot
                )


            if distance
                <= Config.BlobBringDistance
            then

                break
            end


            grabBlobTarget(
                blob,
                targetRoot
            )


            task.wait(
                Config.BlobBringInterval
            )
        end


        Window:Notify({

            Title = "Blobman",

            Text =
                "Bring: "
                .. player.Name,

            Duration = 2
        })

    end)
end


--==============================================================
-- KICK PLAYER
--==============================================================

local function kickBlobPlayer()

    local player,
        character,
        targetRoot =
        getSelectedBlobTarget()


    if not player then
        return
    end


    local blob =
        getMountedBlobman()


    if not blob then

        Window:Notify({

            Title = "Blobman",

            Text =
                "Sente no Blobman primeiro.",

            Duration = 2
        })


        return
    end


    if not checkBlobRange(
        blob,
        targetRoot
    ) then

        return
    end


    task.spawn(function()

        --======================================================
        -- 1. BLOBMAN PEGA O PLAYER
        --======================================================

        local success =
            grabBlobTarget(
                blob,
                targetRoot
            )


        if not success then

            Window:Notify({

                Title = "Blobman",

                Text =
                    "Grab do kick falhou.",

                Duration = 2
            })


            return
        end


        --======================================================
        -- 2. ESPERA WELD / OWNERSHIP
        --======================================================

        task.wait(
            Config.BlobKickGrabDelay
        )


        if not targetRoot.Parent then
            return
        end


        -- tenta passar pelo mecanismo de ownership do jogo

        pcall(function()

            SetNetworkOwner:
                FireServer(
                    targetRoot,
                    targetRoot.CFrame
                )

        end)


        RunService.Heartbeat:Wait()


        --======================================================
        -- 3. DIREÇÃO
        --======================================================

        local myRoot =
            State.Root


        if not myRoot
            or not myRoot.Parent
        then

            return
        end


        local rawDirection =
            targetRoot.Position
            - myRoot.Position


        local direction


        if rawDirection.Magnitude
            > 0.01
        then

            direction =
                rawDirection.Unit

        else

            direction =
                myRoot.CFrame.LookVector
        end


        local wantedVelocity =

            direction
            * Config.BlobKickSpeed

            + Vector3.new(
                0,
                Config.BlobKickUpward,
                0
            )


        --======================================================
        -- 4. KICK
        --======================================================

        for _ = 1,
            Config.BlobKickFrames
        do

            if not State.Running
                or not targetRoot.Parent
            then

                break
            end


            local current =
                targetRoot:
                    GetVelocityAtPosition(
                        targetRoot.Position
                    )


            local delta =
                wantedVelocity
                - current


            pcall(function()

                targetRoot:
                    ApplyImpulse(
                        delta
                        * targetRoot.AssemblyMass
                    )

            end)


            pcall(function()

                targetRoot.AssemblyLinearVelocity =
                    wantedVelocity


                targetRoot.AssemblyAngularVelocity =
                    Vector3.new(
                        25,
                        35,
                        20
                    )

            end)


            RunService.Heartbeat:Wait()
        end


        Window:Notify({

            Title = "Blobman",

            Text =
                "Kick físico: "
                .. player.Name,

            Duration = 2
        })

    end)
end


