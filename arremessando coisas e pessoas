--==============================================================

task.spawn(function()

    while State.Running do

        task.wait(1)


        local list, map =
            buildPlayerList()


        local signature =
            table.concat(
                list,
                "\0"
            )


        if signature
            ~= State.BlobPlayerSignature
        then

            State.BlobPlayerSignature =
                signature


            local previous =
                State.BlobSelectedPlayer


            State.BlobPlayerMap =
                map


            BlobDropdown:
                Refresh(
                    list
                )


            local restored =
                false


            if previous
                and previous.Parent
                    == Players
            then

                for label, player
                    in pairs(map)
                do

                    if player
                        == previous
                    then

                        BlobDropdown:
                            SetValue(
                                label
                            )


                        State.BlobSelectedPlayer =
                            player


                        restored =
                            true

                        break
                    end
                end
            end


            if not restored then

                local first =
                    list[1]


                BlobDropdown:
                    SetValue(
                        first
                    )


                State.BlobSelectedPlayer =
                    map[first]
            end
        end
    end
end)


--==============================================================
-- NAMECALL HOOK
--==============================================================

local OldNamecall


OldNamecall =
    hookmetamethod(

        game,

        "__namecall",

        newcclosure(function(
            self,
            ...
        )

            local method =
                getnamecallmethod()


            if not State.Running
                or method ~= "FireServer"
                or checkcaller()
            then

                return OldNamecall(
                    self,
                    ...
                )
            end


            local args =
                table.pack(...)


            --==================================================
            -- ORIGINAL PRIMEIRO
            --==================================================

            local result =
                table.pack(
                    OldNamecall(
                        self,
                        ...
                    )
                )


            --==================================================
            -- CREATE GRAB
            --==================================================

            if self
                == CreateGrabLine
            then

                local object =
                    args[1]


                if valid(object) then

                    State.GrabbedObject =
                        object
                end


            --==================================================
            -- OWNER
            --==================================================

            elseif self
                == SetNetworkOwner
            then

                local object =
                    args[1]


                if valid(object) then

                    State.OwnerObject =
                        object

                    State.GrabbedObject =
                        object
                end


            --==================================================
            -- RELEASE
            --==================================================

            elseif self
                == DestroyGrabLine
            then

                local object =
                    args[1]

                    or State.OwnerObject

                    or State.GrabbedObject


                local button =
                    getReleaseButton()


                -- Mouse2 somente

                if button == 2
                    and valid(object)
                then

                    task.spawn(
                        throwObject,
                        object
                    )
                end


                State.GrabbedObject =
                    nil


                State.OwnerObject =
                    nil


                State.LastMouseButton =
                    0


                State.LastMouseTime =
                    0
            end


            return table.unpack(
                result,
                1,
                result.n
            )

        end)
    )


