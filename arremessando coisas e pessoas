local function nearestBlobSide(
    blob,
    targetRoot
)
    local left =
        getBlobDetector(
            blob,
            "Left"
        )

    local right =
        getBlobDetector(
            blob,
            "Right"
        )

    local targetPosition =
        targetRoot.Position

    local leftPosition =
        getObjectPosition(
            left
        )

    local rightPosition =
        getObjectPosition(
            right
        )

    local leftDistance =
        leftPosition
        and (
            leftPosition
            - targetPosition
        ).Magnitude
        or math.huge

    local rightDistance =
        rightPosition
        and (
            rightPosition
            - targetPosition
        ).Magnitude
        or math.huge

    if leftDistance
        <= rightDistance
    then

        return "Left",
            leftDistance
    end

    return "Right",
        rightDistance
end

local function grabBlobSide(
    blob,
    targetRoot,
    side
)
    local remote =
        getCreatureGrab(
            blob
        )

    local detector =
        getBlobDetector(
            blob,
            side
        )

    local weld =
        findGrabWeld(
            detector,
            side
        )

    if not remote
        or not detector
        or not weld
    then

        return false
    end

    return pcall(function()
        remote:FireServer(
            detector,
            targetRoot,
            weld
        )
    end)
end

local function grabBlobTarget(
    blob,
    targetRoot
)
    local nearest,
        distance =
        nearestBlobSide(
            blob,
            targetRoot
        )

    if distance
        > Config.BlobGrabRange
    then

        return false,
            nil,
            distance
    end

    local other =
        nearest == "Left"
        and "Right"
        or "Left"

    if grabBlobSide(
        blob,
        targetRoot,
        nearest
    ) then

        return true,
            nearest,
            distance
    end

    if grabBlobSide(
        blob,
        targetRoot,
        other
    ) then

        return true,
            other,
            distance
    end

    return false,
        nil,
        distance
end

local function targetHeld(player)
