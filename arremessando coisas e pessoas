connect(
    RunService.PreSimulation,

    function()
        if not State.Running then
            return
        end

        local root =
            State.Root

        if not root
            or not root.Parent
        then
            return
        end

        if not State.IsHeld
            or not State.IsHeld.Parent
        then

            State.IsHeld =
                findIsHeld()
        end

        if isHeld() then
            activateGrab()
        end

        if hasPartOwner() then
            activateOwnership()
        end

        if defenseActive() then
            sanitizeAttackPhysics(
                false
            )
        else
            State.LastSafeVelocity =
                root.AssemblyLinearVelocity
        end
    end
)

connect(
    RunService.Heartbeat,

    function()
        if not State.Running then
            return
        end

        local root =
            State.Root

        if not root
            or not root.Parent
        then
            return
        end

        local held =
            isHeld()

        local owned =
            hasPartOwner()

        if held then
            activateGrab()
        end

        if owned then
            activateOwnership()
        end

        if defenseActive() then
            local now =
                os.clock()

            if now
                - State.LastStruggle
                >= Config.StruggleInterval
            then

                State.LastStruggle =
                    now

                fireStruggle()
            end

            if ownershipActive()
                or held
            then

                fireStopVelocity()
            end

            if ownershipActive() then
                fireRagdollReset()
            end

            sanitizeAttackPhysics(
                false
            )
        else
            State.LastSafeVelocity =
                root.AssemblyLinearVelocity
        end
    end
)

connect(
    RunService.PostSimulation,

    function()
        if not State.Running then
            return
        end

        local root =
            State.Root

        if not root
            or not root.Parent
        then
            return
        end

        if defenseActive() then
            sanitizeAttackPhysics(
                false
            )
        else
            State.LastSafeVelocity =
                root.AssemblyLinearVelocity
        end
    end
)

connect(
