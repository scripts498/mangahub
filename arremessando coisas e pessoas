--==============================================================
-- DISTANCE
--==============================================================

local function getBlobDistance(
    blob,
    targetRoot
)

    local blobRoot =
        getBlobRoot(blob)


    if not blobRoot
        or not targetRoot
    then

        return math.huge
    end


    return (
        blobRoot.Position
        - targetRoot.Position
    ).Magnitude
end


--==============================================================
-- GRAB SIDE
--==============================================================

local function grabBlobSide(
    blob,
    targetRoot,
    side
)

    local remote =
        getCreatureGrab(blob)


    if not remote then

        log(
            "CreatureGrab não encontrado"
        )

        return false
    end


    local detector =
        getBlobDetector(
            blob,
            side
        )


    if not detector then

        log(
            side,
            "Detector não encontrado"
        )

        return false
    end


    local weld =
        findGrabWeld(
            detector,
            side
        )


    if not weld then

        log(
            side,
            "Weld não encontrado"
        )

        return false
    end


    local ok =
        pcall(function()

            remote:FireServer(
                detector,
                targetRoot,
                weld
            )

        end)


    return ok
end


--==============================================================
-- GRAB BEST SIDE
--==============================================================

local function grabBlobTarget(
    blob,
    targetRoot
)

    local first =
        State.BlobLastSide


    local second =
        first == "Left"
        and "Right"
        or "Left"


    State.BlobLastSide =
        second


    if grabBlobSide(
        blob,
        targetRoot,
        first
    ) then

        return true,
            first
    end


    if grabBlobSide(
        blob,
        targetRoot,
        second
    ) then

        return true,
            second
    end


    return false,
        nil
end


