local OldNamecall

OldNamecall =
    hookmetamethod(
        game,

        "__namecall",

        newcclosure(function(
            self,
            ...
        )
            local method =
                getnamecallmethod()

            local caller =
                false

            if typeof(checkcaller)
                == "function"
            then
                caller =
                    checkcaller()
            end

            if not State.Running
                or method
                    ~= "FireServer"
                or caller
            then

                return OldNamecall(
                    self,
                    ...
                )
            end

            local args =
                table.pack(
                    ...
                )

            local result =
                table.pack(
                    OldNamecall(
                        self,
                        ...
                    )
                )

            if self
                == CreateGrabLine
            then

                local object =
                    args[1]

                if valid(
                    object
                ) then

                    State.GrabbedObject =
                        object
                end

            elseif self
                == SetNetworkOwner
            then

                local object =
                    args[1]

                if valid(
                    object
                ) then

                    State.OwnerObject =
                        object

                    State.GrabbedObject =
                        object
                end

            elseif self
                == DestroyGrabLine
            then

                local object =
                    args[1]
                    or State.OwnerObject
                    or State.GrabbedObject

                local button =
                    getReleaseButton()

                if button == 2
                    and valid(
                        object
                    )
                then

                    task.spawn(
                        throwObject,
                        object
                    )
                end

                State.GrabbedObject =
                    nil

                State.OwnerObject =
                    nil

                State.LastMouseButton =
                    0

                State.LastMouseTime =
                    0
            end

            return table.unpack(
                result,
                1,
                result.n
            )
        end)
    )

