local function valid(object)
    return typeof(object) == "Instance"
        and object.Parent ~= nil
end

local function getAssemblyRoot(object)
    if not valid(object) then
        return nil
    end

    if object:IsA("BasePart") then
        return object.AssemblyRootPart
            or object
    end

    if object:IsA("Model") then
        local part =
            object.PrimaryPart
            or object:
                FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

        if part then
            return part.AssemblyRootPart
                or part
        end
    end

    if object:IsA("Attachment") then
        local parent =
            object.Parent

        if parent
            and parent:IsA(
                "BasePart"
            )
        then
            return parent.AssemblyRootPart
                or parent
        end
    end

    return nil
end

local function safeLineCollect(
    output,
    seen,
    source
)
    if type(source) ~= "table" then
        return
    end

    for _, value in pairs(source) do
        if type(value) == "function"
            and not seen[value]
        then
            seen[value] = true
            table.insert(
                output,
                value
            )
        end
    end
end

local function lineFunctions()
    local functions = {}
    local seen = {}

    if typeof(getgc)
        == "function"
    then
        local okAll, all =
            pcall(
                getgc,
                true
            )

        if okAll then
            safeLineCollect(
                functions,
                seen,
                all
            )
        end

        local okFunctions, onlyFunctions =
            pcall(
                getgc
            )

        if okFunctions then
            safeLineCollect(
                functions,
                seen,
                onlyFunctions
            )
        end
    end

    if typeof(getreg)
        == "function"
    then
        local ok, registry =
            pcall(
                getreg
            )

        if ok then
            safeLineCollect(
                functions,
                seen,
                registry
            )
        end
    end

    if type(debug)
            == "table"
        and typeof(debug.getregistry)
            == "function"
    then
        local ok, registry =
            pcall(
                debug.getregistry
            )

        if ok then
            safeLineCollect(
                functions,
                seen,
                registry
            )
        end
    end

    return functions
end

