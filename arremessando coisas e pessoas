local function refreshCorrectionRemotes()
    if not GameCorrectionEvents
        or not GameCorrectionEvents.Parent
    then

        GameCorrectionEvents =
            ReplicatedStorage:
                FindFirstChild(
                    "GameCorrectionEvents"
                )
    end

    if GameCorrectionEvents then
        if not StopAllVelocity
            or not StopAllVelocity.Parent
        then

            StopAllVelocity =
                GameCorrectionEvents:
                    FindFirstChild(
                        "StopAllVelocity"
                    )
        end
    end

    if not RagdollRemote
        or not RagdollRemote.Parent
    then

        RagdollRemote =
            CharacterEvents:
                FindFirstChild(
                    "RagdollRemote"
                )
    end
end

local function findIsHeld()
    local held =
        LocalPlayer:
            FindFirstChild(
                "IsHeld",
                true
            )

    if held then
        return held
    end

    local character =
        LocalPlayer.Character

    if character then
        return character:
            FindFirstChild(
                "IsHeld",
                true
            )
    end

    return nil
end

local function activateGrab(duration)
    State.GrabUntil =
        math.max(
            State.GrabUntil,
            os.clock()
                + (
                    duration
                    or Config.GrabTail
                )
        )
end

local function activateOwnership(duration)
    State.OwnershipUntil =
        math.max(
            State.OwnershipUntil,
            os.clock()
                + (
                    duration
                    or Config.OwnershipTail
                )
        )
end

local function grabActive()
    return Config.AntiGrab
        and os.clock()
            < State.GrabUntil
end

local function ownershipActive()
    return Config.AntiOwnershipSpam
        and os.clock()
            < State.OwnershipUntil
end

local function defenseActive()
    return grabActive()
        or ownershipActive()
end

local function isHeld()
    local held =
        State.IsHeld

    return Config.AntiGrab
        and held
        and held.Parent
        and held:IsA(
            "BoolValue"
        )
        and held.Value == true
end

local function hasPartOwner()
    if not Config.AntiOwnershipSpam then
        return false
    end

    for marker in pairs(
        State.OwnerMarkers
    ) do

        if marker
            and marker.Parent
        then
            return true
        end
    end

    return false
end

local function fireStruggle()
    if not State.Running then
        return
    end

    if not Config.AntiGrab
        and not Config.AntiOwnershipSpam
    then
        return
    end

    pcall(function()
        StruggleRemote:
            FireServer(
                LocalPlayer
            )
    end)
end

local function fireStopVelocity()
    if not Config.AntiOwnershipSpam
        and not Config.AntiGrab
    then
        return
    end

    refreshCorrectionRemotes()

    if not StopAllVelocity then
        return
    end

    pcall(function()
        StopAllVelocity:
            FireServer()
    end)
end

local function fireRagdollReset()
    if not ownershipActive() then
        return
    end

    refreshCorrectionRemotes()

    if not RagdollRemote then
        return
    end

    local root =
        State.Root

    if not root
        or not root.Parent
    then
        return
    end

    local now =
        os.clock()

    if now
        - State.LastRagdoll
        < Config.RagdollResetInterval
    then
        return
    end

    State.LastRagdoll =
        now

    pcall(function()
        RagdollRemote:
            FireServer(
                root,
                0
            )
    end)
end

local function struggleBurst()
    if State.BurstRunning then
        return
    end

    State.BurstRunning =
        true

    task.spawn(function()
        for _ = 1,
            Config.StruggleBurstCount
        do

            if not State.Running then
                break
            end

            if not Config.AntiGrab
                and not Config.AntiOwnershipSpam
            then
                break
            end

            fireStruggle()

            task.wait(
                Config.StruggleBurstDelay
            )
        end

        State.BurstRunning =
            false
    end)
end

local function restoreHumanoid()
    local humanoid =
        State.Humanoid

    if not humanoid
        or humanoid.Health <= 0
    then
        return
    end

    if humanoid.Sit
        and humanoid.SeatPart
            == nil
    then

        humanoid.Sit =
            false
    end

    if humanoid.PlatformStand then
        humanoid.PlatformStand =
            false
    end

    humanoid.AutoRotate =
        true

    local humanoidState =
        humanoid:GetState()

    if humanoidState
            == Enum.HumanoidStateType.Physics
        or humanoidState
            == Enum.HumanoidStateType.Ragdoll
        or humanoidState
            == Enum.HumanoidStateType.FallingDown
    then

        pcall(function()
            humanoid:
                ChangeState(
                    Enum.HumanoidStateType.GettingUp
                )
        end)
    end

    if os.clock()
        < State.JumpUntil
        and humanoid.SeatPart
            == nil
    then

        humanoid.Jump =
            true
    end
end

local function getSafeAttackVelocity()
    local root =
        State.Root

    local humanoid =
        State.Humanoid

    if not root
        or not humanoid
    then
        return Vector3.zero
    end

    local current =
        root.AssemblyLinearVelocity

    local movement =
        humanoid.MoveDirection

    local walkSpeed =
        math.max(
            humanoid.WalkSpeed,
            0
        )

    local horizontal =
        Vector3.new(
            current.X,
            0,
            current.Z
        )

    if horizontal.Magnitude
        > Config.MaxHorizontal
    then

        if movement.Magnitude
            > 0.01
        then

            horizontal =
                movement.Unit
                * math.min(
                    walkSpeed
                        + Config.WalkExtra,
                    Config.MaxHorizontal
                )
        else

            horizontal =
                Vector3.zero
        end
    end

    local vertical =
        current.Y

    if vertical
        > Config.MaxVertical
    then

        vertical =
            math.clamp(
                State.LastSafeVelocity.Y,
                0,
                Config.SafeUpVelocity
            )

    elseif vertical
        < -Config.MaxVertical
    then

        vertical =
            math.clamp(
                State.LastSafeVelocity.Y,
                Config.SafeDownVelocity,
                0
            )
    end

    return Vector3.new(
        horizontal.X,
        vertical,
        horizontal.Z
    )
end

local function sanitizeAttackPhysics(force)
    if not force
        and not defenseActive()
    then
        return
    end

    local root =
        State.Root

    local humanoid =
        State.Humanoid

    if not root
        or not root.Parent
        or not humanoid
        or humanoid.Health <= 0
    then
        return
    end

    restoreHumanoid()

    local velocity =
        root.AssemblyLinearVelocity

    local angular =
        root.AssemblyAngularVelocity

    local horizontal =
        Vector3.new(
            velocity.X,
            0,
            velocity.Z
        )

    local delta =
        (
            velocity
            - State.LastSafeVelocity
        ).Magnitude

    local badHorizontal =
        horizontal.Magnitude
            > Config.MaxHorizontal

    local badVertical =
        math.abs(
            velocity.Y
        ) > Config.MaxVertical

    local badAngular =
        angular.Magnitude
            > Config.MaxAngular

    local badDelta =
        delta
            > Config.MaxVelocityDelta

    if force
        or badAngular
    then

        root.AssemblyAngularVelocity =
            Vector3.zero
    end

    if force
        or badHorizontal
        or badVertical
        or badDelta
    then

        root.AssemblyLinearVelocity =
            getSafeAttackVelocity()
    end
end

local function ownershipPulse()
    if not Config.AntiOwnershipSpam then
        return
    end

    activateOwnership()

    sanitizeAttackPhysics(
        true
    )

    fireStruggle()

    fireStopVelocity()

    fireRagdollReset()

    struggleBurst()

    task.defer(function()
        if not State.Running then
            return
        end

        sanitizeAttackPhysics(
            true
        )
    end)

    task.spawn(function()
        for _ = 1, 4 do
            RunService.Heartbeat:
                Wait()

            if not State.Running
                or not Config.AntiOwnershipSpam
            then
                break
            end

            activateOwnership()

            fireStruggle()

            fireStopVelocity()

            fireRagdollReset()

            sanitizeAttackPhysics(
                true
            )
        end
    end)
end

local function grabPulse()
    if not Config.AntiGrab then
        return
    end

    activateGrab()

    sanitizeAttackPhysics(
        true
    )

    fireStruggle()

    fireStopVelocity()

    struggleBurst()

    task.defer(function()
        if not State.Running then
            return
        end

        sanitizeAttackPhysics(
            true
        )
    end)
end

local function unregisterPartOwner(marker)
    local connection =
        State.OwnerConnections[
            marker
        ]

    if connection then
        pcall(function()
            connection:
                Disconnect()
        end)

        State.OwnerConnections[
            marker
        ] = nil
    end

    State.OwnerMarkers[
        marker
    ] = nil

    if Config.AntiOwnershipSpam then
        activateOwnership(
            Config.OwnershipTail
        )
    end
end

local function registerPartOwner(marker)
    if not marker
        or marker.Name
            ~= "PartOwner"
        or not marker.Parent
    then
        return
    end

    if State.OwnerMarkers[
        marker
    ] then
        return
    end

    State.OwnerMarkers[
        marker
    ] = true

    local ok, connection =
        pcall(function()

            return marker:
                GetPropertyChangedSignal(
                    "Value"
                ):
                Connect(function()

                    if not State.Running
                        or not Config.AntiOwnershipSpam
                    then
                        return
                    end

                    ownershipPulse()
                end)
        end)

    if ok
        and connection
    then

        State.OwnerConnections[
            marker
        ] = connection
    end

    if Config.AntiOwnershipSpam then
        ownershipPulse()
    end
end

local function scanPartOwners()
    local character =
        State.Character

    if not character then
        return
    end

    for _, object in ipairs(
        character:GetDescendants()
    ) do

        if object.Name
            == "PartOwner"
        then

            registerPartOwner(
                object
            )
        end
    end
end

local function disableInternalFlingHandler()
    if State.InternalFlingDisabled then
        return
    end

    if not State.IsHeld then
        return
    end

    if typeof(getconnections)
            ~= "function"
        or typeof(getfenv)
            ~= "function"
    then
        return
    end

    local targetScript =
        State.Character
        and State.Character:
            FindFirstChild(
                "HumanoidStateTypeByGettingFlung",
                true
            )

    local ok, connections =
        pcall(
            getconnections,
            State.IsHeld.Changed
        )

    if not ok
        or type(connections)
            ~= "table"
    then
        return
    end

    local disabled =
        false

    for _, connection in ipairs(
        connections
    ) do

        local fn

        pcall(function()
            fn =
                connection.Function
        end)

        if fn then
            local success,
                environment =
                pcall(
                    getfenv,
                    fn
                )

            if success
                and type(environment)
                    == "table"
            then

                local scriptObject =
                    environment.script

                if scriptObject
                    and (
                        scriptObject
                            == targetScript
                        or scriptObject.Name
                            == "HumanoidStateTypeByGettingFlung"
                    )
                then

                    local disabledOk =
                        pcall(function()
                            connection:
                                Disable()
                        end)

                    if disabledOk then
                        disabled =
                            true
                    end
                end
            end
        end
    end

    if disabled then
        State.InternalFlingDisabled =
            true
    end
end

local function setupCharacter(character)
    clearCharacterConnections()

    State.Character =
        character

    State.Humanoid =
        character:
            WaitForChild(
                "Humanoid",
                10
            )

    State.Root =
        character:
            WaitForChild(
                "HumanoidRootPart",
                10
            )

    State.IsHeld =
        findIsHeld()

    State.GrabUntil =
        0

    State.OwnershipUntil =
        0

    State.LastStruggle =
        0

    State.LastRagdoll =
        0

    State.InternalFlingDisabled =
        false

    if State.Root then
        State.LastSafeVelocity =
            State.Root.AssemblyLinearVelocity
    else
        State.LastSafeVelocity =
            Vector3.zero
    end

    scanPartOwners()

    task.defer(
        disableInternalFlingHandler
    )

    task.delay(
        0.20,
        disableInternalFlingHandler
    )

    task.delay(
        0.75,
        disableInternalFlingHandler
    )

    if State.IsHeld
        and State.IsHeld:IsA(
            "BoolValue"
        )
    then

        connectCharacter(
            State.IsHeld:
                GetPropertyChangedSignal(
                    "Value"
                ),

            function()
                if not State.Running
                    or not Config.AntiGrab
                then
                    return
                end

                if State.IsHeld.Value then
                    grabPulse()
                else
                    activateGrab(
                        Config.GrabTail
                    )
                end
            end
        )
    end

    if State.Humanoid then
        connectCharacter(
            State.Humanoid:
                GetPropertyChangedSignal(
                    "Sit"
                ),

            function()
                if not State.Running
                    or not Config.AntiGrab
                then
                    return
                end

                if State.Humanoid.Sit
                    and State.Humanoid.SeatPart
                        == nil
                then

                    grabPulse()

                    State.Humanoid.Sit =
                        false
                end
            end
        )

        connectCharacter(
            State.Humanoid.StateChanged,

            function(
                oldState,
                newState
            )
                if not State.Running then
                    return
                end

                if (
                    newState
                        == Enum.HumanoidStateType.Physics
                    or newState
                        == Enum.HumanoidStateType.Ragdoll
                    or newState
                        == Enum.HumanoidStateType.FallingDown
                )
                    and State.Humanoid.SeatPart
                        == nil
                    and defenseActive()
                then

                    sanitizeAttackPhysics(
                        true
                    )

                    fireRagdollReset()
                end
            end
        )
    end

    connectCharacter(
        character.DescendantAdded,

        function(object)
            if not State.Running then
                return
            end

            if object.Name
                == "PartOwner"
            then

                registerPartOwner(
                    object
                )
            end
        end
    )

    connectCharacter(
        character.DescendantRemoving,

        function(object)
            if object.Name
                == "PartOwner"
            then

                unregisterPartOwner(
                    object
                )
            end
        end
    )
end

