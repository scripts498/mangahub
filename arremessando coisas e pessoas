--==============================================================
-- PROTECTION
--==============================================================

local function protectionActive()

    local held =
        State.IsHeld


    local isHeld =
        held
        and held.Parent
        and held:IsA("BoolValue")
        and held.Value


    local partOwner =
        State.Character
        and State.Character:FindFirstChild(
            "PartOwner",
            true
        )


    if Config.AntiGrab
        and isHeld
    then

        State.ProtectionUntil =
            os.clock()
            + Config.ProtectionGrace
    end


    if Config.AntiOwnershipSpam
        and partOwner
    then

        State.ProtectionUntil =
            os.clock()
            + Config.ProtectionGrace
    end


    return
        (
            Config.AntiGrab
            and isHeld
        )
        or
        (
            Config.AntiOwnershipSpam
            and partOwner ~= nil
        )
        or
        (
            (
                Config.AntiGrab
                or Config.AntiOwnershipSpam
            )
            and os.clock()
                < State.ProtectionUntil
        )
end


local function restoreMovement()

    local humanoid =
        State.Humanoid

    local root =
        State.Root


    if not humanoid
        or not root
        or not root.Parent
        or humanoid.Health <= 0
    then

        return
    end


    humanoid.PlatformStand = false

    humanoid.Sit = false

    humanoid.AutoRotate = true


    local velocity =
        root.AssemblyLinearVelocity

    local horizontal =
        Vector3.new(
            velocity.X,
            0,
            velocity.Z
        )

    local angular =
        root.AssemblyAngularVelocity


    local suspicious =
        horizontal.Magnitude
            > Config.MaxHorizontalSpeed

        or math.abs(velocity.Y)
            > Config.MaxVerticalSpeed

        or angular.Magnitude
            > Config.MaxAngularSpeed


    if suspicious then

        local movement =
            humanoid.MoveDirection

        local speed =
            humanoid.WalkSpeed


        root.AssemblyLinearVelocity =
            Vector3.new(

                movement.X * speed,

                math.clamp(
                    velocity.Y,
                    -60,
                    60
                ),

                movement.Z * speed
            )


        root.AssemblyAngularVelocity =
            Vector3.zero
    end
end


connect(
    RunService.Heartbeat,

    function()

        if not State.Running then
            return
        end


        if not State.IsHeld
            or not State.IsHeld.Parent
        then

            State.IsHeld =
                findIsHeld()
        end


        if protectionActive() then

            restoreMovement()


            local now =
                os.clock()


            if now
                - State.LastStruggle
                >= Config.StruggleInterval
            then

                State.LastStruggle = now

                fireStruggle()
            end
        end

    end
)


connect(
    RunService.PreSimulation,

    function()

        if not State.Running then
            return
        end


        if protectionActive() then
            restoreMovement()
        end

    end
)


--==============================================================
-- MOUSE INPUT
--==============================================================

local function mouseDetector(
    actionName,
    inputState,
    inputObject
)

    if inputState
        ~= Enum.UserInputState.Begin
    then

        return Enum.ContextActionResult.Pass
    end


    if inputObject.UserInputType
        == Enum.UserInputType.MouseButton1
    then

        State.LastMouseButton = 1

        State.LastMouseTime =
            os.clock()


    elseif inputObject.UserInputType
        == Enum.UserInputType.MouseButton2
    then

        State.LastMouseButton = 2

        State.LastMouseTime =
            os.clock()
    end


    return Enum.ContextActionResult.Pass
end


ContextActionService:
    BindActionAtPriority(

        "MangaHub_MouseDetector",

        mouseDetector,

        false,

        Enum.ContextActionPriority.High.Value + 1000,

        Enum.UserInputType.MouseButton1,

        Enum.UserInputType.MouseButton2
    )


local function getReleaseButton()

    if UserInputService:
        IsMouseButtonPressed(
            Enum.UserInputType.MouseButton2
        )
    then

        return 2
    end


    if UserInputService:
        IsMouseButtonPressed(
            Enum.UserInputType.MouseButton1
        )
    then

        return 1
    end


    if os.clock()
        - State.LastMouseTime
        <= Config.MouseMemory
    then

        return State.LastMouseButton
    end


    return 0
end


--==============================================================
-- THROW
--==============================================================

local function throwObject(object)

    if State.Throwing
        or not State.Running
        or not Config.ThrowEnabled
    then

        return
    end


    local root =
        getAssemblyRoot(object)

        or getAssemblyRoot(
            State.OwnerObject
        )

        or getAssemblyRoot(
            State.GrabbedObject
        )


    if not root
        or root.Anchored
    then

        return
    end


    local camera =
        Workspace.CurrentCamera

    if not camera then
        return
    end


    State.Throwing = true


    local speed =
        math.clamp(
            Config.ThrowForce,
            Config.ThrowMin,
            Config.ThrowMax
        )


    local desired =
        camera.CFrame.LookVector
        * speed


    RunService.Heartbeat:Wait()


    if not root.Parent then

        State.Throwing = false

        return
    end


    local delta =
        desired
        - root.AssemblyLinearVelocity


    pcall(function()

        root:ApplyImpulse(
            delta * root.AssemblyMass
        )

    end)


    root.AssemblyLinearVelocity =
        desired


    for _ = 1, Config.ThrowFrames do

        RunService.Heartbeat:Wait()


        if not root.Parent then
            break
        end


        local velocity =
            root.AssemblyLinearVelocity


        if velocity.Magnitude
            < speed * 0.75
        then

            local correction =
                (
                    desired
                    - velocity
                )
                * root.AssemblyMass


            pcall(function()

                root:ApplyImpulse(
                    correction
                )

            end)


            root.AssemblyLinearVelocity =
                desired
        end
    end


    State.Throwing = false
end


--==============================================================
-- BLOBMAN PLAYER LIST
--==============================================================

local function buildPlayerList()

    local list = {}

    local map = {}


    local playerList =
        Players:GetPlayers()


    table.sort(
        playerList,

        function(a, b)

            return string.lower(a.Name)
                < string.lower(b.Name)

        end
    )


    for _, player in ipairs(playerList) do

        if player ~= LocalPlayer then

            local label =
                string.format(
                    "%s (@%s)",
                    player.DisplayName,
                    player.Name
                )


            map[label] =
                player


            table.insert(
                list,
                label
            )
        end
    end


    if #list == 0 then

        list[1] =
            "Nenhum jogador"
    end


    return list, map
end


--==============================================================
-- FIND MOUNTED BLOBMAN
--==============================================================

local function getMountedBlobman()

    local character =
        LocalPlayer.Character


    local humanoid =
        character
        and character:
            FindFirstChildOfClass(
                "Humanoid"
            )


    if not humanoid then
        return nil
    end


    local seat =
        humanoid.SeatPart


    if seat then

        local current =
            seat


        while current
            and current ~= Workspace
        do

            if current:IsA("Model")
                and current.Name
                    == "CreatureBlobman"
            then

                return current
            end


            current =
                current.Parent
        end
    end


    for _, object in ipairs(
        Workspace:GetDescendants()
    ) do

        if object:IsA("Model")
            and object.Name
                == "CreatureBlobman"
        then

            local blobSeat =
                object:
                    FindFirstChildWhichIsA(
                        "VehicleSeat",
                        true
                    )


            if blobSeat
                and blobSeat.Occupant
                    == humanoid
            then

                return object
            end
        end
    end


    return nil
end


