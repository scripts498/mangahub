task.spawn(function()
    while State.Running do
        if Config.LineEnabled then
            local currentScript =
                lineCurrentGrabScript()

            if currentScript
                and currentScript
                    ~= State.LineBoundScript
            then
                restoreLineReach()
                clearLineBinding()
                State.LineNextRescan = 0
            end

            local now =
                os.clock()

            if now
                >= State.LineNextRescan
            then
                State.LineNextRescan =
                    now + 0.75

                refreshLineTargets()
            end

            local ok =
                applyLineReach()

            if not ok
                and not State.LineFailureNotified
            then
                State.LineFailureNotified =
                    true

                Window:Notify({
                    Title = "Line",
                    Text = "Não consegui aplicar os limites internos da Grab Line.",
                    Duration = 4
                })
            end
        end

        task.wait(0.20)
    end

    restoreLineReach()

    if ENV.MangaLineController
        == LineController
    then
        ENV.MangaLineController = nil
    end
end)

