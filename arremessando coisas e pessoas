    opRequestOwnership(targetRoot)

    task.spawn(function()
        RunService.Heartbeat:Wait()

        if not State.Running
            or not Config.OpFlingAura
            or not targetRoot.Parent
        then
            return
        end

        opRequestOwnership(targetRoot)
        opApplyFling(targetRoot)
    end)
end

