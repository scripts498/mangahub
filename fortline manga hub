local function createController(deps)
    local self = {
        Mode = "Off", Selected = nil, Whitelist = {}, Delay = 0.1,
        Pending = nil, Cursor = 0, NextSend = 0, NextEquip = 0,
        ReadyAt = 0, ReadyTool = nil, ReadyCharacter = nil, ReleaseAt = nil,
        Sent = 0, Errors = 0, ConsecutiveErrors = 0,
        LastTarget = "Nenhum", LastError = "", Status = "Desligado", Dead = false,
    }

    function self:Release()
        deps.release()
        self.ReadyTool = nil
        self.ReadyCharacter = nil
        self.ReadyAt = 0
        self.NextEquip = 0
        self.ReleaseAt = nil
    end

    function self:CancelPending()
        self.Pending = nil
        if self.Mode == "Off" then self:Release() end
    end

    function self:SetMode(mode)
        if self.Dead then return false end
        if mode ~= "Off" and mode ~= "All" and mode ~= "Selected" then return false end
        self.Mode = mode
        self.Pending = nil
        self.Cursor = 0
        self.ConsecutiveErrors = 0
        self.ReleaseAt = nil
        if mode == "Off" then
            self:Release()
            self.Status = "Desligado"
        else
            self.Status = "Aguardando"
        end
        return true
    end

    function self:Once(now)
        if self.Dead then return false, "Sistema encerrado." end
        if not self.Selected then return false, "Selecione um jogador." end
        if self.Pending then return false, "Já existe um ataque único aguardando." end
        self.Pending = {Name = self.Selected, Expires = now + 5}
        return true
    end

    function self:Fail(message, now)
        self.Errors = self.Errors + 1
        self.ConsecutiveErrors = self.ConsecutiveErrors + 1
        self.LastError = tostring(message)
        self.Status = "Falha local; aguardando nova tentativa"
        self.NextSend = now + math.min(2, 0.25 * 2 ^ (self.ConsecutiveErrors - 1))
        if self.ConsecutiveErrors >= 5 then
            self.Mode = "Off"
            self.Pending = nil
            self:Release()
            self.Status = "Parado após 5 falhas locais consecutivas"
        end
    end

    function self:Step(now)
        if self.Dead then return end
        if self.Pending and now >= self.Pending.Expires then
            self.Pending = nil
            self.Status = "Ataque único expirou"
            if self.Mode == "Off" then self:Release(); return end
        end
        if self.Mode == "Off" and not self.Pending then
            if self.ReleaseAt and now >= self.ReleaseAt then self:Release() end
            return
        end
        if now < self.NextSend then return end

        local context = deps.context()
        if not context then
            if self.ReadyCharacter then self:Release() end
            self.Status = "Aguardando seu personagem"
            self.NextSend = now + 0.1
            return
        end
        local remote = deps.remote()
        if not remote then self.Status = "Aguardando WeaponHit"; self.NextSend = now + 0.1; return end

        local targets = deps.targets(context)
        local target
        local chosenName = self.Pending and self.Pending.Name or (self.Mode == "Selected" and self.Selected)
        if self.Pending or self.Mode == "Selected" then
            if not chosenName then self.Status = "Selecione um jogador"; self.NextSend = now + 0.1; return end
            for _, candidate in ipairs(targets) do
                if candidate.Name == chosenName then target = candidate; break end
            end
        else
            local first
            for _, candidate in ipairs(targets) do
                if self.Whitelist[candidate.Name] ~= true then
                    first = first or candidate
                    if candidate.Id > self.Cursor then target = candidate; break end
                end
            end
            target = target or first
        end
        if not target then self.Status = "Aguardando alvo válido"; self.NextSend = now + 0.1; return end

        local tool = deps.tool(context)
        if not tool then
            if self.ReadyTool then self:Release() end
            self.Status = "Aguardando Sniper"
            self.NextSend = now + 0.1
            return
        end
        if self.ReadyCharacter ~= context.Character or self.ReadyTool ~= tool then
            if self.ReadyCharacter then self:Release() end
            self.ReadyCharacter = context.Character
            self.ReadyTool = tool
            self.ReadyAt = now
        end
        if not deps.equipped(tool, context) then
            self.Status = "Equipando Sniper"
            if now >= self.NextEquip then
                self.NextEquip = now + 0.5
                local ok, err = deps.equip(tool, context)
                self.ReadyAt = now + 0.1
                if not ok then self:Fail(err, now) end
            end
            return
        end
        if now < self.ReadyAt then self.Status = "Preparando Sniper"; return end

        local delay = tonumber(self.Delay) or 0.1
        if delay ~= delay then delay = 0.1 end
        delay = math.max(0.05, math.min(2, delay))
        self.NextSend = now + delay
        local wasOnce = self.Pending ~= nil
        if wasOnce then self.Pending = nil end
        local ok, err = deps.send(tool, target, remote)
        if ok then
            self.Sent = self.Sent + 1
            self.ConsecutiveErrors = 0
            self.LastTarget = target.Name
            self.Status = wasOnce and "Ataque único enviado" or "Ativo"
            if not wasOnce and self.Mode == "All" then self.Cursor = target.Id end
        else
            self:Fail(err, now)
        end
        if wasOnce and self.Mode == "Off" then self.ReleaseAt = now + 0.15 end
    end

    function self:Destroy()
        if self.Dead then return end
        self.Dead = true
        self.Mode = "Off"
        self.Pending = nil
        self:Release()
    end

    return self
end

local Environment = type(getgenv) == "function" and getgenv() or _G
local SESSION_KEY = "MangaHub_Fortline_Controller_V2"
local previous = Environment[SESSION_KEY]
if type(previous) == "table" and type(previous.Destroy) == "function" then
    pcall(function() previous:Destroy() end)
end
